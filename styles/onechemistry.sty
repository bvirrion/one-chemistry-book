% The periodic table: \omperiodictable[<keys>], a tikzpicture of 118 cells
% (atomic number and symbol; the f-block in two rows below, pointed to from
% group 3). Keys:
%   cell=0.82cm             side of a cell (default fits \linewidth)
%   colour=none|metals|blocks|families
%                           metals: metal / metalloid (B, Si, Ge, As, Sb, Te)
%                           / non-metal; blocks: s, p, d, f; families: alkali
%                           metals, alkaline-earth metals, halogens, noble gases
%   legend=true             a key in the empty space above groups 3-12, its
%                           labels from the keys `legend metal`, `legend
%                           metalloid`, `legend nonmetal`, `legend s`, ...,
%                           `legend alkali`, `legend alkaline`, `legend
%                           halogen`, `legend noble` (English defaults; a
%                           translation passes its own)
%   highlight={Na,K,Cl}     fill these cells with `highlight colour`
%   values={H/2.20,C/2.55}  print a value under the symbol (any TeX)
%   upto=20                 draw only Z <= 20 (the first periods)
%   f block=false           omit the two f-block rows
%   numbers=false           omit the atomic numbers
% Element positions are generated from the CIAAW table (Z, symbol); the
% categories are the conventional ones and are stated in the caption.
\newif\ifom@pt@f
\newif\ifom@pt@num
\newif\ifom@pt@legend
\newcount\om@pt@id
\pgfkeys{/omPT/.is family, /omPT,
  cell/.store in=\om@pt@cell, colour/.store in=\om@pt@colour,
  upto/.store in=\om@pt@upto, f block/.is if=om@pt@f,
  numbers/.is if=om@pt@num, legend/.is if=om@pt@legend,
  highlight colour/.store in=\om@pt@hlcol,
  highlight/.code={\foreach \x in {#1}{%
    \expandafter\gdef\csname om@pt@hl@\the\om@pt@id @\x\endcsname{1}}},
  values/.code={\foreach \x/\v in {#1}{%
    \expandafter\gdef\csname om@pt@val@\the\om@pt@id @\x\expandafter\endcsname
      \expandafter{\v}}},
  legend metal/.store in=\om@pt@Lmetal, legend metalloid/.store in=\om@pt@Lmetalloid,
  legend nonmetal/.store in=\om@pt@Lnonmetal,
  legend s/.store in=\om@pt@Ls, legend p/.store in=\om@pt@Lp,
  legend d/.store in=\om@pt@Ld, legend f/.store in=\om@pt@Lf,
  legend alkali/.store in=\om@pt@Lalkali, legend alkaline/.store in=\om@pt@Lalkaline,
  legend halogen/.store in=\om@pt@Lhalogen, legend noble/.store in=\om@pt@Lnoble,
}
