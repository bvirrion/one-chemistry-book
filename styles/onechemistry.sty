\pgfplotsset{omeph/.style={xmin=0, xmax=14, xtick={0,2,...,14},
  xlabel={pH}, ylabel={$E$ (V)}, grid=major,
  grid style={gray!25, line width=0.3pt}, clip=true,
  every axis label/.append style={font=\small},
  tick label style={font=\small}}}

