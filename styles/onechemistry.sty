% Book 4 (shared pics): crystallographic symmetry glyphs and stereographic
% projections, in the conventions of the International Tables for
% Crystallography (filled glyphs = axes perpendicular to the drawing plane).
% Written by the Book 4 writer (sync S3, 2026-10-02); shared by every book --
% keep the interfaces stable. All sizes in cm, centred on the origin of the
% pic. The glyphs keep their size whatever the picture's x/y unit vectors (so
% a cell drawn with x=3cm, y=3cm gets normal-size glyphs); to enlarge them,
% scale the whole drawing with [scale=..., every pic/.style={transform shape}].
%
%   pic {omtwofold}          twofold rotation axis: filled lens, 0.16 x 0.34
%   pic {omtwoone}           twofold screw axis 2_1: the lens with two tails
%   pic {omthreefold}        threefold axis: filled equilateral triangle
%                            (circumradius 0.17), a vertex up
%   pic {omfourfold}         fourfold axis: filled square, side 0.24
%   pic {omsixfold}          sixfold axis: filled regular hexagon, radius 0.16
%   pic {ominv}              centre of inversion: small open circle (r 0.05)
%   ommirror (style)         mirror plane seen edge-on: a thick line
%   omglide (style)          glide plane seen edge-on (glide in the drawing
%                            plane): a thick dashed line
%   pic {omgenpos={<sign>}{<comma>}}  a general position of a space-group
%                            diagram: open circle (r 0.12) with <sign> (+ or
%                            $-$, or a fraction such as $\tfrac12{+}$) on its
%                            right; <comma> = 1 adds a comma inside,
%                            marking the enantiomorph (mirror-image) copy
%   pic {omstereo={<R>}}     stereographic projection: circle of radius <R>
%                            with its horizontal and vertical diameters
%   pic {omup} / {omdown}    pole above the equator (filled dot) / below it
%                            (cross), for the points of a stereogram
% ----------------------------------------------------------------------------
\tikzset{
  pics/omtwofold/.style={code={\tikzset{x=1cm, y=1cm}
    \fill[black] (0,0.17) .. controls (0.11,0.06) and (0.11,-0.06) .. (0,-0.17)
      .. controls (-0.11,-0.06) and (-0.11,0.06) .. (0,0.17);}},
  pics/omtwoone/.style={code={\tikzset{x=1cm, y=1cm}
    \fill[black] (0,0.17) .. controls (0.11,0.06) and (0.11,-0.06) .. (0,-0.17)
      .. controls (-0.11,-0.06) and (-0.11,0.06) .. (0,0.17);
    \draw[black, line width=0.7pt] (0,0.17) .. controls (0.05,0.24) .. (0.13,0.24);
    \draw[black, line width=0.7pt] (0,-0.17) .. controls (-0.05,-0.24) .. (-0.13,-0.24);}},
  pics/omthreefold/.style={code={\tikzset{x=1cm, y=1cm}
    \fill[black] (90:0.17) -- (210:0.17) -- (330:0.17) -- cycle;}},
  pics/omfourfold/.style={code={\tikzset{x=1cm, y=1cm}\fill[black] (-0.12,-0.12) rectangle (0.12,0.12);}},
  pics/omsixfold/.style={code={\tikzset{x=1cm, y=1cm}
    \fill[black] (0:0.16) -- (60:0.16) -- (120:0.16) -- (180:0.16) -- (240:0.16)
      -- (300:0.16) -- cycle;}},
  pics/ominv/.style={code={\tikzset{x=1cm, y=1cm}\draw[black, fill=white, line width=0.5pt] (0,0) circle (0.05);}},
  ommirror/.style={black, line width=1.3pt},
  omglide/.style={black, line width=1.1pt, dashed},
  pics/omgenpos/.style 2 args={code={\tikzset{x=1cm, y=1cm}
    \draw[black, line width=0.5pt] (0,0) circle (0.12);
    \node[font=\scriptsize, inner sep=0.5pt, anchor=west] at (0.14,0) {#1};
    \ifnum#2=1 \node[font=\scriptsize, inner sep=0pt] at (0,0.02) {,};\fi}},
  pics/omstereo/.style={code={
    \draw[black, line width=0.6pt] (0,0) circle (#1);
    \draw[black!50, line width=0.4pt] (-#1,0) -- (#1,0) (0,-#1) -- (0,#1);}},
  pics/omup/.style={code={\tikzset{x=1cm, y=1cm}\fill[black] (0,0) circle (0.06);}},
  pics/omdown/.style={code={\tikzset{x=1cm, y=1cm}\draw[black, line width=0.7pt] (-0.07,-0.07) -- (0.07,0.07)
    (-0.07,0.07) -- (0.07,-0.07);}},
}

% ----------------------------------------------------------------------------
% Book 3 (shared pics): orbital energy levels and correlation lines, orbital
% lobes (s, p, single lobes, the five d), coordination geometries, and three
% pieces of synthesis/analysis apparatus. Written by the Book 3 writer
% (2026-10-03); shared by every book (Book 4 reuses them for correlation
% diagrams, ligand fields and Jablonski-type level drawings) -- keep the
% interfaces stable. All sizes in cm; like the glassware pics, in a scaled
% tikzpicture use \pic[transform shape].
%
% Energy levels
%   pic {omlevel={<e>}{<length>}}  a horizontal level of the given length,
%       centred on the origin; <e> = ud (two paired electrons), u (one up),
%       d (one down) or empty. Points (-l) and (-r): the two ends, for
%       correlation lines; (-c) the centre. Example:
%       \pic (a) at (0,1.2) {omlevel={ud}{1.0}};
%       \draw[omcorr] (a-r) -- (b-l);
%   omcorr (style)           correlation line between levels (thin, grey)
%   omcorrforbidden (style)  correlation that crosses / is symmetry-forbidden
%                            (thin, dashed, dark red)
%   omsymlabel (style)       small symmetry label (S, A, a1, t2g...) put at a
%                            level end: \node[omsymlabel, right] at (a-r) {S};
%
% Orbital lobes (phases: omphasepos = blue fill, omphaseneg = orange fill; a
% book may restyle both). Sizes are proportional to |c|, the coefficient of
% the orbital on that atom (|c| = 1 gives a lobe 0.8 cm long, an s circle of
% radius 0.32 cm); c = 0 draws a small open node marker.
%   pic {oms={<c>}}              s orbital: circle, colour by the sign of c
%   pic {omlobe={<c>}{<angle>}}  one lobe from the origin towards <angle>
%                                (degrees), colour by the sign of c (hybrids,
%                                fragment orbitals)
%   pic {omp={<c>}{<angle>}}     p orbital: two lobes along <angle>; the lobe
%                                pointing at <angle> has the sign of c, the
%                                other the opposite sign (Huckel drawings:
%                                \pic at (x,y) {omp={0.60}{90}};)
%   pic {omdxy} {omdxz} {omdyz} {omdx2y2} {omdz2}
%       the five d orbitals, 2D drawings about 1.5 cm across, with their two
%       labelled axes (x right, y or z up; for dxz, x right and z up; dyz, y
%       right and z up); dz2 = two lobes along z and a ring of the other sign.
%
% Coordination geometries (ball and stick, metal at the origin, M-L bonds of
% length 1; ligands node style omligand, metal ommetal; back bonds dashed).
% Points (-M) and (-L1)..(-Ln) for labels:
%   pic {omoctahedron}   L1 up, L2 down, L3 right, L4 left, L5 front, L6 back
%   pic {omtetrahedron}  L1 up, L2 front, L3 right, L4 back-left
%   pic {omsquareplanar} L1 right, L2 left, L3 front, L4 back
%   pic {omtbp}          trigonal bipyramid: L1 up, L2 down (axial),
%                        L3 right, L4 front-left, L5 back-left (equatorial)
%
% Apparatus (origin and points as stated, glassware line style om glass)
%   pic {chromcolumn={<bed height>}}  chromatography column 0.7 cm wide and
%       5.0 cm tall above a stopcock; tip at the origin; silica bed filled
%       from 0.5 cm to <bed height> (cm) with a sand layer on top; points
%       (-tip), (-bed) top of the bed (centre), (-top) mouth.
%   pic {bubbler}         oil bubbler, 2.6 cm tall: inlet (-in) at the top
%       left, gas dipping into the oil, outlet (-out) at the top right;
%       origin at the bottom centre.
%   pic {septum}          rubber septum folded over a neck of width 0.4 whose
%       top is the origin; (-top) is where a needle enters.
% \setmodiagram below: series defaults for modiagram's MOdiagram
% environment (square levels, dashed grey correlation lines, small labels).
% ----------------------------------------------------------------------------
\tikzset{
  omcorr/.style={thin, black!50},
  omcorrforbidden/.style={thin, densely dashed, omThm},
  omsymlabel/.style={font=\scriptsize, inner sep=1.5pt},
  omphasepos/.style={fill=omDef!40, draw=omDef!80!black, line width=0.5pt},
  omphaseneg/.style={fill=omProp!35, draw=omProp!80!black, line width=0.5pt},
  omligand/.style={circle, fill=black!35, draw=black!70, inner sep=0pt,
    minimum size=2.6mm},
  ommetal/.style={circle, fill=omProp!70, draw=black!70, inner sep=0pt,
    minimum size=3.6mm},
  % levels
  pics/omlevel/.style 2 args={code={
    \draw[very thick, black!85] ({-(#2)/2},0) -- ({(#2)/2},0);
    \coordinate (-l) at ({-(#2)/2},0);
    \coordinate (-r) at ({(#2)/2},0);
    \coordinate (-c) at (0,0);
    \def\om@lev{#1}\def\om@ud{ud}\def\om@u{u}\def\om@d{d}%
    \ifx\om@lev\om@ud
      \draw[-{Stealth[length=1.6mm]}, thick] (-0.09,-0.16) -- (-0.09,0.18);
      \draw[-{Stealth[length=1.6mm]}, thick] (0.09,0.18) -- (0.09,-0.16);
    \else\ifx\om@lev\om@u
      \draw[-{Stealth[length=1.6mm]}, thick] (0,-0.16) -- (0,0.18);
    \else\ifx\om@lev\om@d
      \draw[-{Stealth[length=1.6mm]}, thick] (0,0.18) -- (0,-0.16);
    \fi\fi\fi
  }},
  % lobes
  pics/oms/.style={code={
    \pgfmathsetmacro\om@r{0.32*abs(#1)}%
    \pgfmathparse{abs(#1)<0.001 ? 1 : 0}%
    \ifnum\pgfmathresult=1
      \draw[black!60] (0,0) circle (0.04);
    \else
      \pgfmathparse{(#1)>=0 ? 1 : 0}%
      \ifnum\pgfmathresult=1 \path[omphasepos] (0,0) circle (\om@r);
      \else \path[omphaseneg] (0,0) circle (\om@r);\fi
    \fi
  }},
  pics/omlobe/.style 2 args={code={
    \pgfmathsetmacro\om@s{0.8*abs(#1)}%
    \pgfmathparse{abs(#1)<0.001 ? 1 : 0}%
    \ifnum\pgfmathresult=1
      \draw[black!60] (0,0) circle (0.04);
    \else
      \pgfmathparse{(#1)>=0 ? 1 : 0}%
      \ifnum\pgfmathresult=1 \def\om@ph{omphasepos}\else\def\om@ph{omphaseneg}\fi
      \path[\om@ph, rotate=(#2)-90] (0,0) .. controls (0.42*\om@s,0.42*\om@s)
        and (0.36*\om@s,\om@s) .. (0,\om@s) .. controls (-0.36*\om@s,\om@s)
        and (-0.42*\om@s,0.42*\om@s) .. (0,0) -- cycle;
    \fi
  }},
  pics/omp/.style 2 args={code={
    \pgfmathsetmacro\om@c{#1}%
    \pgfmathsetmacro\om@mc{-(#1)}%
    \pic {omlobe={\om@c}{#2}};
    \pic {omlobe={\om@mc}{(#2)+180}};
  }},
  % d orbitals: four lobes of alternating sign at <start> + k*90 degrees
  pics/om@dfour/.style n args={3}{code={
    \pic {omlobe={1}{#1}}; \pic {omlobe={-1}{(#1)+90}};
    \pic {omlobe={1}{(#1)+180}}; \pic {omlobe={-1}{(#1)+270}};
    \draw[->, black!55, thin] (-0.95,0) -- (0.95,0) node[right, font=\tiny] {#2};
    \draw[->, black!55, thin] (0,-0.95) -- (0,0.95) node[above, font=\tiny] {#3};
  }},
  pics/omdxy/.style={code={\pic {om@dfour={45}{$x$}{$y$}};}},
  pics/omdxz/.style={code={\pic {om@dfour={45}{$x$}{$z$}};}},
  pics/omdyz/.style={code={\pic {om@dfour={45}{$y$}{$z$}};}},
  pics/omdx2y2/.style={code={\pic {om@dfour={0}{$x$}{$y$}};}},
  pics/omdz2/.style={code={
    \path[omphaseneg] (0,0) ellipse (0.48 and 0.14);
    \pic {omlobe={1}{90}}; \pic {omlobe={1}{270}};
    \draw[->, black!55, thin] (-0.95,0) -- (0.95,0) node[right, font=\tiny] {$x$};
    \draw[->, black!55, thin] (0,-0.95) -- (0,0.95) node[above, font=\tiny] {$z$};
  }},
  % coordination geometries
  pics/omoctahedron/.style={code={
    \coordinate (-M) at (0,0);
    \coordinate (-L1) at (0,1); \coordinate (-L2) at (0,-1);
    \coordinate (-L3) at (1,0); \coordinate (-L4) at (-1,0);
    \coordinate (-L5) at (-0.42,-0.36); \coordinate (-L6) at (0.42,0.36);
    \draw[thick, black!70, dashed] (0,0) -- (0.42,0.36);
    \draw[thick, black!70] (0,1) -- (0,-1) (-1,0) -- (1,0) (0,0) -- (-0.42,-0.36);
    \node[omligand] at (0.42,0.36) {};
    \node[ommetal] at (0,0) {};
    \foreach \p in {(0,1),(0,-1),(1,0),(-1,0),(-0.42,-0.36)} \node[omligand] at \p {};
  }},
  pics/omtetrahedron/.style={code={
    % a regular tetrahedron (one vertex up) in the oblique view
    % x' = x + 0.35 z, y' = y - 0.25 z, z towards the reader
    \coordinate (-M) at (0,0);
    \coordinate (-L1) at (0,1); \coordinate (-L2) at (-0.19,-0.54);
    \coordinate (-L3) at (0.94,-0.33); \coordinate (-L4) at (-0.76,-0.13);
    \draw[thick, black!70, dashed] (0,0) -- (-0.76,-0.13);
    \node[omligand] at (-0.76,-0.13) {};
    \draw[thick, black!70] (0,0) -- (0,1) (0,0) -- (-0.19,-0.54) (0,0) -- (0.94,-0.33);
    \node[ommetal] at (0,0) {};
    \foreach \p in {(0,1),(-0.19,-0.54),(0.94,-0.33)} \node[omligand] at \p {};
  }},
  pics/omsquareplanar/.style={code={
    \coordinate (-M) at (0,0);
    \coordinate (-L1) at (1,0); \coordinate (-L2) at (-1,0);
    \coordinate (-L3) at (-0.42,-0.36); \coordinate (-L4) at (0.42,0.36);
    \draw[thick, black!70, dashed] (0,0) -- (0.42,0.36);
    \node[omligand] at (0.42,0.36) {};
    \draw[thick, black!70] (-1,0) -- (1,0) (0,0) -- (-0.42,-0.36);
    \node[ommetal] at (0,0) {};
    \foreach \p in {(1,0),(-1,0),(-0.42,-0.36)} \node[omligand] at \p {};
  }},
  pics/omtbp/.style={code={
    \coordinate (-M) at (0,0);
    \coordinate (-L1) at (0,1); \coordinate (-L2) at (0,-1);
