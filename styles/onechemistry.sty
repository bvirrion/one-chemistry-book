    \node[ommetal] at (0,0) {};
    \foreach \p in {(0,1),(0,-1),(1,-0.05),(-0.62,-0.34)} \node[omligand] at \p {};
  }},
  % apparatus
  pics/chromcolumn/.style={code={
    \coordinate (-tip) at (0,0);
    \coordinate (-top) at (0,5.6);
    \coordinate (-bed) at (0,#1);
    \begin{scope}
      \clip (-0.35,0.5) rectangle (0.35,5.6);
