% Binary phase diagrams: composition 0..1 on x, T on y. Liquidus / bubble
% curve in omDef, solidus / dew curve in omThm, tie lines dashed.
\pgfplotsset{omphase/.style={xmin=0, xmax=1, axis x line=bottom,
  axis y line=left, every axis label/.append style={font=\small},
  tick label style={font=\small}, clip=false, enlarge y limits=false}}
\tikzset{omliquidus/.style={omDef, thick}, omsolidus/.style={omThm, thick},
  tieline/.style={densely dashed, gray!70, line width=0.5pt}}
% Current-potential curves: E to the right, i up, through the origin.
% Anodic branches omThm, cathodic omDef, solvent walls dashed.
\pgfplotsset{omie/.style={axis lines=middle, xtick=\empty, ytick=\empty,
  clip=false, every axis label/.append style={font=\small}}}
\tikzset{omanodic/.style={omThm, thick}, omcathodic/.style={omDef, thick},
  omwall/.style={gray, densely dashed, thick}}
% Ellingham diagrams: T in K, Delta_r G in kJ per mol O2.
\pgfplotsset{omellingham/.style={xmin=0, xmax=2500, grid=major,
  grid style={gray!25, line width=0.3pt}, clip=true,
  every axis label/.append style={font=\small}, tick label style={font=\small}}}
% Chromatograms (time axis, no y ticks) and mass spectra (bars, 0..105 %).
\pgfplotsset{omchrom/.style={axis x line=bottom, axis y line=left, ytick=\empty,
  ymin=0, every axis label/.append style={font=\small},
