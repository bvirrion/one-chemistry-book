\RequirePackage{array}
\usetikzlibrary{decorations.pathreplacing}
% Units and notations: \qty{-1.1167}{\hartree}, \qty{1.4}{\bohr};
% \termsym{3}{P}{2} gives ^3P_2; \kv{V}{O}{\bullet\bullet} gives the
% Kroger-Vink symbol V_O with two dots.
\DeclareSIUnit{\hartree}{\ensuremath{E_\mathrm{h}}}
\DeclareSIUnit{\bohr}{\ensuremath{a_0}}
\newcommand{\termsym}[3]{\ensuremath{{}^{#1}\mathrm{#2}_{#3}}}
\newcommand{\kv}[3]{\ensuremath{\mathrm{#1}_{\mathrm{#2}}^{#3}}}
% Character tables, in math mode; one row per irreducible representation,
% every row ending with \\ (a test parses them):
%   \begin{omchartable}{C_{2v}}{cccc}{E & C_2 & \sigma_v(xz) & \sigma_v'(yz)}
%   A_1 & 1 & 1 & 1 & 1 & z & x^2, y^2, z^2 \\
%   ...
%   \end{omchartable}
% Arguments: the group, the column spec of the classes, the class headers.
% The last two columns (linear and rotations; quadratic) are left-aligned.
\newenvironment{omchartable}[3]{%
  \begin{center}\small\renewcommand{\arraystretch}{1.15}%
  $\begin{array}{l|#2|l|l}\hline
  #1 & #3 & & \\ \hline}{%
  \hline\end{array}$\end{center}}
% Jablonski diagrams: states and vibrational sublevels, radiative arrows
% (absorption omDef, fluorescence omThm, phosphorescence omProp), wavy
% non-radiative arrows, dashed wavy intersystem crossing.
\tikzset{omstate/.style={very thick, black!80},
  omvib/.style={thin, black!45},
  omabs/.style={-{Stealth}, thick, omDef},
  omfluo/.style={-{Stealth}, thick, omThm},
  omphos/.style={-{Stealth}, thick, omProp},
  omnonrad/.style={-{Stealth}, decorate, decoration={snake, amplitude=0.4mm,
    segment length=2mm, post length=1.5mm}},
  omisc/.style={omnonrad, densely dashed},
  % single-electron curly arrow (fishhook), for \chemmove
  omfishhook/.style={-{Straight Barb[left]}},
  % minimum-energy path and saddle point on a potential-energy surface
  ompath/.style={very thick, densely dashed, omThm},
  omsaddle/.style={cross out, draw=black, thick, minimum size=2.2mm, inner sep=0pt},
  % Tanabe-Sugano: spin-changed (forbidden) states drawn thin and grey
  omtsforbidden/.style={thin, gray!70}}
% Tanabe-Sugano diagrams, potential-energy surfaces (contours prepared by
% figdata, no gnuplot), cyclic voltammograms (E to the right, anodic current
% positive); omscan=<pos> puts a scan-direction arrow on a curve.
\pgfplotsset{omts/.style={axis x line=bottom, axis y line=left, xmin=0, ymin=0,
    clip=false, every axis label/.append style={font=\small},
    tick label style={font=\small}},
  ompes/.style={view={0}{90}, axis equal image, colormap/viridis,
    every axis label/.append style={font=\small}, tick label style={font=\small}},
  omcv/.style={axis x line=bottom, axis y line=left,
    every axis label/.append style={font=\small}, tick label style={font=\small}}}
\tikzset{omscan/.style={postaction={decorate}, decoration={markings,
  mark=at position #1 with {\arrow{Stealth}}}}}


