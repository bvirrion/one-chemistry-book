    \draw[black!70, line width=0.8pt] (-0.28,0.21) -- (0.28,0.21);
    \fill[white, draw=black!40] (-0.3,0.5) .. controls (0,0.62) .. (0.3,0.5);
  }},
  pics/bubbler/.style={code={
    \begin{scope}
      \clip (-0.6,0) -- (-0.6,1.7) -- (0.6,1.7) -- (0.6,0) -- cycle;
      \fill[yellow!25] (-0.6,0) rectangle (0.6,0.6);
    \end{scope}
    \draw[om glass] (-0.6,1.9) -- (-0.6,0.15) arc[start angle=180, end angle=360,
