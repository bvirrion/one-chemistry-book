% Quantum boxes, one per orbital, in a row: \omorbs{ud,ud,u,} gives a full,
% a full, a half-filled and an empty box (u = one electron spin up, d = spin
% down, ud = a pair, empty = vacant). Sits on the text baseline.
\newcommand{\om@orbspin}[2]{%
  \ifdefstring{#1}{ud}{%
    \draw[-{Straight Barb[left,length=2.2pt]}] (#2+0.32,0.14) -- (#2+0.32,0.86);
    \draw[-{Straight Barb[left,length=2.2pt]}] (#2+0.68,0.86) -- (#2+0.68,0.14);}{}%
  \ifdefstring{#1}{u}{%
    \draw[-{Straight Barb[left,length=2.2pt]}] (#2+0.5,0.14) -- (#2+0.5,0.86);}{}%
  \ifdefstring{#1}{d}{%
    \draw[-{Straight Barb[left,length=2.2pt]}] (#2+0.5,0.86) -- (#2+0.5,0.14);}{}}
\newcommand{\omorbs}[1]{%
  \tikz[baseline=0.1em,x=1.15em,y=1.15em,line width=0.45pt]{%
    \foreach \om@s [count=\om@i from 0] in {#1}{%
      \draw (\om@i,0) rectangle ++(1,1);%
      \om@orbspin{\om@s}{\om@i}}}}

% Plot styles. Labels are written in the chapter (they are prose, and get
% translated with it).
% Energy profile: \begin{axis}[omprofile, xlabel={Reaction coordinate},
% ylabel={Energy}] ... the curve from figdata ... \end{axis}
\pgfplotsset{omprofile/.style={axis x line=bottom, axis y line=left,
  xtick=\empty, ytick=\empty, clip=false, axis line style={-{Stealth}},
  enlargelimits=false, every axis label/.append style={font=\small}}}
