% Book 2 (shared pics), addendum 2026-10-02: crystal cells with the hidden
% edges of the real view. For tikz-3dplot main coords {theta}{phi} with
% 0 < theta < 90 and 90 < phi < 180 (for example {60}{100}, which separates
% face and body diagonals of a cube in projection), the viewer looks from
% +x, +y, +z: the farthest cube vertex is the ORIGIN, and the farthest prism
% vertices are those at 180 and 240 degrees. omcube and omhexprism above
% dash the wrong edges for these views; use these instead. Depth for
% drawing atoms back to front: sin(theta)sin(phi) x - sin(theta)cos(phi) y
% + cos(theta) z, smallest first.
%   pic {omcubeo={<a>}}           cube (0,0,0)-(a,a,a), edges at the origin dashed.
%   pic {omhexprismo={<a>}{<c>}}  hexagonal prism as omhexprism, bottom edges
%                                 120-180-240-300 and vertical edges at 180
%                                 and 240 degrees dashed.
\tikzset{
  pics/omcubeo/.style={code={
    \def\om@a{#1}
    \draw[black!70, line width=0.5pt] (\om@a,0,0) -- (\om@a,\om@a,0) -- (\om@a,\om@a,\om@a)
      -- (\om@a,0,\om@a) -- cycle;
    \draw[black!70, line width=0.5pt] (\om@a,\om@a,0) -- (0,\om@a,0) -- (0,\om@a,\om@a)
      -- (\om@a,\om@a,\om@a) (0,\om@a,\om@a) -- (0,0,\om@a) -- (\om@a,0,\om@a);
    \draw[black!55, line width=0.5pt, dashed] (0,0,0) -- (\om@a,0,0)
      (0,0,0) -- (0,\om@a,0) (0,0,0) -- (0,0,\om@a);
  }},
  pics/omhexprismo/.style 2 args={code={
    \foreach \k in {0,60,...,300} {
      \pgfmathsetmacro\om@ka{\k+60}
      \ifnum\k=120 \tikzset{om@hb/.style={dashed, black!55}}
      \else\ifnum\k=180 \tikzset{om@hb/.style={dashed, black!55}}
      \else\ifnum\k=240 \tikzset{om@hb/.style={dashed, black!55}}
      \else \tikzset{om@hb/.style={black!70}}\fi\fi\fi
      \ifnum\k=180 \tikzset{om@hv/.style={dashed, black!55}}
      \else\ifnum\k=240 \tikzset{om@hv/.style={dashed, black!55}}
      \else \tikzset{om@hv/.style={black!70}}\fi\fi
      \draw[om@hb, line width=0.5pt] ({#1*cos(\k)},{#1*sin(\k)},0)
        -- ({#1*cos(\om@ka)},{#1*sin(\om@ka)},0);
      \draw[black!70, line width=0.5pt] ({#1*cos(\k)},{#1*sin(\k)},#2)
        -- ({#1*cos(\om@ka)},{#1*sin(\om@ka)},#2);
      \draw[om@hv, line width=0.5pt] ({#1*cos(\k)},{#1*sin(\k)},0)
        -- ({#1*cos(\k)},{#1*sin(\k)},#2);
    }
  }},
}

