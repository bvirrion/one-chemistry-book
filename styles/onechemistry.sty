  \fill[#2, draw=black!50, line width=0.3pt]
    (3, -0.2-0.68*#1) rectangle ++(0.5,-0.5);
  \node[anchor=west, font=\footnotesize, inner sep=1pt] at (3.6,-0.45-0.68*#1) {#3};}
\newcommand{\omperiodictable}[1][]{%
  \global\advance\om@pt@id by 1
  \pgfkeys{/omPT, cell=0.82cm, colour=none, upto=118, f block=true,
    numbers=true, legend=false, highlight colour=orange!45,
    legend metal=metals, legend metalloid=metalloids, legend nonmetal=non-metals,
    legend s=s block, legend p=p block, legend d=d block, legend f=f block,
    legend alkali=alkali metals, legend alkaline=alkaline-earth metals,
    legend halogen=halogens, legend noble=noble gases, #1}%
  \begin{tikzpicture}[x=\om@pt@cell, y=\om@pt@cell, line width=0.35pt]
    \foreach \z/\s/\c/\r in \om@pt@list {%
      \ifnum\z>\om@pt@upto\relax\else
      \ifom@pt@f\def\om@pt@show{1}\else
        \ifnum\r>7 \def\om@pt@show{0}\else\def\om@pt@show{1}\fi\fi
      \ifnum\om@pt@show=1
        \om@pt@pickfill{\z}{\s}{\c}{\r}%
        \pgfmathsetmacro\om@pt@yy{\ifnum\r>7 -(\r-0.65)\else -\r\fi}%
        \fill[\om@pt@fill, draw=black!55] (\c-1,\om@pt@yy+1) rectangle ++(1,-1);
        \ifom@pt@num
          \node[anchor=north west, inner sep=1.2pt, font=\fontsize{5}{5}\selectfont]
            at (\c-1,\om@pt@yy+1) {\z};\fi
        \ifcsname om@pt@val@\the\om@pt@id @\s\endcsname
          \node[font=\footnotesize\bfseries, inner sep=0pt, anchor=base] at (\c-0.5,\om@pt@yy+0.36) {\s};
          \node[font=\fontsize{5}{5}\selectfont, inner sep=0pt, anchor=base] at (\c-0.5,\om@pt@yy+0.1)
            {\csname om@pt@val@\the\om@pt@id @\s\endcsname};
        \else
          \node[font=\footnotesize\bfseries, inner sep=0pt, anchor=base] at (\c-0.5,\om@pt@yy+0.28) {\s};
        \fi
      \fi\fi}
    \ifom@pt@f\ifnum\om@pt@upto>56
      \def\om@pt@fill{white}%
      \ifdefstring{\om@pt@colour}{metals}{\def\om@pt@fill{omPTmetal}}{}%
      \ifdefstring{\om@pt@colour}{blocks}{\def\om@pt@fill{omPTf}}{}%
      \foreach \r/\t in {6/57--71, 7/89--103}{%
        \fill[\om@pt@fill, draw=black!55] (2,-\r+1) rectangle ++(1,-1);
        \node[font=\fontsize{4.5}{5}\selectfont, inner sep=0pt] at (2.5,-\r+0.5) {\t};}
    \fi\fi
    \ifom@pt@legend
      \ifdefstring{\om@pt@colour}{metals}{%
        \om@pt@swatch{0}{omPTmetal}{\om@pt@Lmetal}%
        \om@pt@swatch{1}{omPTmetalloid}{\om@pt@Lmetalloid}%
        \om@pt@swatch{2}{omPTnonmetal}{\om@pt@Lnonmetal}}{}%
      \ifdefstring{\om@pt@colour}{blocks}{%
        \om@pt@swatch{0}{omPTs}{\om@pt@Ls}\om@pt@swatch{1}{omPTp}{\om@pt@Lp}%
        \om@pt@swatch{2}{omPTd}{\om@pt@Ld}\om@pt@swatch{3}{omPTf}{\om@pt@Lf}}{}%
      \ifdefstring{\om@pt@colour}{families}{%
        \om@pt@swatch{0}{omPTalkali}{\om@pt@Lalkali}%
        \om@pt@swatch{1}{omPTalkaline}{\om@pt@Lalkaline}%
        \om@pt@swatch{2}{omPThalogen}{\om@pt@Lhalogen}%
        \om@pt@swatch{3}{omPTnoble}{\om@pt@Lnoble}}{}%
    \fi
  \end{tikzpicture}}

% ----------------------------------------------------------------------------
% Book 2 (shared pics): molecular projections, crystal cells, electrochemistry
% and organic apparatus. Written by the Book 2 writer (sync S1, 2026-10-02);
% shared by every book -- keep the interfaces below stable. All in cm, drawn
% with the glassware line style (om glass). Like the glassware pics, in a
% scaled tikzpicture every pic needs \pic[transform shape].
%
% Named points: a pic placed as \pic (n) at (x,y) {omnewman={0}{60}}; exposes
% its points as (n-f1), (n-b2), ... for labels and bonds.
%
% Molecular projections
%   pic {omnewman={<front angle>}{<back angle>}}
%       Newman projection centred on the origin: front bonds from the centre
%       at <front>, +120, +240 degrees (length 1.1), back bonds from the rim
%       of a circle of radius 0.55 at <back>, +120, +240. Points: (-c) the
%       centre, (-f1..3) and (-b1..3) label positions at radius 1.45.
%       Eclipsed: <back> = <front> + small offset (e.g. 0 and 8).
%   pic {omchair} / pic {omchairflip}
%       Cyclohexane chair (ring only), about 3.1 x 0.9 cm, centred on the
%       origin; omchairflip is the ring-flipped chair (mirror image left-right).
%       Points: ring atoms (-c1..6); ends of the axial bonds (-a1..6) and of
%       the equatorial bonds (-e1..6), length 0.75: draw a substituent bond
%       as \draw (n-c1) -- (n-a1); and its label at the end. c1, c3, c5 are
%       the "up" carbons (axial up), c2, c4, c6 "down"; c4 is the left tip,
%       c1 the right tip. Every equatorial bond is parallel to the ring bonds
%       once removed.
%
% SUPERSEDED (main session, 2026-10-02): omcube/omhexprism dash the wrong
% edges for the usual views; use omcubeo/omhexprismo from the addendum below
% (view {60}{100} for cubic cells, {70}{113} for the HCP prism). Kept for the
% record only:
% Crystal cells (tikz-3dplot): set \tdplotsetmaincoords{70}{110} and draw in
% [tdplot_main_coords]; the hidden edges are dashed for that view only.
%   pic {omcube={<a>}}          cube of side <a> from (0,0,0) to (a,a,a);
%                               the edges meeting at (0,a,0) are dashed.
%   pic {omhexprism={<a>}{<c>}} hexagonal prism, hexagon side <a> centred on
%                               the z axis, base z = 0, height <c>; the three
%                               edges at the back vertex (120 degrees) dashed.
%   node styles cellA=<size> (large grey ball, default 7mm), cellB=<size>
%   (small red ball, default 4mm), cellC=<size> (blue, default 5mm) and
%   cellsite=<size> (hollow dashed circle marking an interstitial site,
%   default 3mm): \node[cellA=5mm] at (1,1,0) {};
%
% Electrochemistry
%   pic {electrode={<colour>}}  metal strip 0.3 x 2.4 cm, bottom at the
%                               origin; point (-top) is the clip at the top.
%   pic {saltbridge={<span>}}   inverted U tube: legs end at (0,0) and
%                               (<span>,0), top bar at height 2.6.
%   pic {meter={<display>}}     instrument box 1.5 x 0.9 centred on the
%                               origin, showing <display> (V, pH, mS/m);
%                               terminals (-a) and (-b) under the box.
%   pic {probe}                 combined glass electrode, bulb bottom at the
%                               origin, 3.0 cm tall; (-top) is its cap.
%   pic {stirrer}               magnetic stirrer whose top surface is y = 0,
%                               with a stir bar drawn just above it (inside
%                               a vessel standing on the stirrer).
%
% Organic apparatus (origin at the bottom centre unless said otherwise)
%   pic {threeneck={<level>}{<colour>}}  round-bottom flask (radius 1) with a
%       central neck to 3.0 and two side necks leaning out by 25 degrees;
%       points (-c), (-l), (-r) are the tops of the necks.
%   pic {dropfunnel={<level>}{<colour>}} pressure-equalising addition
%       funnel, stem tip at the origin, 3.6 cm tall, side tube on the right.
%   pic {guardtube}                drying tube with its granules, bottom
%       joint at the origin, 1.8 cm tall.
%   pic {deanstark={<lower>}{<lower colour>}{<upper colour>}}  Dean--Stark
%       trap: vertical vapour tube from the origin (flask joint) to (0,3.4)
%       (condenser joint); graduated collector on the right (x = 0.6) with a
%       stopcock; <lower> is the height fraction of the lower (denser) layer
%       in the collector, the upper layer fills it to the return arm.
%   pic {stillhead}                distillation head: joint at the origin,
%       vertical body to 1.4 with a thermometer port; side arm going down to
%       the right at 20 degrees below horizontal; (-arm) is its end, (-top)
%       the port.
%   pic {thermometer}              3.2 cm thermometer, bulb bottom at the
%       origin; in a still head put the bulb level with the side arm:
%       \pic at ($(s-top)+(0,-0.75)$) {thermometer};
%   pic {liebig={<length>}}        straight condenser drawn along +x from
%       the origin (inlet) to (<length>,0) with its water jacket and two
%       hose connectors (water in at the low end); rotate the pic itself
%       (\pic[rotate=-20]) to incline it.
%   pic {adapter}                  receiver adapter: from the origin a short
%       tube along +x then a drip tip down to (0.5,-0.8) = (-tip).
%   pic {heatingmantle}            heating mantle cradling a round flask of
%       radius 1 whose bottom is the origin.
%   pic {buchner={<cake colour or none>}}  Buchner funnel, stem tip at the
%       origin, plate at 1.2, rim at 1.9.
%   pic {filterflask={<level>}{<colour>}}  filter (side-arm) flask, 2.8 cm
%       tall, side arm to the right at 2.2; (-arm) is its end.
% ----------------------------------------------------------------------------
