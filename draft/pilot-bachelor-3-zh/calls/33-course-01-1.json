 "result": "\\chapter{\u7b2c \\ref{ch:b3:lab-techniques-3} \u7ae0 --- \u79d1\u7814\u5b9e\u9a8c\u6280\u672fIII\uff1a\u7814\u7a76\u5b9e\u8df5}\\label{ch:b3:lab-techniques-3}\n\n\u4e00\u74f6\u4e01\u57fa\u9502\u6eb6\u6db2\uff0c\u53ea\u8981\u6709\u4e00\u6ef4\u63a5\u89e6\u7a7a\u6c14\u4fbf\u4f1a\u8d77\u706b\uff1b\u624b\u5957\u7bb1\u80fd\u5c06\n\u6c27\u6c14\u548c\u6c34\u7684\u542b\u91cf\u63a7\u5236\u5728\u767e\u4e07\u5206\u4e4b\u51e0\u4ee5\u4e0b\uff0c\u4f7f\u6b64\u7c7b\u5316\u5408\u7269\n\u53ef\u4ee5\u50cf\u98df\u76d0\u4e00\u6837\u79f0\u91cf\u3002\u79d1\u7814\u5316\u5b66\u5e38\u59cb\u4e8e\u9694\u7edd\u7a7a\u6c14\uff0c\n\u7ec8\u4e8e\u4e00\u4e2a\u5fc5\u987b\u80fd\u88ab\u4ed6\u4eba\u6838\u67e5\u7684\u7ed3\u8bba\uff1a\u4e00\u79cd\u65b0\u5316\u5408\u7269\uff0c\n\u5176\u7ed3\u6784\u548c\u7eaf\u5ea6\u7ecf\u591a\u79cd\u72ec\u7acb\u65b9\u6cd5\u8bc1\u5b9e\uff0c\u5176\u6570\u636e\u88ab\u8bb0\u5f55\u5e76\u53d1\u8868\uff0c\n\u4ee5\u4fbf\u5de5\u4f5c\u53ef\u4ee5\u91cd\u590d\u3002\u672c\u7ae0\u6c47\u96c6\u79d1\u7814\u5b9e\u8df5\u7684\u64cd\u4f5c\uff1a\u5904\u7406\u5bf9\u7a7a\u6c14\u654f\u611f\u7684\u7269\u8d28\u3001\n\u8868\u5f81\u65b0\u5316\u5408\u7269\u3001\u4ee5\u7edf\u8ba1\u65b9\u6cd5\u5224\u65ad\u7ed3\u679c\u3001\u7ba1\u7406\u5b9e\u9a8c\u8bb0\u5f55\u672c\u5e76\u67e5\u9605\u6587\u732e\uff0c\n\u4ee5\u53ca\u8bc4\u4f30\u4e00\u9879\u6b64\u524d\u65e0\u4eba\u505a\u8fc7\u7684\u64cd\u4f5c\u7684\u98ce\u9669\u3002\n=\n=\n=\n=\n\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u8bb2\u8ff0\u4e86\u5371\u5bb3\u3001\u98ce\u9669\u3001\u8c61\u5f62\u56fe\u3001H \u548c P \u8bf4\u660e\u3001\n\u5b89\u5168\u6280\u672f\u8bf4\u660e\u4e66\u53ca\u6d4b\u91cf\u4e0d\u786e\u5b9a\u5ea6\u7684 A \u7c7b\u548c B \u7c7b\u8bc4\u5b9a\uff1b\u672c\u79d1\u4e8c\u5e74\u7ea7\u5206\u518c\u8bb2\u8ff0\u4e86\u60f0\u6027\u6c14\u6c1b\u3001\n\u540e\u5904\u7406\u3001\u5e72\u71e5\u5242\u3001\u5feb\u901f\u67f1\u8272\u8c31\u3001\u8d28\u8c31\u6cd5\uff08HRMS\u3001\u5355\u540c\u4f4d\u7d20\u8d28\u91cf\uff09\u3001\n$^{13}$C \u6838\u78c1\u5171\u632f\u8c31\u3001\u7f6e\u4fe1\u533a\u95f4\u3001\u5b66\u751f t \u7cfb\u6570\u3001\u6821\u51c6\u3001\u7cbe\u5bc6\u5ea6\u3001\u6b63\u786e\u5ea6\u3001\n\u504f\u501a\u3001\u91cd\u590d\u6027\u3001\u65b9\u6cd5\u9a8c\u8bc1\u3001\u7edd\u70ed\u6e29\u5347\u4e0e\u70ed\u5931\u63a7\u3002\n\\Cref{ch:b3:advanced-nmr}\u3001\\cref{ch:b3:x-ray-diffraction}\u548c\n\\cref{ch:b3:electrode-kinetics}\u63d0\u4f9b\u4e86\u7ed3\u6784\u548c\u7535\u5316\u5b66\n\u65b9\u6cd5\u3002\n=\n=\n=\n=\n=\n=\n{\\small \u914d\u6709\u624b\u5957\u7bb1\u7684\u79d1\u7814\u5b9e\u9a8c\u5ba4\uff1a\u4e0d\u9508\u94a2\u7bb1\u4f53\uff0c\n\u5185\u5145\u5e72\u71e5\u7684\u6c2e\u6c14\u6216\u6c29\u6c14\uff0c\u7ecf\u624b\u5957\u8fdb\u884c\u64cd\u4f5c\uff1b\u5de6\u4fa7\u7684\u5706\u7b52\n\u662f\u7269\u54c1\u8fdb\u51fa\u7bb1\u4f53\u7684\u8fc7\u6e21\u8231\u3002}\n=\n=\n\\section{\u65e0\u7a7a\u6c14\u64cd\u4f5c}\n=\n\\begin{definition}[\u7a7a\u6c14\u654f\u611f\u5316\u5408\u7269]\\label{def:b3:lab-techniques-3:air-sensitive}\n\u79f0\u80fd\u4e0e\u7a7a\u6c14\u4e2d\u7684\u6c27\u6c14\u6216\u6c34\u53cd\u5e94\u3001\u53d1\u751f\u5206\u89e3\u6216\u5931\u53bb\u6d3b\u6027\u7684\u5316\u5408\u7269\u4e3a\n\\emph{\u7a7a\u6c14\u654f\u611f\u5316\u5408\u7269}\\index{\u7a7a\u6c14\u654f\u611f\u5316\u5408\u7269}\u3002\n\u79f0\u5728\u7a7a\u6c14\u4e2d\u81ea\u53d1\u7740\u706b\u7684\u7269\u8d28\u4e3a\n\\emph{\u81ea\u71c3\u7269\u8d28}\\index{\u81ea\u71c3\u7269\u8d28}\u3002\n\\end{definition}\n=\n\\begin{definition}[\u5e0c\u5170\u514b\u7ebf\u4e0e\u624b\u5957\u7bb1]\\label{def:b3:lab-techniques-3:schlenk}\n\u79f0\\emph{\u5e0c\u5170\u514b\u7ebf}\\index{\u5e0c\u5170\u514b\u7ebf}\u4e3a\u53cc\u7ba1\u73bb\u7483\u6b67\u7ba1\uff0c\u4e00\u7ba1\u7ecf\u51b7\u9631\n\u4e0e\u771f\u7a7a\u6cf5\u76f8\u8fde\uff0c\u53e6\u4e00\u7ba1\u4e0e\u5e72\u71e5\u60f0\u6027\u6c14\u4f53\u6e90\u76f8\u8fde\uff0c\u7ecf\u6cb9\u6ce1\u653e\u7a7a\uff0c\n\u5e76\u4ee5\u65cb\u585e\u4f7f\u5404\u63a5\u53e3\u53ef\u4e0e\u5176\u4e2d\u4efb\u4e00\u7ba1\u76f8\u901a\u3002\n\\emph{\u5e0c\u5170\u514b\u74f6}\\index{\u5e0c\u5170\u514b\u74f6}\u5177\u6709\u4e00\u4e2a\u5e26\u65cb\u585e\u7684\u4fa7\u7ba1\uff0c\n\u7528\u4e8e\u4e0e\u7ebf\u8def\u76f8\u63a5\u3002\\emph{\u624b\u5957\u7bb1}\\index{\u624b\u5957\u7bb1}\u662f\u4e00\u79cd\u5bc6\u5c01\u7bb1\u4f53\uff0c\n\u5185\u5145\u60f0\u6027\u6c14\u4f53\u5e76\u6301\u7eed\u51c0\u5316\uff0c\u7bb1\u5185\u64cd\u4f5c\u501f\u52a9\n\u624b\u5957\u8fdb\u884c\u3002\n\\end{definition}\n=\n=\n=\n=\n=\n=\n=\n\\node[anchor=east] at (-1.0,3.0) {\u60f0\u6027\u6c14\u4f53};\n\\node[anchor=east] at (0,2.5) {\u771f\u7a7a};\n=\n=\n=\n=\n=\n=\n=\n=\n=\n=\n=\n\\node[anchor=west] at (5.4,0.4) {\u5e0c\u5170\u514b\u74f6};\n=\n=\n=\n\\node[anchor=west] at (9.4,2.2) {\u6cb9\u6ce1\u5668};\n=\n=\n=\n=\n\\node[anchor=north] at (0.4,0.2) {\u51b7\u9631};\n=\n=\n\\node at (2.1,0.9) {\u6cf5};\n=\n=\n=\n{\\small \u5e0c\u5170\u514b\u7ebf\u793a\u610f\u56fe\uff1a\u6c14\u4f53\u6b67\u7ba1\u4e0e\u771f\u7a7a\u6b67\u7ba1\u901a\u8fc7\u65cb\u585e\u76f8\u8fde\uff1b\n\u6bcf\u4e2a\u65cb\u585e\u4f7f\u5176\u6240\u63a5\u70e7\u74f6\u4e0e\u771f\u7a7a\u6216\u60f0\u6027\u6c14\u4f53\u76f8\u901a\u3002\u6eb6\u5242\u84b8\u6c14\n\u88ab\u62bd\u51fa\u540e\uff0c\u5728\u5230\u8fbe\u6cf5\u4e4b\u524d\u4e8e\u51b7\u9631\u4e2d\u51b7\u51dd\uff1b\u6c14\u4f53\u7ecf\u6cb9\u6ce1\u5668\u6392\u51fa\uff0c\n\u6cb9\u6ce1\u5668\u53ef\u963b\u6b62\u7a7a\u6c14\u5012\u6d41\u3002}\n=\n=\n\\begin{proposition}[\u62bd\u7a7a\u2013\u5145\u6c14\u5faa\u73af]\\label{prop:b3:lab-techniques-3:purge-cycles}\n\u82e5\u4e00\u4e2a\u5145\u6ee1\u538b\u5f3a\u4e3a $p_0$ \u7a7a\u6c14\u7684\u70e7\u74f6\uff0c\u88ab\u62bd\u81f3 $p_{\\min}$ \u540e\u5145\u5165\n\u7eaf\u60f0\u6027\u6c14\u4f53\uff0c\u5171\u91cd\u590d $n$ \u6b21\uff0c\u5219\u539f\u6709\u7a7a\u6c14\u7684\u6b8b\u7559\u6bd4\u4f8b\u4e3a $(p_{\\min}/p_0)^n$\u3002\n\\end{proposition}\n=\n\\begin{proof}\n\u62bd\u7a7a\u81f3 $p_{\\min}$ \u540e\uff0c\u5269\u4f59\u6c14\u4f53\u7684\u6bd4\u4f8b\u4e3a $p_{\\min}/p_0$\uff0c\u7ec4\u6210\u4e0d\u53d8\uff1b\n\u518d\u5145\u5165\u7eaf\u60f0\u6027\u6c14\u4f53\uff0c\u4f7f\u538b\u5f3a\u6062\u590d\u4e3a $p_0$\uff0c\u4e14\u4e0d\u5f15\u5165\u7a7a\u6c14\u3002\n\u6bcf\u4e00\u5faa\u73af\u4f7f\u7a7a\u6c14\u6bd4\u4f8b\u4e58\u4ee5 $p_{\\min}/p_0$\uff1b\u7ecf $n$ \u6b21\u5faa\u73af\u540e\uff0c\u4e3a $(p_{\\min}/p_0)^n$\u3002\n\\end{proof}\n=\n\u6309\u7406\u8bba\u8ba1\u7b97\uff0c\u4e09\u6b21\u5faa\u73af\u81f3 \\qty{0.1}{mbar} \u540e\u6b8b\u7559\u7a7a\u6c14\u4e3a $10^{-12}$\uff1b\u5b9e\u9645\u4e0a\uff0c\u6f0f\u6c14\u3001\n\u73bb\u7483\u8868\u9762\u5438\u9644\u7684\u6c14\u4f53\uff0c\u4ee5\u53ca\u771f\u7a7a\u8102\u548c\u9694\u819c\u7684\u653e\u6c14\uff0c\u51b3\u5b9a\u4e86\u5b9e\u9645\u6781\u9650\uff0c\n\u8fd9\u4e5f\u662f\u73bb\u7483\u4eea\u5668\u9700\u5728\u70d8\u7bb1\u4e2d\u70d8\u5e72\u5e76\u8d81\u70ed\u88c5\u914d\u7684\u539f\u56e0\u3002\n=\n\\begin{definition}[\u5957\u7ba1\u8f6c\u79fb]\\label{def:b3:lab-techniques-3:cannula}\n\\emph{\u5957\u7ba1\u8f6c\u79fb}\\index{\u5957\u7ba1\u8f6c\u79fb}\u662f\u6307\u501f\u52a9\u957f\u7684\u53cc\u5c16\u9488\u5934\uff0c\n\u5c06\u7a7a\u6c14\u654f\u611f\u7684\u6db2\u4f53\u4ece\u4e00\u4e2a\u5bc6\u5c01\u5bb9\u5668\u8f6c\u79fb\u81f3\u53e6\u4e00\u5bb9\u5668\uff0c\n\u8f6c\u79fb\u7684\u52a8\u529b\u4e3a\u7b2c\u4e00\u4e2a\u5bb9\u5668\u4e2d\u5c11\u91cf\u60f0\u6027\u6c14\u4f53\u7684\u8d85\u538b\u3002\n\\end{definition}\n=",
