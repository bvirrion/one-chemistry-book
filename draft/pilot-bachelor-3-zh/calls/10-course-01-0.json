 "result": "1| \\chapter{\u7edf\u8ba1\u70ed\u529b\u5b66\uff1a\u914d\u5206\u51fd\u6570}\\label{ch:b3:partition-functions}\n2|=\n3| \u7ef4\u4e5f\u7eb3\u7684\u73bb\u5c14\u5179\u66fc\u5893\u7891\u4e0a\u53ea\u523b\u7740\u4e00\u884c\u5b57\uff1a$S = k\\log W$\u3002\u7cfb\u7edf\u7684\u71b5\uff0c\u8ba1\u7b97\u7684\u662f\u5176\u5206\u5b50\u80fd\u591f\u5206\u4eab\u7cfb\u7edf\u80fd\u91cf\u7684\u65b9\u5f0f\u6570\u3002\n4| \u70ed\u529b\u5b66\u5728\u672c\u79d1\u4e00\u5e74\u7ea7\u548c\u4e8c\u5e74\u7ea7\u5206\u518c\u4e2d\u7684\u5efa\u7acb\u65b9\u5f0f\uff0c\u4ece\u672a\u6d89\u53ca\u5206\u5b50\uff1a\u5b83\u53ea\u628a\u53ef\u6d4b\u7684\u70ed\u91cf\u3001\u71b5\u548c\u5e73\u8861\u5e38\u6570\u5f7c\u6b64\u8054\u7cfb\u8d77\u6765\u3002\u7edf\u8ba1\u70ed\u529b\u5b66\u5219\u4ece\u5206\u5b50\u672c\u8eab\u51fa\u53d1\u8ba1\u7b97\u8fd9\u4e9b\u91cf\u3002\u5b83\u7684\u6838\u5fc3\u5bf9\u8c61\u662f\u5bf9\u5355\u4e2a\u5206\u5b50\u80fd\u7ea7\u6c42\u548c\u7684\u4e00\u4e2a\u5f0f\u5b50\uff0c\u5373\u914d\u5206\u51fd\u6570\uff1b\u80fd\u7ea7\u7531\u5149\u8c31\u5b66\u7ed9\u51fa\uff0c\u7531\u5149\u8c31\u8ba1\u7b97\u5f97\u5230\u7684\u6c2e\u6c14\u6807\u51c6\u71b5\uff0c\u4e0e\u8868\u5217\u503c\u5728\u6bcf\u5f00\u5c14\u6587\u6bcf\u6469\u5c14\u4e00\u767e\u5206\u4e4b\u4e00\u7126\u8033\u7684\u8303\u56f4\u5185\u4e00\u81f4\u3002\u672c\u7ae0\u5efa\u7acb\u914d\u5206\u51fd\u6570\uff0c\u5c06\u5176\u62c6\u5206\u4e3a\u5e73\u52a8\u3001\u8f6c\u52a8\u3001\u632f\u52a8\u548c\u7535\u5b50\u90e8\u5206\uff0c\u5e76\u7531\u6b64\u5f97\u5230\u5185\u80fd\u3001\u71b5\u548c\u5409\u5e03\u65af\u81ea\u7531\u80fd\uff1b\\cref{ch:b3:statistical-thermo-applied} \u5c06\u5176\u7528\u4e8e\u70ed\u5bb9\u4e0e\u5e73\u8861\u5e38\u6570\u3002\n5| \n6|=\n7| \\begin{recall}\n8| \u672c\u79d1\u4e8c\u5e74\u7ea7\u5206\u518c\u5b9a\u4e49\u4e86\u6807\u51c6\u6469\u5c14\u71b5\u3001\u5409\u5e03\u65af\u81ea\u7531\u80fd\u548c\u5316\u5b66\u52bf\uff0c\u5e76\u5217\u51fa\u4e86\u7531\u4f4e\u6e29\u70ed\u5bb9\u6c42\u5f97\u7684\u71b5\u503c\u3002\\Cref{ch:b3:quantum-model-systems} \u7ed9\u51fa\u4e86\u4e00\u7ef4\u52bf\u7bb1\u4e2d\u7c92\u5b50\u3001\u8c10\u632f\u5b50\u548c\u521a\u6027\u8f6c\u5b50\u7684\u80fd\u7ea7\uff0c$E_J = hcBJ(J+1)$\uff0c\u7b80\u5e76\u5ea6\u4e3a $2J + 1$\uff1b\\cref{ch:b3:rovibrational-spectroscopy} \u6d4b\u91cf\u4e86\u53cc\u539f\u5b50\u5206\u5b50\u7684 $B$ \u4e0e $\\tilde\\nu$\uff0c\u5e76\u53d1\u73b0\u5728 \\ce{N2} \u8fd9\u7c7b\u540c\u6838\u5206\u5b50\u4e2d\uff0c\u6838\u81ea\u65cb\u4f7f\u76f8\u90bb\u7684\u8f6c\u52a8\u80fd\u7ea7\u4e0d\u7b49\u4ef7\u3002\n9| \\end{recall}\n10| \n11| \\section{\u5fae\u89c2\u6001\u4e0e\u73bb\u5c14\u5179\u66fc\u5206\u5e03}\n12| \n13| \u8bbe $N$ \u4e2a\u76f8\u540c\u4e14\u76f8\u4e92\u72ec\u7acb\u7684\u5206\u5b50\u53ef\u5360\u636e\u80fd\u91cf\u4e3a $\\varepsilon_0 = 0 < \\varepsilon_1 < \\varepsilon_2 < \\dots$ \u7684\u80fd\u7ea7\uff0c\u603b\u80fd\u91cf\u4e3a $E$\u3002\u8bf4\u660e\u6bcf\u4e2a\u80fd\u7ea7\u4e0a\u6709\u591a\u5c11\u5206\u5b50\uff0c\u5373 $\\{n_0, n_1, \\dots\\}$\uff0c\u63cf\u8ff0\u7684\u662f\u4e00\u79cd\u5206\u5e03\uff1b\u8bf4\u660e\u54ea\u4e2a\u5206\u5b50\u5904\u4e8e\u54ea\u4e2a\u80fd\u7ea7\uff0c\u5219\u63cf\u8ff0\u5f97\u591a\u5f97\u591a\u3002\n14| \n15| \\begin{definition}[\u5fae\u89c2\u6001\uff0c\u7edf\u8ba1\u6743\u91cd]\\label{def:b3:partition-functions:microstate}\n16| \u5206\u5b50\u4f53\u7cfb\u7684\u4e00\u4e2a\\emph{\u5fae\u89c2\u6001}\\index{\u5fae\u89c2\u6001}\u662f\u5bf9\u6bcf\u4e2a\u5206\u5b50\u72b6\u6001\u7684\u5b8c\u6574\u6307\u5b9a\u3002\u5bf9\u4e8e $N$ \u4e2a\u5206\u5b50\u5728\u975e\u7b80\u5e76\u80fd\u7ea7\u4e0a\u7684\u5206\u5e03 $\\{n_i\\}$\uff0c\u5176\\emph{\u7edf\u8ba1\u6743\u91cd}\\index{\u7edf\u8ba1\u6743\u91cd} $W$ \u662f\u5b9e\u73b0\u8be5\u5206\u5e03\u7684\u5fae\u89c2\u6001\u6570\u76ee\uff1a\n17| \\[\n18|   W = \\frac{N!}{n_0!\\,n_1!\\,n_2!\\cdots}.\n19| \\]\n20| \\end{definition}\n21| \n22| \\begin{example}[\u4e09\u4e2a\u632f\u5b50\u5171\u4eab\u4e09\u4e2a\u91cf\u5b50]\\label{ex:b3:partition-functions:three-quanta}\n23| \u4e09\u4e2a\u632f\u5b50\u5171\u4eab\u4e09\u4e2a\u80fd\u91cf\u91cf\u5b50\u3002\u5206\u5e03\u201c\u4e00\u4e2a\u632f\u5b50\u5360\u6709\u5168\u90e8\u4e09\u4e2a\u91cf\u5b50\u201d\u53ef\u4ee5\u7528 $3!/(1!\\,2!) = 3$ \u79cd\u65b9\u5f0f\u5b9e\u73b0\uff0c\u201c\u4e00\u4e2a\u632f\u5b50\u5360\u6709\u4e24\u4e2a\uff0c\u53e6\u4e00\u4e2a\u5360\u6709\u4e00\u4e2a\u201d\u6709 $3! = 6$ \u79cd\u65b9\u5f0f\uff0c\u201c\u6bcf\u4e2a\u632f\u5b50\u5404\u5360\u4e00\u4e2a\u201d\u53ea\u6709\u4e00\u79cd\u65b9\u5f0f\uff1a\u5171\u8ba1\u5341\u4e2a\u5fae\u89c2\u6001\u3002\u5728\u4ecd\u4f7f\u80fd\u91cf\u5206\u5e03\u4e8e\u82e5\u5e72\u80fd\u7ea7\u4e0a\u7684\u5206\u5e03\u4e2d\uff0c\u6700\u5747\u5300\u7684\u90a3\u4e2a\u6700\u53ef\u80fd\u51fa\u73b0\u3002\u5bf9\u4e8e $10^{23}$ \u4e2a\u5206\u5b50\uff0c\u6743\u91cd\u53d8\u5f97\u6781\u4e3a\u5c16\u9510\uff0c\u4ee5\u81f3\u4e8e\u8fd9\u4e00\u5206\u5e03\u4ee5\u53ca\u4e0e\u4e4b\u53ea\u76f8\u5dee\u53ef\u5ffd\u7565\u91cf\u7684\u5206\u5e03\uff0c\u51e0\u4e4e\u5360\u636e\u4e86\u5168\u90e8\u5fae\u89c2\u6001\u3002\n23| \\end{example}\n24| \n25| \\begin{remark}\n26| \u7edf\u8ba1\u70ed\u529b\u5b66\u7684\u57fa\u672c\u5047\u8bbe\u662f\uff1a\u5b64\u7acb\u4f53\u7cfb\u5728\u7ed9\u5b9a\u80fd\u91cf\u4e0b\u7684\u6240\u6709\u5fae\u89c2\u6001\u7b49\u6982\u7387\u3002\u4e8e\u662f\uff0c\u4f53\u7cfb\u51e0\u4e4e\u603b\u662f\u5904\u4e8e\u6743\u91cd\u6700\u5927\u7684\u90a3\u4e2a\u5206\u5e03\u4e4b\u4e2d\uff1b\u6c42\u51fa\u5b83\uff0c\u6b63\u662f\u672c\u8282\u7684\u4efb\u52a1\u3002\n27| \\end{remark}\n28| \n29| \u5bf9\u4e8e\u5927\u6570\uff0c\u65af\u7279\u6797\u8fd1\u4f3c $\\ln x! \\approx x\\ln x - x$ \u7ed9\u51fa\n30| \\[\n31|   \\ln W = N\\ln N - \\sum_i n_i\\ln n_i .\n32| \\]\n33| \n34| \\begin{definition}[\u73bb\u5c14\u5179\u66fc\u5206\u5e03\uff0c\u5e03\u5c45\u6570]\\label{def:b3:partition-functions:boltzmann}\n35| \u80fd\u7ea7\u7684\\emph{\u5e03\u5c45\u6570}\\index{\u5e03\u5c45\u6570} $n_i/N$ \u662f\u5360\u636e\u8be5\u80fd\u7ea7\u7684\u5206\u5b50\u6240\u5360\u7684\u6bd4\u4f8b\u3002\\emph{\u73bb\u5c14\u5179\u66fc\u5206\u5e03}\\index{\u73bb\u5c14\u5179\u66fc\u5206\u5e03}\u662f\u6e29\u5ea6\u4e3a $T$ \u7684\u70ed\u5e73\u8861\u72b6\u6001\u4e0b\uff0c\u72ec\u7acb\u5206\u5b50\u5177\u6709\u6700\u5927\u6743\u91cd\u7684\u5206\u5e03\uff0c\u7531\u4e0b\u9762\u7684\u5b9a\u7406\u7ed9\u51fa\u3002\n36| \\end{definition}\n37| \n38| \\begin{theorem}[\u73bb\u5c14\u5179\u66fc\u5206\u5e03]\\label{thm:b3:partition-functions:boltzmann}\n39| \u5bf9\u4e8e\u6e29\u5ea6\u4e3a $T$ \u7684\u70ed\u5e73\u8861\u4e0b\u7684\u72ec\u7acb\u5206\u5b50\uff0c\u80fd\u91cf\u4e3a $\\varepsilon_i$\u3001\u7b80\u5e76\u5ea6\u4e3a $g_i$ \u7684\u80fd\u7ea7\u4e0a\u7684\u5e03\u5c45\u6570\u4e3a\n40| \\[\n41|   \\frac{n_i}{N} = \\frac{g_i\\eu^{-\\varepsilon_i/kT}}{q},\n42|   \\qquad q = \\sum_i g_i\\eu^{-\\varepsilon_i/kT},\n43| \\]\n44| \u5176\u4e2d $k$ \u4e3a\u73bb\u5c14\u5179\u66fc\u5e38\u6570\u3002\u4e24\u80fd\u7ea7\u7684\u5e03\u5c45\u6570\u4e4b\u6bd4\u4e3a\n45| $\\frac{n_j}{n_i} = \\frac{g_j}{g_i}\\eu^{-(\\varepsilon_j - \\varepsilon_i)/kT}$\u3002\n46| \\end{theorem}\n47| \n48| \\begin{proof}[\u90e8\u5206\u8bc1\u660e]\n49| \u5148\u8003\u8651\u975e\u7b80\u5e76\u80fd\u7ea7\u3002\u5728\u7ea6\u675f $\\sum_in_i = N$ \u548c $\\sum_in_i\\varepsilon_i = E$ \u4e0b\uff0c\u7528\u62c9\u683c\u6717\u65e5\u4e58\u5b50 $\\alpha$ \u548c $\\beta$ \u5bf9 $\\ln W$ \u6c42\u6781\u5927\uff1a\u5bf9\u6bcf\u4e2a $i$\uff0c\n50| \\[\n51|   \\frac{\\partial}{\\partial n_i}\\Bigl(\\ln W + \\alpha\\sum_jn_j - \\beta\\sum_jn_j\\varepsilon_j\\Bigr)\n52|   = -\\ln n_i - 1 + \\alpha - \\beta\\varepsilon_i = 0,\n53| \\]\n54| \u4e8e\u662f $n_i = \\eu^{\\alpha - 1}\\eu^{-\\beta\\varepsilon_i}$\uff0c\u7531\u7b2c\u4e00\u4e2a\u7ea6\u675f\u5f97 $\\eu^{\\alpha - 1}\n55| = N/\\sum_j\\eu^{-\\beta\\varepsilon_j}$\u3002\u7b80\u5e76\u5ea6\u4e3a $g_i$ \u7684\u80fd\u7ea7\u5305\u542b $g_i$ \u4e2a\u80fd\u91cf\u76f8\u540c\u7684\u4e0d\u540c\u72b6\u6001\uff0c\u6bcf\u4e2a\u72b6\u6001\u7684\u5e03\u5c45\u6570\u5982\u4e0a\u5f0f\u6240\u793a\uff0c\u56e0\u6b64\u5176\u5e03\u5c45\u6570\u4e58\u4ee5 $g_i$\u3002\u4e58\u5b50 $\\beta$ \u7531\u4e00\u4e2a\u5df2\u77e5\u60c5\u5f62\u786e\u5b9a\uff1a\u5bf9\u4e8e\u7406\u60f3\u6c14\u4f53\u7684\u5e73\u52a8\uff08\u89c1\u4e0b\u6587\\cref{prop:b3:partition-functions:q-trans}\uff09\uff0c\u8be5\u5206\u5e03\u7ed9\u51fa\u80fd\u91cf $\\frac32N/\\beta$\uff0c\u800c\u7406\u60f3\u6c14\u4f53\u7684\u80fd\u91cf\u4e3a $\\frac32NkT$\uff0c\u4e8e\u662f $\\beta = 1/kT$\u3002\u5bf9\u6240\u6709\u8fd0\u52a8\u5f62\u5f0f\uff0c$\\beta$ \u90fd\u662f\u540c\u4e00\u4e2a\u91cf\uff1b\u5b83\u5c31\u662f\u70ed\u529b\u5b66\u6e29\u5ea6\uff0c\u8fd9\u4e00\u70b9\u5728\u6b64\u4e88\u4ee5\u627f\u8ba4\uff1a\u4e24\u4e2a\u5904\u4e8e\u70ed\u63a5\u89e6\u7684\u4f53\u7cfb\u5177\u6709\u76f8\u540c\u7684 $\\beta$\uff0c\u8fd9\u6b63\u662f\u6e29\u5ea6\u7684\u5b9a\u4e49\u6027\u8d28\u3002\n56| \\end{proof}\n57| \n58| \\begin{definition}[\u5206\u5b50\u914d\u5206\u51fd\u6570]\\label{def:b3:partition-functions:partition-function}\n59| \u6e29\u5ea6\u4e3a $T$ \u65f6\uff0c\u5206\u5b50\u7684\\emph{\u5206\u5b50\u914d\u5206\u51fd\u6570}\\index{\u5206\u5b50\u914d\u5206\u51fd\u6570}\u4e3a\u6c42\u548c\n60| \\[\n61|   q = \\sum_{\\text{levels}}g_i\\eu^{-\\varepsilon_i/kT} = \\sum_{\\text{states}}\\eu^{-\\varepsilon_s/kT},\n62| \\]\n63| \u80fd\u91cf\u4ece\u6700\u4f4e\u80fd\u7ea7\u7b97\u8d77\uff0c\u56e0\u6b64 $q \\ge 1$\u3002\n64| \\end{definition}\n65|=",
