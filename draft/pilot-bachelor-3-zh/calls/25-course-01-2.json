 "result": "1| \\chapter{\u8d85\u5206\u5b50\u5316\u5b66}\\label{ch:b3:supramolecular}\n2|=\n3| 1962 \u5e74\uff0c\u67e5\u5c14\u65af\u00b7\u4f69\u5fb7\u68ee\u5728\u5bfb\u627e\u522b\u7684\u4e1c\u897f\u65f6\u5206\u79bb\u51fa\u4e00\u79cd\u73af\u72b6\u805a\u919a\uff0c\n4| \u5b83\u80fd\u5c06\u9ad8\u9530\u9178\u94be\u6eb6\u4e8e\u82ef\u4e2d\uff0c\u5e76\u4f7f\u6eb6\u6db2\u53d8\u6210\u7d2b\u8272\u3002\u6b64\u73af\n5| \u5df2\u5305\u88f9\u4f4f\u94be\u79bb\u5b50\uff0c\u628a\u5b83\u7684\u7535\u8377\u9690\u85cf\u4e8e\u70c3\u7c7b\u8868\u9762\u4e4b\u4e0b\uff0c\n6| \u5e76\u628a\u9ad8\u9530\u9178\u6839\u4f5c\u4e3a\u6297\u8861\u79bb\u5b50\u4e00\u540c\u5e26\u5165\u82ef\u4e2d\u3002\n7| \u8d85\u8d8a\u5355\u4e2a\u5206\u5b50\u7684\u5316\u5b66\uff0c\u5373\u7531\u6bd4\u5171\u4ef7\u952e\u5f31\u7684\u4f5c\u7528\u529b\n8| \u7ed3\u5408\u800c\u6210\u7684\u7ec4\u88c5\u4f53\u7684\u5316\u5b66\uff0c\u6b63\u662f\u4ece\u8fd9\u4e00\u7247\u7d2b\u8272\u6eb6\u6db2\u5f00\u59cb\u7684\u3002\n9| \u672c\u7ae0\u8ba8\u8bba\u8fd9\u4e9b\u4f5c\u7528\u529b\uff0c\n10| \u89e3\u91ca\u67d0\u4e9b\u4e3b\u4f53\u4e3a\u4f55\u80fd\u5982\u6b64\u7cbe\u51c6\u5730\u6311\u9009\u5ba2\u4f53\uff0c\u8bf4\u660e\u7ed3\u5408\u5e38\u6570\u5982\u4f55\u6d4b\u5b9a\uff0c\n11| \u6700\u540e\u4ee5\u5206\u5b50\u88ab\u7a7f\u7ebf\u3001\u4e92\u9501\u6210\u673a\u5668\u4f5c\u7ed3\u3002\n12|=\n13|=\n14| \u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u8ba8\u8bba\u4e86\u5206\u5b50\u95f4\u4f5c\u7528\u529b\u3001\u6c22\u952e\u3001\u6eb6\u5242\u5316\u3001\n15| \u758f\u6c34\u5206\u5b50\u3001\u914d\u5408\u7269\u3001\u751f\u6210\u5e38\u6570\u548c\u87af\u5408\u7269\uff1b\u672c\u79d1\u4e8c\u5e74\u7ea7\u5206\u518c\u8ba8\u8bba\u4e86\n16| \u5316\u5b66\u52bf\u3001\u5409\u5e03\u65af\u81ea\u7531\u80fd\u548c\u6700\u5c0f\u4e8c\u4e58\u62df\u5408\u3002\n17| \\cref{ch:b3:advanced-nmr}\u4ecb\u7ecd\u4e86\u5feb\u901f\u4ea4\u6362\u3001\u6162\u901f\u4ea4\u6362\u548c\u5408\u5e76\u73b0\u8c61\uff0c\n18| \\cref{ch:b3:rate-theories}\u4ecb\u7ecd\u4e86\u827e\u6797\u65b9\u7a0b\uff0c\u4ee5\u53ca\n19| \\cref{ch:b3:partition-functions}\u4ecb\u7ecd\u4e86\u6c14\u4f53\u7684\u5e73\u52a8\u71b5\u3002\n20|=\n21|=\n22| \\section{\u975e\u5171\u4ef7\u76f8\u4e92\u4f5c\u7528}\n23|=\n24| \\begin{definition}[\u8d85\u5206\u5b50\u5316\u5b66]\\label{def:b3:supramolecular:supramolecular}\n25| \\emph{\u8d85\u5206\u5b50\u5316\u5b66}\\index{\u8d85\u5206\u5b50\u5316\u5b66}\u662f\u7814\u7a76\u7531\u975e\u5171\u4ef7\u76f8\u4e92\u4f5c\u7528\u7ed3\u5408\u5728\u4e00\u8d77\u7684\u5206\u5b50\u7ec4\u88c5\u4f53\u7684\n26| \u5316\u5b66\u3002\u5728\\emph{\u4e3b\u5ba2\u4f53\u914d\u5408\u7269}\\index{\u4e3b\u5ba2\u4f53\u914d\u5408\u7269}\u4e2d\uff0c\n27| \\emph{\u4e3b\u4f53}\\index{\u4e3b\u4f53}\u662f\u8f83\u5927\u7684\u5206\u5b50\uff0c\u5e26\u6709\u7a7a\u8154\u6216\u88c2\u7f1d\uff0c\n28| \u7ed3\u5408\u4f4d\u70b9\u6c47\u805a\u5176\u4e0a\uff0c\\emph{\u5ba2\u4f53}\\index{\u5ba2\u4f53}\u662f\u5b83\u6240\u7ed3\u5408\u7684\n29| \u8f83\u5c0f\u5206\u5b50\u6216\u79bb\u5b50\u3002\n30|=\n31|=\n32| \u8fd9\u4e9b\u76f8\u4e92\u4f5c\u7528\u5373\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u4e2d\u7684\u79bb\u5b50\u2013\u5076\u6781\u3001\u5076\u6781\u2013\u5076\u6781\u3001\n33| \u6c22\u952e\u548c\u4f26\u6566\u529b\uff0c\u5916\u52a0\u51e0\u79cd\u6709\u4e13\u95e8\u540d\u79f0\u7684\u4f5c\u7528\u3002\n34|=\n35| \\begin{definition}[\u975e\u5171\u4ef7\u76f8\u4e92\u4f5c\u7528]\\label{def:b3:supramolecular:interactions}\n36| \\emph{$\\pi$ \u5806\u79ef}\\index{$\\pi$ \u5806\u79ef}\u662f\u5e73\u9762\u82b3\u9999\u73af\u4e4b\u95f4\u7684\n37| \u9762\u5bf9\u9762\u6392\u5217\uff08\u901a\u5e38\u9519\u5f00\u6216\u503e\u659c\uff09\u7684\u5438\u5f15\u4f5c\u7528\u3002\\emph{\u9633\u79bb\u5b50\u2013$\\pi$\n38| \u76f8\u4e92\u4f5c\u7528}\\index{\u9633\u79bb\u5b50\u2013$\\pi$ \u76f8\u4e92\u4f5c\u7528}\u662f\u9633\u79bb\u5b50\u4e0e\u82b3\u9999\u73af\n39| \u5bcc\u7535\u5b50\u9762\u4e4b\u95f4\u7684\u5438\u5f15\u4f5c\u7528\u3002\\emph{\u5364\u952e}\\index{\u5364\u952e}\u662f\u5171\u4ef7\u7ed3\u5408\u7684\n40| \u5364\u539f\u5b50\u4e0a\u4e0e\u5176\u952e\u76f8\u5bf9\u7684\u7f3a\u7535\u5b50\u7aef\u4e0e\n41| \u8def\u6613\u65af\u78b1\u4e4b\u95f4\u7684\u5438\u5f15\u4f5c\u7528\u3002\\emph{\u758f\u6c34\n42| \u6548\u5e94}\\index{\u758f\u6c34\u6548\u5e94}\u662f\u975e\u6781\u6027\u8868\u9762\u5728\u6c34\u4e2d\u805a\u96c6\u5230\u4e00\u8d77\u7684\n43| \u8d8b\u52bf\uff0c\u4e3b\u8981\u9a71\u52a8\u529b\u662f\u975e\u6781\u6027\u8868\u9762\u5468\u56f4\u6709\u5e8f\u6c34\u5206\u5b50\u7684\n44| \u91ca\u653e\u3002\n45| \\end{definition}\n46|=\n47| \u79bb\u5b50\u2013\u5076\u6781\u4e0e\u9633\u79bb\u5b50\u2013$\\pi$ \u76f8\u4e92\u4f5c\u7528\u6700\u5f3a\uff0c\u5f88\u5927\u7a0b\u5ea6\u4e0a\u53d6\u51b3\u4e8e\u4e0e\u79bb\u5b50\u7ade\u4e89\u7684\n48| \u6eb6\u5242\uff1b\u6c22\u952e\u6b21\u4e4b\uff0c\n49| \u5176\u540e\u662f $\\pi$ \u5806\u79ef\u4e0e\u5364\u952e\uff0c\u518d\u5176\u540e\u662f\u4f26\u6566\u529b\u3002\u4f26\u6566\u529b\u5355\u4e2a\u90fd\u5f88\u5f31\uff0c\n50| \u4f46\u5728\u5927\u63a5\u89e6\u9762\u4e0a\u7d2f\u52a0\u8d77\u6765\u4fbf\u4e0d\u5bb9\u5ffd\u89c6\u3002\u5728\u6c34\u4e2d\uff0c\u758f\u6c34\u6548\u5e94\u5f80\u5f80\u5360\u4e3b\u5bfc\uff1a\n51| \u82e5\u67d0\u4e3b\u4f53\u8bbe\u8ba1\u4e3a\u5728\u6c2f\u4eff\u4e2d\u9760\u6c22\u952e\u7ed3\u5408\u5ba2\u4f53\uff0c\u5b83\u5728\u6c34\u4e2d\u53ef\u80fd\n52| \u6839\u672c\u65e0\u6cd5\u7ed3\u5408\u8be5\u5ba2\u4f53\uff0c\u56e0\u4e3a\u6c34\u81ea\u8eab\u7684\u6c22\u952e\u4f1a\u4e0e\u4e4b\u7ade\u4e89\u3002\n53|=\n54| \\section{\u5206\u5b50\u8bc6\u522b}\n55|=\n56| \\begin{definition}[\u5206\u5b50\u8bc6\u522b]\\label{def:b3:supramolecular:recognition}\n57| \\emph{\u5206\u5b50\u8bc6\u522b}\\index{\u5206\u5b50\u8bc6\u522b}\u662f\u4e3b\u4f53\u5bf9\u5ba2\u4f53\u7684\u9009\u62e9\u6027\n58| \u7ed3\u5408\u3002\u5b83\u4f9d\u8d56\u4e8e\\emph{\u4e92\u8865\u6027}\\index{\u4e92\u8865\u6027}\uff0c\n59| \u5373\u4e3b\u5ba2\u4f53\u5728\u5c3a\u5bf8\u3001\u5f62\u72b6\u548c\u7ed3\u5408\u4f4d\u70b9\u4e0a\u7684\u5339\u914d\uff0c\n60| \u5e76\u901a\u8fc7\\emph{\u9884\u7ec4\u7ec7}\\index{\u9884\u7ec4\u7ec7}\u5f97\u5230\u52a0\u5f3a\uff0c\u5373\u4e3b\u4f53\u7684\u7ed3\u5408\u4f4d\u70b9\n61| \u5728\u7ed3\u5408\u4e4b\u524d\u5c31\u5df2\u4fdd\u6301\u5728\u914d\u5408\u7269\u6240\u9700\u7684\u51e0\u4f55\u6784\u578b\u4e2d\u3002\n62|=\n63|=\n64| \u7ed3\u5408\u5e38\u6570 $K_a = [\\mathrm{HG}]/([\\mathrm H][\\mathrm G])$ \u5728\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u7684\n65| \u610f\u4e49\u4e0a\u5373\u4e3a\u751f\u6210\u5e38\u6570\uff0c\u5e76\u4e14 $\\Delta G^\\circ = -RT\\ln K_a$\u3002\u67d4\u6027\u4e3b\u4f53\u5728\u7ed3\u5408\u65f6\u5fc5\u987b\u51bb\u7ed3\u5176\n66| \u6784\u8c61\uff0c\u8fd9\u8981\u4ed8\u51fa\u71b5\u7684\u4ee3\u4ef7\uff1b\u521a\u6027\u3001\u5df2\u9884\u7ec4\u7ec7\u7684\u4e3b\u4f53\n67| \u5219\u5df2\u5728\u5408\u6210\u65f6\u4ed8\u51fa\u4e86\u8fd9\u4e00\u4ee3\u4ef7\u3002\n68|=\n69| \\begin{definition}[\u87af\u5408\u6548\u5e94\u4e0e\u5927\u73af\u6548\u5e94]\\label{def:b3:supramolecular:macrocyclic}\n70| \\emph{\u87af\u5408\u6548\u5e94}\\index{\u87af\u5408\u6548\u5e94}\u662f\u6307\uff1a\u542b\u591a\u9f7f\u914d\u4f53\u7684\u914d\u5408\u7269\n71| \u6bd4\u542b\u76f8\u540c\u4f9b\u4f53\u539f\u5b50\u3001\u6570\u76ee\u76f8\u5f53\u7684\u5355\u9f7f\u914d\u4f53\u7684\u914d\u5408\u7269\u66f4\u7a33\u5b9a\u3002\n72| \\emph{\u5927\u73af\n73| \u6548\u5e94}\\index{\u5927\u73af\u6548\u5e94}\u662f\u6307\uff1a\u5f53\n74| \u591a\u9f7f\u914d\u4f53\u4e3a\u73af\u72b6\u800c\u975e\u5f00\u94fe\u65f6\uff0c\u6240\u5f97\u5230\u7684\u8fdb\u4e00\u6b65\u7a33\u5b9a\u5316\u3002\n75| \\end{definition}\n76|=\n77| \\begin{proposition}[\u87af\u5408\u6548\u5e94\u4e3b\u8981\u662f\u71b5\u6548\u5e94]\\label{prop:b3:supramolecular:chelate-entropy}\n78| \u5728 $\\mathrm{[M(NH_3)_6]^{2+} + 3\\,en \\rightleftharpoons [M(en)_3]^{2+} + 6\\,NH_3}$ \u4e2d\uff0cen \u4e3a\u4e59\u70f7-1,2-\u4e8c\u80fa\uff0c\n79| \u53cd\u5e94\u4e24\u4fa7\u5b58\u5728\u76f8\u540c\u7684\u516d\u4e2a\u91d1\u5c5e\u2013\u6c2e\u952e\uff0c\u53cd\u5e94\u7684\u9a71\u52a8\u529b\u662f\n80| \u81ea\u7531\u5206\u5b50\u6570\u76ee\u7684\u589e\u52a0\u3002\n81| \\end{proposition}\n82|=\n83| \\begin{proof}[\u8bba\u8bc1]\n84| \u5f62\u6210\u548c\u65ad\u88c2\u7684\u952e\u5c5e\u4e8e\u540c\u4e00\u7c7b\uff0c\u56e0\u6b64 $\\Delta_rH^\\circ$ \u5f88\u5c0f\u3002\u72ec\u7acb\u5206\u5b50\u7684\n85| \u6570\u76ee\u7531\u56db\u4e2a\u589e\u81f3\u4e03\u4e2a\uff1a\u6574\u4f53\u5206\u5b50\u591a\u51fa\u4e09\u4e2a\u5e73\u52a8\u81ea\u7531\u5ea6\uff0c\n86| \u6bcf\u4e2a\u5728\u6eb6\u6db2\u4e2d\u6bcf\u5f00\u5c14\u6587\u6bcf\u6469\u5c14\u53ef\u8d21\u732e\u6570\u5341\u7126\u8033\u7684\u71b5\n87| \uff08\\cref{ch:b3:partition-functions}\uff09\uff0c\u56e0\u6b64 $\\Delta_rS^\\circ > 0$ \u4e14 $K > 1$\u3002\n88| \u4ece\u52a8\u529b\u5b66\u89d2\u5ea6\u770b\uff0c\u87af\u5408\u914d\u4f53\u7684\u4e00\u7aef\u4e00\u65e6\u7ed3\u5408\uff0c\u53e6\u4e00\u7aef\u5c31\u88ab\u4ee5\u5f88\u9ad8\u7684\u6709\u6548\u6d53\u5ea6\u4fdd\u6301\u5728\n89| \u91d1\u5c5e\u9644\u8fd1\uff0c\u82e5\u5b83\u677e\u5f00\u4fbf\u7acb\u5373\u7ed3\u5408\u3002\n90| \\end{proof}\n91|=\n92| \\begin{proposition}[\u7113\u2013\u71b5\u8865\u507f]\\label{prop:b3:supramolecular:compensation}\n93| \u5728\u4e00\u7cfb\u5217\u76f8\u5173\u7684\u4e3b\u5ba2\u4f53\u914d\u5408\u7269\u4e2d\uff0c\u7ed3\u5408\u65f6\u8f83\u8d1f\u7684 $\\Delta H^\\circ$\n94| \u901a\u5e38\u4f34\u968f\u8f83\u8d1f\u7684 $\\Delta S^\\circ$\uff0c\u56e0\u6b64 $\\Delta G^\\circ$ \u7684\u53d8\u5316\u5c0f\u4e8e\u5176\u4e2d\u4efb\u4e00\u9879\u7684\u53d8\u5316\uff08\n95| \u8fd9\u662f\u4e00\u4e2a\u5b9e\u9a8c\u89c2\u5bdf\u7ed3\u679c\uff09\u3002\n96|=\n97|=\n98| \u7ed3\u5408\u66f4\u7d27\u7684\u914d\u5408\u7269\u7ed3\u5408\u5f97\u66f4\u5f3a\uff0c\u4f46\u4e5f\u66f4\u591a\u5730\u9650\u5236\u4e86\u4e3b\u4f53\u548c\u5ba2\u4f53\u7684\n99| \u8fd0\u52a8\uff1b\u4e0e\u5ba2\u4f53\u5f62\u6210\u7684\u66f4\u5f3a\u6c22\u952e\uff0c\u5f80\u5f80\u610f\u5473\u7740\u4e0e\u88ab\u5b83\u53d6\u4ee3\u7684\u6c34\u4e4b\u95f4\u7684\n100| \u6c22\u952e\u53d8\u5f31\u3002\u51b3\u5b9a\u9009\u62e9\u6027\u7684\u5409\u5e03\u65af\u81ea\u7531\u80fd\uff0c\u662f\u4e24\u4e2a\u592