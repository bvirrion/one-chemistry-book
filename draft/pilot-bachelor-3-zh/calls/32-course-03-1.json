tion}\n276| \\begin{enumerate}\n277|   \\item \u5217\u51fa\u5b58\u5728\u7684\u914d\u4f53\uff08\u6c22\u6c27\u6839\u3001\u78b3\u9178\u6839\u3001\u6c2f\u79bb\u5b50\u3001\u786b\u9178\u6839\u3001\u6709\u673a\n278|         \u7269\uff09\u53ca\u5176\u6d53\u5ea6\u548c pH\u3002\n279|   \\item \u5199\u51fa\u914d\u5408\u5e38\u6570\u4e0e\u91d1\u5c5e\u7684\u8d28\u91cf\u5b88\u6052\u5f0f\uff0c\n280|         \u5982\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u4e2d\u6240\u8ff0\u3002\n281|   \\item \u6c42\u51fa\u6e38\u79bb\u91d1\u5c5e\u79bb\u5b50\uff0c\u518d\u9010\u4e00\u6c42\u51fa\u5404\u914d\u5408\u7269\uff1b\n282|         \u4f5c\u51fa\u5404\u5f62\u6001\u5206\u6570\u968f pH \u6216\u914d\u4f53\u6d53\u5ea6\u53d8\u5316\u7684\u56fe\u3002\n283|   \\item \u5c06\u6709\u6bd2\u6216\u53ef\u751f\u7269\u5229\u7528\u7684\u5f62\u6001\uff08\u901a\u5e38\u4e3a\u6e38\u79bb\u79bb\u5b50\uff09\u4e0e\u603b\u6d53\u5ea6\u8fdb\u884c\u6bd4\u8f83\u3002\n284| \\end{enumerate}\n285| \\end{method}\n286|=\n287| \\section{\u571f\u58e4\u4e0e\u6c89\u79ef\u7269}\n288|=\n289| \\begin{definition}[\u571f\u58e4\u4e2d\u7684\u5438\u9644]\\label{def:b3:environmental-toxicology:soil}\n290| \u79f0\u571f\u58e4\u7684\\emph{\u9633\u79bb\u5b50\u4ea4\u6362\u5bb9\u91cf}\\index{\u9633\u79bb\u5b50\u4ea4\u6362\u5bb9\u91cf}\u4e3a\n291| \u5355\u4f4d\u8d28\u91cf\u571f\u58e4\u6240\u80fd\u4fdd\u6301\u7684\u53ef\u4ea4\u6362\u9633\u79bb\u5b50\u7684\u91cf\uff0c\u8fd9\u4e9b\u9633\u79bb\u5b50\n292| \u5438\u9644\u4e8e\u9ecf\u571f\u548c\u6709\u673a\u8d28\u4e0a\u3002\\emph{\u571f\u2013\u6c34\u5206\u914d\u7cfb\u6570}\\index{\u571f\u2013\u6c34\u5206\u914d\u7cfb\u6570}\n293| $K_d$ \u4e3a\u5438\u9644\u5728\u571f\u58e4\u4e0a\u7684\u67d0\u7269\u8d28\u6d53\u5ea6\uff08\u6bcf\u5343\u514b\uff09\n294| \u4e0e\u5176\u5728\u5b54\u9699\u6c34\u4e2d\u6d53\u5ea6\uff08\u6bcf\u5347\uff09\u4e4b\u6bd4\uff1b\n295| \\emph{\u6709\u673a\u78b3\u5206\u914d\u7cfb\u6570}\\index{\u6709\u673a\u78b3\u5206\u914d\u7cfb\u6570}\u4e3a\n296| $K_{oc} = K_d/f_{oc}$\uff0c\u5176\u4e2d $f_{oc}$ \u4e3a\u6709\u673a\u78b3\u7684\u8d28\u91cf\u5206\u6570\u3002\n297| \\end{definition}\n298|=\n299| \u4e2d\u6027\u6709\u673a\u5316\u5408\u7269\u4e3b\u8981\u5438\u9644\u5728\u571f\u58e4\u6709\u673a\u8d28\u4e0a\uff0c\u56e0\u6b64 $K_{oc}$ \u968f\u571f\u58e4\u4e0d\u540c\u800c\n300| \u53d8\u5316\u8fdc\u5c0f\u4e8e $K_d$\u3002$K_d$ \u8f83\u5c0f\u7684\u5316\u5408\u7269\u968f\u6c34\u8fc1\u79fb\uff0c\n301| \u53ef\u80fd\u5230\u8fbe\u5730\u4e0b\u6c34\uff08\u6dcb\u6eb6\uff09\uff1b$K_d$ \u8f83\u5927\u7684\u5316\u5408\u7269\u5219\u7559\u5728\u8868\u5c42\u9644\u8fd1\uff0c\n302| \u4e0e\u9897\u7c92\u7ed3\u5408\uff0c\u8fd9\u4e9b\u9897\u7c92\u53ef\u80fd\u88ab\u4fb5\u8680\u5e26\u5165\u6cb3\u6d41\u548c\u6e56\u6cca\u3002\n303|=\n304| \\section{\u6c61\u67d3\u7269\u7684\u5f52\u5bbf}\n305|=\n306| \\begin{definition}[\u8f9b\u9187\u2013\u6c34\u5206\u914d\u7cfb\u6570]\\label{def:b3:environmental-toxicology:kow}\n307| \u79f0\u67d0\u7269\u8d28\u7684\\emph{\u8f9b\u9187\u2013\u6c34\u5206\u914d\u7cfb\u6570}\\index{\u8f9b\u9187\u2013\u6c34\u5206\u914d\u7cfb\u6570}\n308| $K_{ow}$ \u4e3a\u5176\u5728\u8f9b-1-\u9187\u548c\u6c34\u4e2d\u7684\u5e73\u8861\u6d53\u5ea6\u4e4b\u6bd4\uff0c\n309| \u5b83\u8868\u5f81\u8be5\u7269\u8d28\u5bf9\u8102\u80aa\u7ec4\u7ec7\u548c\u6709\u673a\n310| \u7269\u7684\u4eb2\u548c\u529b\u3002\n311| \\end{definition}\n312|=\n313|=\n314| \u82ef\u7684 $\\log K_{ow} = 2.13$\uff0c\u9664\u8349\u5242\u963f\u7279\u62c9\u6d25\u4e3a 2.61\uff0c\u516d\u6c2f\u4ee3\u591a\u6c2f\u8054\u82ef\u4e3a 6.67\uff0c\n315| \u6ef4\u6ef4\u6d95\u4e3a 6.91\uff1a\u540e\u4e24\u8005\u5728\u8102\u80aa\u4e2d\u7684\u6eb6\u89e3\u5ea6\n316| \u6bd4\u5728\u6c34\u4e2d\u9ad8\u51fa\u6570\u5343\u4e07\u500d\u3002\n317|=\n318| \\begin{definition}[\u751f\u7269\u7d2f\u79ef]\\label{def:b3:environmental-toxicology:bio}\n319| \u79f0\\emph{\u751f\u7269\u5bcc\u96c6\u7cfb\u6570}\\index{\u751f\u7269\u5bcc\u96c6\u7cfb\u6570}\uff08BCF\uff09\u4e3a\n320| \u7a33\u6001\u65f6\u751f\u7269\u4f53\u5185\u6d53\u5ea6\u4e0e\u5468\u56f4\u6c34\u4e2d\u6d