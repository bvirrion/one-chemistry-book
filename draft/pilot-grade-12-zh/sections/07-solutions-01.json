{"sha": "0d78e025bcc1d12c00f7961b7e4101c2eab76abc17a5fde41949cc7b381ac9aa", "body": ["\\section*{第 \\ref{ch:g12:ka-and-pka} 章 --- 酸和碱：Ka 与 pKa}", "", "\\begin{solution}{exo:g12:ka-and-pka:1}", "共轭碱：\\ce{HCOO-}、\\ce{NH3}、\\ce{OH-}、\\ce{CO3^{2-}}。共轭", "酸：\\ce{NH4+}、\\ce{H2O}、\\ce{H3O+}、\\ce{CO2,H2O}。两性物质：\\ce{H2O}", "和 \\ce{HCO3-}。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:2}", "pH 1.0；3.0；$-\\log(\\num{5.0e-3}) = 2.30$。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:3}", "$10^{-4.5} = \\qty{3.2e-5}{mol/L}$。当 pH 为 11.2 时：", "$[\\ce{H3O+}] = \\qty{6.3e-12}{mol/L}$，且", "$[\\ce{OH-}] = \\num{1.0e-14}/\\num{6.3e-12} = \\qty{1.6e-3}{mol/L}$。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:4}", "\\ce{HCOOH + H2O <=> HCOO- + H3O+}，", "$K_a = \\dfrac{[\\ce{HCOO-}][\\ce{H3O+}]}{[\\ce{HCOOH}]\\,c^\\circ}$；", "\\ce{NH4+ + H2O <=> NH3 + H3O+}，", "$K_a = \\dfrac{[\\ce{NH3}][\\ce{H3O+}]}{[\\ce{NH4+}]\\,c^\\circ}$。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:5}", "甲酸（$pK_a$ 较小）。较强的碱是 \\ce{CH3COO-}，它是", "较弱酸的共轭碱。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:6}", "$[\\ce{A-}] = [\\ce{H3O+}] = \\qty{1.0e-3}{mol/L}$；", "$[\\ce{HA}] = 0.050 - 0.001 = \\qty{0.049}{mol/L}$；", "$K_a = \\num{1.0e-6}/0.049 = \\num{2.0e-5}$；$pK_a = 4.69$。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:7}", "$K_a = \\num{6.31e-5}$；$x^2 + \\num{6.31e-5}\\,x - \\num{1.26e-6} = 0$ 得", "$x = \\qty{1.09e-3}{mol/L}$，pH 为 2.96。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:8}", "$\\mathrm{pH} = 14.0 + \\log(\\num{2.0e-3}) = 14.0 - 2.70 = 11.3$。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:9}", "\\ce{HF}、\\ce{HCOOH}、抗坏血酸、\\ce{C6H5COOH}、\\ce{CH3COOH}、", "\\ce{CO2,H2O}、\\ce{NH4+}、\\ce{HCO3-}。强酸的 pKa 远小于此列，", "已超出标尺范围：它与水完全反应。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:10}", "$[\\ce{H3O+}] = 10^{-5.6} = \\qty{2.5e-6}{mol/L}$，比", "纯水中（\\qty{1.0e-7}{mol/L}）多 25 倍。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:11}", "$K_a K_b = \\dfrac{[\\ce{NH3}][\\ce{H3O+}]}{[\\ce{NH4+}]c^\\circ} \\times", "\\dfrac{[\\ce{NH4+}][\\ce{OH-}]}{[\\ce{NH3}]c^\\circ} = K_e$，因此", "$pK_a = pK_e - pK_b = 14.0 - 4.74 = 9.26$。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:12}", "当浓度为 \\qty{0.0010}{mol/L} 时：$x^2 + \\num{1.74e-5}\\,x - \\num{1.74e-8} = 0$，", "$x = \\qty{1.24e-4}{mol/L}$，pH 为 3.91：上升了 0.52，而不是 1。稀释后，", "弱酸与水反应的比例更大（这里为", "\\qty{12}{\\percent}，原为 \\qty{4}{\\percent}），", "这在一定程度上弥补了稀释的影响。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:13}", "作为酸：\\ce{HCO3- + H2O <=> CO3^{2-} + H3O+}，$K = 10^{-10.33}$。作为", "碱：\\ce{HCO3- + H2O <=> H2CO3 + OH-}（\\ce{H2CO3} 代表 \\ce{CO2,H2O}），$K = K_e/K_a = 10^{-14.0+6.37}", "= 10^{-7.63}$。碱反应的平衡常数更大，故", "溶液略显碱性。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:14}", "无论多稀，酸都不可能使溶液呈碱性。当酸自身", "产生的水合氢离子少于水提供的 \\qty{1e-7}{mol/L} 时，", "水的离子占主导：pH 从下方趋近于 7，", "且永不越过 7。", "\\end{solution}", "", "\\begin{solution}{exo:g12:ka-and-pka:15}", "$n = 0.500 / 176.0 = \\qty{2.84e-3}{mol}$，$c = \\qty{0.0142}{mol/L}$；", "$K_a = \\num{9.12e-5}$；$x^2 + \\num{9.12e-5}\\,x - \\num{1.30e-6} = 0$ 得", "$x = \\qty{1.09e-3}{mol/L}$，pH 为 2.96。", "\\end{solution}", "", "\\begin{solution}{pb:g12:ka-and-pka:1}", "\\textbf{1.} \\ce{H-C(=O)-O-H}：所给的氢来自 \\ce{O-H}。", "", "\\textbf{2.} \\ce{HCOOH}/\\ce{HCOO-}；\\ce{HCOOH + H2O <=> HCOO- + H3O+}。", "", "\\textbf{3.} $K_a = \\dfrac{[\\ce{HCOO-}][\\ce{H3O+}]}{[\\ce{HCOOH}]c^\\circ} =", "10^{-3.74} = \\num{1.82e-4}$。", "", "\\textbf{4.} pKa 低于乙酸（$3.74 < 4.76$）：酸性更强。", "", "\\textbf{5.} $M = \\qty{46.0}{g/mol}$：$0.010 \\times 46.0 = \\qty{0.46}{g}$。", "", "\\textbf{6.} \\ce{HCOOH}：$0.010 - x$；\\ce{HCOO-}：$x$；\\ce{H3O+}：$x$。", "", "\\textbf{7.} $\\dfrac{x^2}{0.010 - x} = \\num{1.82e-4}$。", "", "\\textbf{8.} $x^2 + \\num{1.82e-4}\\,x - \\num{1.82e-6} = 0$：", "$x = \\qty{1.26e-3}{mol/L}$。", "", "\\textbf{9.} $\\mathrm{pH} = -\\log(\\num{1.26e-3}) = 2.90$。", ""]}