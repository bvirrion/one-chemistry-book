{"sha": "11cb13e3ca1b8fd7b528c554b343f1666b310d87a2c2e3ef62d9b1760af59f6d", "body": ["\\begin{omfigure}", "\\begin{tikzpicture}[font=\\small, x=1pt, y=1pt]", "  % ledger: rion:O2-VI, rion:F-VI, rion:Na+VI, rion:Mg2+VI, rion:Al3+VI", "  % radii in pm drawn at 0.30 pt per pm (circles to scale)", "  \\foreach \\x/\\r/\\lab/\\v in {40/140/\\ce{O^{2-}}/140, 130/133/\\ce{F-}/133,", "      210/102/\\ce{Na+}/102, 275/72/\\ce{Mg^{2+}}/72, 325/53.5/\\ce{Al^{3+}}/54} {", "    \\draw[fill=omDef!20, draw=omDef!70!black] (\\x,0) circle ({0.30*\\r});", "    \\node at (\\x,0) {\\lab};", "    \\node[below] at (\\x,-50) {\\v\\,pm};", "  }", "  \\node[anchor=west, align=left] at (350,0) {每个都有十个电子，\\\\$Z = 8 \\to 13$};", "\\end{tikzpicture}", "", "{\\small 等电子系列 $1\\text{s}^2 2\\text{s}^2 2\\text{p}^6$，", "按比例绘制（离子半径取六配位邻居）。同样的十个电子，", "随核电荷增大而收缩。}", "\\end{omfigure}", "", "\\section{能量：电离与电子亲和能}", "", "\\begin{definition}[电离能]\\label{def:b1:periodicity:ionisation-energy}", "元素的\\emph{第一电离能}\\index{第一电离能} $E_{i1}$", "是指在气相中使元素的基态孤立原子", "失去一个电子所需的能量：", "\\[", "  \\ce{X(g) -> X+(g) + e-}, \\qquad E_{i1} = E(\\ce{X+}) + E(\\ce{e-}) - E(\\ce{X}) > 0 .", "\\]", "\\emph{逐级电离能}\\index{逐级电离能}", "$E_{i2}, E_{i3}, \\dots$ 分别是从", "\\ce{X+}、\\ce{X^{2+}}\\dots\\ 中移去第二个、第三个电子\\dots\\ 所需的能量。", "它们以电子伏特每原子或千焦每摩尔给出", "（$\\qty{1}{eV} \\leftrightarrow \\qty{96.49}{kJ/mol}$）。", "% ledger: const:NA, const:e (1 eV x N_A = 96.485 kJ/mol)", "\\end{definition}", "", "\\begin{omfigure}", "\\begin{tikzpicture}", "\\begin{axis}[", "  width=0.92\\linewidth, height=6.4cm,", "  xmin=0, xmax=37, ymin=0, ymax=27,", "  axis x line=bottom, axis y line=left,", "  xlabel={原子序数 $Z$}, ylabel={$E_{i1}$ (eV)},", "  xtick={2,10,18,36}, ytick={0,5,10,15,20,25},", "  tick label style={font=\\small}, label style={font=\\small},", "  clip=false]", "\\addplot[omDef, thick, mark=*, mark size=1.3pt] table[x=Z, y=IE_eV] {figdata/out/bachelor-1-ionisation-energies.dat};", "\\node[font=\\small, anchor=south] at (axis cs:2,24.6) {He};", "\\node[font=\\small, anchor=south] at (axis cs:10,21.6) {Ne};", "\\node[font=\\small, anchor=south] at (axis cs:18,15.8) {Ar};", "\\node[font=\\small, anchor=south] at (axis cs:36,14.0) {Kr};", "\\node[font=\\small, anchor=north] at (axis cs:3,5.2) {Li};", "\\node[font=\\small, anchor=north] at (axis cs:11,4.9) {Na};", "\\node[font=\\small, anchor=north] at (axis cs:19,4.1) {K};", "\\node[font=\\small, anchor=north] at (axis cs:31,5.8) {Ga};", "\\node[font=\\small, anchor=north] at (axis cs:5,7.9) {B};", "\\node[font=\\small, anchor=north] at (axis cs:8,13.2) {O};", "\\node[font=\\small, anchor=north west] at (axis cs:13.1,6.0) {Al};", "\\node[font=\\small, anchor=north] at (axis cs:16,9.9) {S};", "\\node[font=\\small, anchor=south] at (axis cs:26,8.0) {3d 金属};", "\\end{axis}", "\\end{tikzpicture}", "", "{\\small 前 36 种元素的第一电离能。极大值出现在稀有气体处，", "极小值出现在碱金属处；B、Al、Ga 处的小凹陷，", "以及 O、S 处的小凹陷，都是", "\\cref{prop:b1:periodicity:ie-anomalies}所述亚层效应的结果。}", "\\end{omfigure}", "", "\\begin{proposition}[电离能的变化规律]\\label{prop:b1:periodicity:ie-trend}", "第一电离能沿周期从碱金属到稀有气体增大，", "沿族向下减小。逐级", "电离能总是增大，$E_{i1} < E_{i2} < \\dots$，并且", "当移去的电子属于内层时，跃升一个很大的倍数。", "\\end{proposition}", "", "\\begin{proof}[推理]", "电子离核较远、所受 $Z^{*}$ 较小时，移去它较容易：", "沿周期 $Z^{*}$ 增大而半径收缩；沿族向下半径增大。", "逐级移去的每个电子都取自电荷更高、体积更小的离子，因此代价更大；", "价电子层一旦空了，", "下一个电子来自 $n$ 更小的电子层，离核近得多，", "几乎完全不受屏蔽。", "\\end{proof}", "", "\\begin{example}[镁]\\label{ex:b1:periodicity:magnesium}", "镁的逐级电离能依次为 7.65、15.04、80.14", "和 \\qty{109.27}{eV}。比值 $E_{i2}/E_{i1} \\approx 2$ 较为适中；", "$E_{i3}/E_{i2} \\approx 5.3$ 则是一次跳跃：第三个电子来自", "2p 内层。镁失去两个 3s 电子后，停止于", "\\ce{Mg^{2+}}，具有氖的稀有气体构型。", "% ledger: ie:Mg, ie2:Mg, ie3:Mg, ie4:Mg", "\\end{example}", "", "\\begin{omfigure}", "\\begin{tikzpicture}", "\\begin{axis}[", "  width=0.55\\linewidth, height=5.2cm, ybar, bar width=14pt,", "  xmin=0.4, xmax=4.6, ymin=1, ymax=300, ymode=log,", "  axis x line=bottom, axis y line=left,", "  xlabel={移去的电子}, ylabel={$E_{i}$ (eV)},", "  xtick={1,2,3,4}, xticklabels={第一,第二,第三,第四},", "  tick label style={font=\\small}, label style={font=\\small},", "  nodes near coords={\\pgfmathprintnumber[fixed, fixed zerofill, precision=2]{\\pgfplotspointmeta}},", "  nodes near coords style={font=\\scriptsize},", "  point meta=rawy]", "\\addplot[fill=omDef!40, draw=omDef] table[x=k, y=IE_eV] {figdata/out/bachelor-1-ionisation-energies-mg.dat};", "\\end{axis}", "\\end{tikzpicture}", "", "{\\small 镁的逐级电离能（对数坐标轴）。", "第三个约为第二个的五倍：3s 电子层已空，", "内层已被触及。}", "\\end{omfigure}", ""]}