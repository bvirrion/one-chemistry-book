{"sha": "d4d598d4d2aeeebddc721c860844a31b7ad13053e5719c5045b65b66aaf9d876", "body": ["\\begin{method}[进度表]\\label{met:b1:extent-q-and-k:progress-table}", "对封闭系统中的反应进行跟踪：", "\\begin{enumerate}", "  \\item 写出配平的方程式，并在其下为每种物质设一列；", "  \\item 第一行：初始物质的量 $n_{i,0}$；", "  \\item 第二行：反应进度为 $\\xi$ 时的物质的量 $n_{i,0} + \\nu_i\\xi$；", "  \\item 对于气体，增加一列，表示总物质的量 $n_{\\text{总}}(\\xi)$；", "  \\item 计算 $\\xi_{\\max}$（及 $\\xi_{\\min}$），并确定限量", "        反应物；", "  \\item 最后一行：最终物质的量，对应最终反应进度 $\\xi_f$（由平衡条件", "        求得，或在反应完全时", "        等于 $\\xi_{\\max}$）。", "\\end{enumerate}", "\\end{method}", "", "\\begin{example}[合成氨]\\label{ex:b1:extent-q-and-k:ammonia}", "以 \\qty{2.0}{mol} 的 \\ce{N2} 与 \\qty{3.0}{mol} 的 \\ce{H2} 为原料：", "\\begin{center}", "\\begin{tabular}{lcccc}", "\\hline", " & \\ce{N2} & \\ce{3H2} & \\ce{2NH3} & 总计 \\\\", "\\hline", "初始 & 2.0 & 3.0 & 0 & 5.0 \\\\", "反应进度 $\\xi$ & $2.0 - \\xi$ & $3.0 - 3\\xi$ & $2\\xi$ & $5.0 - 2\\xi$ \\\\", "\\hline", "\\end{tabular}", "\\end{center}", "$\\xi_{\\max} = \\min(2.0/1,\\ 3.0/3) = \\qty{1.0}{mol}$：限量反应物为氢气。", "若反应为完全反应，则最终状态中含 \\qty{1.0}{mol}", "\\ce{N2} 与 \\qty{2.0}{mol} \\ce{NH3}。", "\\end{example}", "", "\\begin{definition}[最终转化率，产率]\\label{def:b1:extent-q-and-k:fractional-extent}", "某反应的\\emph{最终转化率}\\index{最终转化率}", "为 $\\tau = \\xi_f/\\xi_{\\max}$，取值介于 0 与 1 之间。在合成反应中，某产物的", "\\emph{产率}\\index{产率}是所得该产物的物质的量", "与限量反应物在反应完全时可得的该产物物质的量之比；", "若分离过程中产物没有损失，则产率等于 $\\tau$。", "\\end{definition}", "", "\\section{活度}", "", "\\begin{definition}[标准态，活度]\\label{def:b1:extent-q-and-k:activity}", "某物种的\\emph{活度}\\index{活度} $a_i$ 是一个无量纲的", "数，用来度量其在平衡定律表达式中有多少可供利用；", "它是相对于\\emph{标准", "态}\\index{标准态}定义的，即在所考虑的温度下的参考状态，", "并以标准压强 $p^\\circ = \\qty{1}{bar}$ 为基准。在本书采用的", "理想近似下：", "\\begin{itemize}", "  \\item 对于气体，$a_i = p_i/p^\\circ$（标准态为", "        $p^\\circ$ 下的纯理想气体）；", "  \\item 对于稀溶液中的溶质，$a_i = c_i/c^\\circ$，其中", "        $c^\\circ = \\qty{1}{mol/L}$；", "  \\item 对于稀溶液中的溶剂，以及单独处于其相中的纯固体或", "        纯液体，$a_i = 1$。", "\\end{itemize}", "\\end{definition}", "% ledger: const:pstd", "", "\\begin{remark}[理想与实际]\\label{rem:b1:extent-q-and-k:ideal}", "这些表达式适用于理想气体与稀溶液。在浓溶液中，", "离子之间相互吸引与排斥，活度偏离 $c_i/c^\\circ$；", "其修正以活度系数表示，", "相关内容在本科二年级分册中结合化学势加以研究。", "对于本书所用的浓度（约低于", "\\qty{0.1}{mol/L}）时，理想表达式的误差在百分之几以内。", "\\end{remark}", "", "\\section{反应商与平衡常数}", "", "\\begin{definition}[反应商]\\label{def:b1:extent-q-and-k:quotient}", "在体系的给定状态下，反应的\\emph{反应商}\\index{反应商}", "（对于 $0 = \\sum_i \\nu_i\\,\\mathrm{A}_i$）为", "\\[", "  Q = \\prod_i a_i^{\\nu_i} ,", "\\]", "即各生成物活度之积除以各反应物活度之积，", "每项均取其化学计量数为指数。", "\\end{definition}", "", "\\begin{example}[三个反应商]\\label{ex:b1:extent-q-and-k:quotients}", "对于 \\ce{N2(g) + 3H2(g) <=> 2NH3(g)}：$Q = \\dfrac{(p_{\\ce{NH3}}/p^\\circ)^2}", "{(p_{\\ce{N2}}/p^\\circ)(p_{\\ce{H2}}/p^\\circ)^3}$。对于", "\\ce{CH3COOH(aq) + H2O(l) <=> CH3COO^-(aq) + H3O+(aq)}：$Q =", "\\dfrac{[\\ce{CH3COO-}][\\ce{H3O+}]}{[\\ce{CH3COOH}]\\,c^\\circ}$，其中溶剂", "活度为 1。对于 \\ce{CaCO3(s) <=> CaO(s) + CO2(g)}：$Q =", "p_{\\ce{CO2}}/p^\\circ$，其中固体活度均为 1。", "\\end{example}", "", "\\begin{definition}[标准平衡常数]\\label{def:b1:extent-q-and-k:equilibrium-constant}", "反应的\\emph{标准平衡常数}\\index{标准平衡常数}", "$K^\\circ$ 是体系达到平衡时其反应商所取的值。", "它是无量纲的，", "且仅依赖于反应与温度。", "\\end{definition}", "", "\\begin{theorem}[质量作用定律]\\label{thm:b1:extent-q-and-k:mass-action}", "在给定温度下，若反应可在两个方向上进行，", "则体系将演化至 $Q = K^\\circ(T)$；平衡时，", "无论初始组成如何，", "\\[", "  \\prod_i a_{i,\\text{平衡}}^{\\nu_i} = K^\\circ(T) .", "\\]", "\\end{theorem}", "\\admitted", "", "\\begin{proposition}[演化方向]\\label{prop:b1:extent-q-and-k:direction}", "若 $Q < K^\\circ$，体系向正方向演化（$\\xi$", "增大）；若 $Q > K^\\circ$，则向逆方向演化；若", "$Q = K^\\circ$，则体系处于平衡状态。", "\\end{proposition}", "\\admitted", ""]}