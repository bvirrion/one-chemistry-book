 "result": "233| \u94c1\u4e0e\u6c34\uff1a\u91d1\u5c5e\u94c1\u7684\u533a\u57df\u5728\u6bcf\u4e00 pH \u4e0b\u90fd\u4f4d\u4e8e \\ce{H2O}/\\ce{H2} \u7ebf\u4e4b\u4e0b\u3002\n234| \u94c1\u80fd\u8fd8\u539f\u6c34\uff0c\u5728\u9178\u6027\u6eb6\u6db2\u4e2d\u4f1a\u660e\u663e\u653e\u51fa\u6c22\u6c14\uff1b\u6709\u6eb6\u89e3\u6c27\u5b58\u5728\u65f6\uff0c\u6c27\u5316\u8fd8\u8981\u66f4\u5feb\u3002\n235| \u94dc\uff1a\u5176\u533a\u57df\u4e0e\u6c34\u7684\u533a\u57df\u6709\u91cd\u53e0\uff0c\u56e0\u6b64\u94dc\u4e0d\u80fd\u8fd8\u539f\u6c34\uff0c\u4e5f\u4e0d\u80fd\u8fd8\u539f\u672c\u8eab\u4e0d\u662f\u6c27\u5316\u5242\u7684\u9178\uff0c\n236| \u4f46\u4f4d\u4e8e\u5176\u4e0a\u65b9\u7684\u7a7a\u6c14\u4e2d\u7684\u6c27\u4f1a\u7f13\u6162\u5730\u5c06\u5176\u6c27\u5316\u2014\u2014\u5c4b\u9876\u4e0a\u7684\u7eff\u8272\u94dc\u9508\u662f\u8be5\u6c27\u5316\u8fc7\u7a0b\u7684\u540e\u7eed\u4ea7\u7269\uff0c\n237| \u5b83\u4e0e\u4e8c\u6c27\u5316\u78b3\u548c\u786b\u5316\u5408\u7269\u53cd\u5e94\u751f\u6210\u3002\u56fe\u53ea\u80fd\u8bf4\u660e\u4ec0\u4e48\u662f\u53ef\u80fd\u7684\uff0c\u800c\u4e0d\u80fd\u8bf4\u660e\u53cd\u5e94\u6709\u591a\u5feb\uff1a\n238| \u56fe\u4e2d\u5141\u8bb8\u53d1\u751f\u7684\u8bb8\u591a\u53cd\u5e94\u90fd\u662f\u6162\u7684\uff0c\u8fd9\u4e00\u95ee\u9898\u5c06\u5728\u672c\u79d1\u4e8c\u5e74\u7ea7\u5206\u518c\u4e2d\u8ba8\u8bba\u3002\n\n=\n\n\\begin{definition}[\u6b67\u5316\u3001\u5f52\u4e2d]\\label{def:b1:e-ph-diagrams:disproportionation}\n\\emph{\u6b67\u5316}\\index{\u6b67\u5316}\u662f\u540c\u4e00\u7269\u79cd\u4e0e\u81ea\u8eab\u53d1\u751f\u7684\u53cd\u5e94\uff0c\u5176\u4e00\u90e8\u5206\u88ab\u6c27\u5316\uff0c\u53e6\u4e00\u90e8\u5206\u88ab\u8fd8\u539f\uff1a\n\\ce{2Cu+ -> Cu^2+ + Cu}\u3002\u5176\u9006\u53cd\u5e94\uff0c\u5373\u540c\u4e00\u5143\u7d20\u7684\u4e24\u79cd\u7269\u79cd\u751f\u6210\u4e2d\u95f4\u6c27\u5316\u6570\u7684\u7269\u79cd\uff0c\u79f0\u4e3a\n\\emph{\u5f52\u4e2d}\\index{\u5f52\u4e2d}\uff1a\n\\ce{2Fe^3+ + Fe -> 3Fe^2+}\u3002\n\\end{definition}\n\n=\n\n\\begin{proposition}[\u6b67\u5316\u5224\u636e]\\label{prop:b1:e-ph-diagrams:disproportionation-criterion}\n\u8bbe\u7269\u79cd B \u7684\u6c27\u5316\u6570\u4ecb\u4e8e\u5176\u4f59\u4e24\u8005\u4e4b\u95f4\uff0c\u5b83\u5904\u4e8e\u7535\u5bf9 A/B \u4e0e B/C \u4e2d\u3002\u82e5 $E(\\mathrm{B}/\\mathrm{C}) > E(\\mathrm{A}/\\mathrm{B})$\uff0c\u5219 B \u53d1\u751f\u6b67\u5316\uff1a\n\u6b64\u65f6 B \u4e0d\u518d\u6709\u81ea\u8eab\u7684\u533a\u57df\uff0c\u4e24\u4e2a\u8fb9\u754c\u88ab\u5355\u4e00\u7684\u8fb9\u754c A/C \u6240\u53d6\u4ee3\u3002\n\\end{proposition}\n\n=\n\n\\begin{proof}\nB \u662f\u7535\u5bf9 B/C \u7684\u6c27\u5316\u5242\uff0c\u4e5f\u662f\u7535\u5bf9 A/B \u7684\u8fd8\u539f\u5242\u3002\u82e5\u7535\u5bf9 B/C \u4f4d\u4e8e A/B \u4e4b\u4e0a\uff0c\n\u7531\\cref{met:b1:nernst:predict-redox}\uff08$\\gamma$ \u89c4\u5219\uff09\u53ef\u77e5\uff0cB\uff08\u6c27\u5316\u5242\uff0c\u4f4d\u4e8e\u4e0a\u65b9\u7684\u7535\u5bf9\uff09\u4e0e B\uff08\u8fd8\u539f\u5242\uff0c\u4f4d\u4e8e\u4e0b\u65b9\u7684\u7535\u5bf9\uff09\u53cd\u5e94\uff0c\n\u751f\u6210 C \u4e0e A\u3002\u4ece\u51e0\u4f55\u4e0a\u770b\uff0cB \u53ea\u80fd\u7a33\u5b9a\u4e8e $E(\\mathrm{B}/\\mathrm{C})$ \u4e4b\u4e0a\u4e14 $E(\\mathrm{A}/\\mathrm{B})$ \u4e4b\u4e0b\uff0c\n\u800c\u8fd9\u662f\u4e00\u4e2a\u7a7a\u96c6\u3002\n\\end{proof}\n\n=\n\n\\begin{definition}[\u514d\u8680\u533a\u3001\u8150\u8680\u533a\u4e0e\u949d\u5316\u533a]\\label{def:b1:e-ph-diagrams:corrosion-domains}\n\u5728\u91d1\u5c5e\u7684\u56fe\u4e0a\uff0c\u91d1\u5c5e\u672c\u8eab\u6240\u5728\u7684\u533a\u57df\u79f0\u4e3a\u5176\\emph{\u514d\u8680\u533a}\\index{\u514d\u8680\u533a}\uff08\u5b83\u4e0d\u80fd\u88ab\u6c27\u5316\uff09\uff1b\n\u5176\u6eb6\u89e3\u79bb\u5b50\u7684\u533a\u57df\u6784\u6210\\emph{\u8150\u8680\u533a}\\index{\u8150\u8680\u533a}\uff1b\n\u5176\u56fa\u4f53\u6c27\u5316\u7269\u4e0e\u6c22\u6c27\u5316\u7269\u7684\u533a\u57df\uff08\u5b83\u4eec\u53ef\u80fd\u5305\u8986\u5728\u91d1\u5c5e\u8868\u9762\uff09\u6784\u6210\\emph{\u949d\u5316\u533a}\\index{\u949d\u5316\u533a}\u3002\n\u5305\u8986\u5c42\u80fd\u5426\u771f\u6b63\u8d77\u5230\u4fdd\u62a4\u4f5c\u7528\uff0c\u662f\u4e00\u4e2a\u52a8\u529b\u5b66\u95ee\u9898\uff0c\u5c06\u5728\u672c\u79d1\u4e8c\u5e74\u7ea7\u5206\u518c\u4e2d\u8ba8\u8bba\u3002\n\\end{definition}\n\n=\n\n\\begin{method}[\u8bfb\u56fe\u65b9\u6cd5]\\label{met:b1:e-ph-diagrams:read}\n\\begin{enumerate}\n  \\item \u53e0\u52a0\u6c34\u7684\u7ebf\uff1a\u533a\u57df\u4f4d\u4e8e\u6c34\u7684\u7a33\u5b9a\u5e26\u4e4b\u5916\u7684\u7269\u79cd\uff0c\u4f1a\uff08\u5728\u70ed\u529b\u5b66\u4e0a\uff09\u4e0e\u6c34\u53d1\u751f\u53cd\u5e94\u3002\n  \\item \u5bf9\u4e8e\u4e24\u79cd\u4e0d\u540c\u5143\u7d20\u7684\u7269\u79cd\uff0c\u53e0\u52a0\u5b83\u4eec\u7684\u56fe\uff1a\u5728\u6240\u8003\u5bdf\u7684 pH \u4e0b\u82e5\u533a\u57df\u4e0d\u76f8\u4ea4\uff0c\u5219\u8bf4\u660e\u4f1a\u53d1\u751f\u53cd\u5e94\u3002\n  \\item \u5bf9\u4e8e\u91d1\u5c5e\uff0c\u5728\u56fe\u4e0a\u627e\u5230\u4ecb\u8d28\u7684\u70b9\uff08pH\uff0c$E$\uff09\uff0c\u5224\u65ad\u5176\u5904\u4e8e\u514d\u8680\u533a\u3001\u8150\u8680\u533a\u8fd8\u662f\u949d\u5316\u533a\u3002\n  \\item \u6ce8\u610f\uff0c\u56fe\u662f\u5728\u67d0\u4e00\u8fb9\u754c\u6d53\u5ea6\u4e0b\u7ed8\u5236\u7684\uff1b\n        \u4e0e\u6eb6\u89e3\u7269\u79cd\u76f8\u63a5\u7684\u8fb9\u754c\uff0c\u6bcf\u5341\u500d\u6d53\u5ea6\u53d8\u5316\u4e00\u6b21\uff0c\u79fb\u52a8 $0.059/n$~V\u3002\n\\end{enumerate}\n\\end{method}\n\n=\n\n\u950c\u4fdd\u62a4\u94c1\uff1a\u5728\u6d77\u6c34\uff08pH \u7ea6\u4e3a 8\uff09\u4e2d\uff0c\u8239\u4f53\u7684\u950c\u4e0e\u94a2\u76f8\u4e92\u63a5\u89e6\uff1b\n\u7535\u52bf\u8f83\u4f4e\u7684\u950c\u5148\u88ab\u6c27\u5316\uff0c\u5176\u91ca\u653e\u7684\u7535\u5b50\u4f7f\u94c1\u4fdd\u6301\u5728\u514d\u8680\u533a\u5185\u6216\u5176\u9644\u8fd1\u3002\n\u950c\u5757\u88ab\u6d88\u8017\uff0c\u6bcf\u6b21\u8fdb\u575e\u65f6\u90fd\u8981\u66f4\u6362\u3002\n\n=\n\n\\section{\u7ec3\u4e60}\n\n=\n\n\\begin{exercise}[$\\star$]\\label{exo:b1:e-ph-diagrams:1}\n\u5c06\u4e0b\u5217\u7269\u79cd\u6309\u5143\u7d20\u7684\u6c27\u5316\u6570\u6392\u5e8f\uff1a\\ce{Mn}\u3001\\ce{Mn^2+}\u3001\n\\ce{MnO2}\u3001\\ce{MnO4-}\u3001\\ce{Mn(OH)2}\uff0c\u4ee5\u53ca \\ce{Cl-}\u3001\\ce{Cl2}\u3001\\ce{HClO}\u3001\n\\ce{ClO-}\u3001\\ce{ClO3-}\u3002\n\\end{exercise}\n\n=\n\n\\begin{exercise}[$\\star$]\\label{exo:b1:e-ph-diagrams:2}\n\u6c42\u5404\u534a\u53cd\u5e94\u5f0f\u5bf9\u5e94\u8fb9\u754c\u7684\u659c\u7387\uff1a\n\\ce{Fe(OH)3 + 3H+ + e- -> Fe^2+ + 3H2O}\uff1b\\ce{2Cu^2+ + H2O + 2e- -> Cu2O + 2H+}\uff1b\n\\ce{MnO4- + 8H+ + 5e- -> Mn^2+ + 4H2O}\uff1b\\ce{Zn(OH)2 + 2H+ + 2e- -> Zn + 2H2O}\u3002\n\u4e3a\u4ec0\u4e48\u5176\u4e2d\u4e00\u6761\u8fb9\u754c\u7684\u659c\u7387\u4e3a\u6b63\uff1f\n\\end{exercise}\n\n=\n\n\\begin{exercise}[$\\star$]\\label{exo:b1:e-ph-diagrams:3}\n\u6c34\u7684\u7ebf\u5728\u4f55 pH \u4e0b\u901a\u8fc7 0~V\uff0c\u53c8\u5728\u4f55 pH \u4e0b\u901a\u8fc7 \\qty{0.50}{V}\uff1fpH \u4e3a 7 \u65f6\uff0c\u6c34\u7684\u7a33\u5b9a\u533a\u7684\u5bbd\u5ea6\u662f\u591a\u5c11\uff1f\n\\end{exercise}\n\n=\n\n\\begin{exercise}[$\\star$]\\label{exo:b1:e-ph-diagrams:4}\n\u5229\u7528\u94c1\u7684\u56fe\uff0c\u7ed9\u51fa\u4e0b\u5217\u6761\u4ef6\u4e0b\u94c1\u7684\u7a33\u5b9a\u5f62\u5f0f\uff1a\n\uff08pH 1\uff0c$E = 1.0$~V\uff09\u3001\uff08pH 4\uff0c$E = 0$\uff09\u3001\uff08pH 10\uff0c$E = -0.4$~V\uff09\u4ee5\u53ca\n\uff08pH 10\uff0c$E = 0.5$~V\uff09\u3002\n\\end{exercise}\n\n=\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:b1:e-ph-diagrams:5}\n\u5bf9\u4e8e\u7528\u4e8e\u8ba8\u8bba\u8150\u8680\u7684\u8fb9\u754c\u6d53\u5ea6 \\qty{1.0e-6}{mol/L}\uff0c\u91cd\u65b0\u8ba1\u7b97\u8fb9\u754c \\ce{Fe^2+}/\\ce{Fe} \u4ee5\u53ca\u7ad6\u76f4\u7684\u8fb9\u754c \\ce{Fe^3+}/\\ce{Fe(OH)3}\u3002\n\u54ea\u4e9b\u533a\u57df\u4f1a\u6269\u5927\uff1f\n\\end{exercise}\n\n=\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:b1:e-ph-diagrams:6}\n\u63a8\u5bfc\u8fb9\u754c \\ce{Fe(OH)3}/\\ce{Fe^2+}\uff1a\u5199\u51fa\u5176\u534a\u53cd\u5e94\u5f0f\u53ca\u80fd\u65af\u7279\u65b9\u7a0b\uff0c\u5e76\u5229\u7528 pH 1.82 \u5904\u7684\u8fde\u7eed\u6027\u8bc1\u660e $E = 1.09 -\n0.177\\,\\mathrm{pH}$\u3002\n\\end{exercise}\n\n=\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:b1:e-ph-diagrams:7}\n\u5229\u7528\u6807\u51c6\u7535\u52bf\u8868\u8bf4\u660e\u5728 pH 0 \u65f6 \\ce{Cu+} \u53d1\u751f\u6b67\u5316\uff0c\u5e76\u6c42\u5728 $c = \\qty{0.010}{mol/L}$ \u65f6\u5355\u4e00\u8fb9\u754c \\ce{Cu^2+}/\\ce{Cu} \u7684\u7535\u52bf\u3002\n\\end{exercise}\n\n=\n\n\\begin{exercise}[$\\star\\star$]\\label{exo:b1:e-ph-diagrams:8}\n\u5728\u65e0\u7a7a\u6c14\u6761\u4ef6\u4e0b\uff0c\u94dc\u80fd\u5426\u6eb6\u4e8e pH 0 \u7684\u76d0\u9178\uff1f\u80fd\u5426\u6eb6\u4e8e\u785d\u9178\uff08\u7535\u5bf9 \\ce{NO3-}/\\ce{NO}\uff0c$E^\\circ = 0.96$~V\uff09\uff1f\u8bf7\u7ed3\u5408\u56fe\u4e0e\u7535\u52bf\u52a0\u4ee5\u8bba\u8bc1\u3002\n\\end{exercise}\n\n=",
