ch:b1:periodicity}\u4e2d\u5b9a\u91cf\u5316\uff1b\u539f\u5b50\u7684\u4ef7\u7535\u5b50\u53ef\u7531\u5176\u7535\u5b50\u6392\u5e03\u8bfb\u51fa\uff08\u89c1\\cref{def:b1:quantum-numbers:configuration}\uff09\u3002\n10|\\end{recall}\n11|=\n12|\\section{\u8def\u6613\u65af\u7ed3\u6784\u4e0e\u5f62\u5f0f\u7535\u8377}\n13|=\n14|\\begin{definition}[\u5171\u4ef7\u952e\uff0c\u8def\u6613\u65af\u7ed3\u6784]\\label{def:b1:lewis-resonance-vsepr:lewis}\n15|\u4e24\u4e2a\u539f\u5b50\u5171\u7528\u7684\u4e00\u5bf9\u7535\u5b50\u79f0\u4e3a\\emph{\u5171\u4ef7\u952e}\\index{\u5171\u4ef7\u952e}\uff0c\u5373\\emph{\u6210\u952e\u7535\u5b50\u5bf9}\\index{\u6210\u952e\u7535\u5b50\u5bf9}\uff1b\u4e24\u5bf9\u6216\u4e09\u5bf9\u6210\u952e\u7535\u5b50\u5bf9\u5206\u522b\u6784\u6210\u53cc\u952e\u6216\u4e09\u952e\u3002\u5c5e\u4e8e\u5355\u4e2a\u539f\u5b50\u7684\u4e00\u5bf9\u4ef7\u7535\u5b50\u79f0\u4e3a\\emph{\u5b64\u7535\u5b50\u5bf9}\\index{\u5b64\u7535\u5b50\u5bf9}\u3002\\emph{\u8def\u6613\u65af\u7ed3\u6784}\\index{\u8def\u6613\u65af\u7ed3\u6784}\u8868\u793a\u5206\u5b50\u6216\u79bb\u5b50\u7684\u5168\u90e8\u4ef7\u7535\u5b50\uff0c\u5176\u4e2d\u6210\u952e\u7535\u5b50\u4ee5\u539f\u5b50\u4e4b\u95f4\u7684\u8fde\u7ebf\u8868\u793a\uff0c\u5b64\u7535\u5b50\u5bf9\u4ee5\u539f\u5b50\u4e0a\u7684\u7ebf\u6216\u70b9\u5bf9\u8868\u793a\u3002\u6839\u636e\\emph{\u516b\u9685\u89c4\u5219}\\index{\u516b\u9685\u89c4\u5219}\uff0c\u7b2c\u4e8c\u5468\u671f\u539f\u5b50\uff08C\u3001N\u3001O\u3001F\uff09\u5728\u7a33\u5b9a\u7ed3\u6784\u4e2d\u88ab\u56db\u5bf9\u7535\u5b50\u5373\u516b\u4e2a\u7535\u5b50\u5305\u56f4\uff1b\u6839\u636e\\emph{\u4e8c\u9685\u89c4\u5219}\\index{\u4e8c\u9685\u89c4\u5219}\uff0c\u6c22\u539f\u5b50\u88ab\u4e00\u5bf9\u7535\u5b50\u5305\u56f4\u3002\n16|\\end{definition}\n17|=\n18|\\begin{definition}[\u5f62\u5f0f\u7535\u8377]\\label{def:b1:lewis-resonance-vsepr:formal-charge}\n19|\u5728\u8def\u6613\u65af\u7ed3\u6784\u4e2d\uff0c\u67d0\u539f\u5b50\u7684\\emph{\u5f62\u5f0f\u7535\u8377}\\index{\u5f62\u5f0f\u7535\u8377}\u4e3a\n20|\\[\n21|  q_F = N_v - N_{\\text{lone}} - \\tfrac12 N_{\\text{bond}},\n22|\\]\n23|\u5176\u4e2d $N_v$ \u4e3a\u6e38\u79bb\u539f\u5b50\u7684\u4ef7\u7535\u5b50\u6570\uff0c$N_{\\text{lone}}$ \u4e3a\u5176\u5b64\u7535\u5b50\u5bf9\u4e2d\u7684\u7535\u5b50\u6570\uff0c$N_{\\text{bond}}$ \u4e3a\u5b83\u6240\u5f62\u6210\u7684\u952e\u4e2d\u7684\u7535\u5b50\u6570\u3002\u5f53\u5f62\u5f0f\u7535\u8377\u4e0d\u4e3a\u96f6\u65f6\uff0c\u5c06\u5176\u4ee5 $\\oplus$ \u6216 $\\ominus$ \u5199\u5728\u8be5\u539f\u5b50\u65c1\u8fb9\u3002\n24|\\end{definition}\n25|=\n26|\\begin{proposition}[\u5f62\u5f0f\u7535\u8377\u4e4b\u548c\u7b49\u4e8e\u7535\u8377]\\label{prop:b1:lewis-resonance-vsepr:formal-sum}\n27|\u8def\u6613\u65af\u7ed3\u6784\u4e2d\u5404\u539f\u5b50\u5f62\u5f0f\u7535\u8377\u4e4b\u548c\uff0c\u7b49\u4e8e\u5206\u5b50\u6216\u79bb\u5b50\u7684\u603b\u7535\u8377\u3002\n28|\\end{proposition}\n29|=\n30|\\begin{proof}\n31|\u5bf9\u5404\u539f\u5b50\u7684 $q_F$ \u6c42\u548c\uff0c\u5f97 $\\sum N_v - (\\text{\u5b64\u7535\u5b50\u5bf9\u4e2d\u7684\u7535\u5b50\u6570} + \\text{\u952e\u4e2d\u7684\u7535\u5b50\u6570})$\uff0c\u8fd9\u662f\u56e0\u4e3a\u6bcf\u6839\u952e\u7684\u7535\u5b50\u5728\u5176\u4e24\u4e2a\u539f\u5b50\u4e0a\u5404\u8ba1\u4e00\u534a\u3002\u62ec\u53f7\u4e2d\u7684\u91cf\u662f\u7ed3\u6784\u4e2d\u753b\u51fa\u7684\u4ef7\u7535\u5b50\u603b\u6570\uff0c\u5b83\u7b49\u4e8e $\\sum N_v$ \u51cf\u53bb\u8be5\u7269\u79cd\u7684\u7535\u8377 $z$\u3002\u56e0\u6b64 $\\sum q_F = z$\u3002\n32|\\end{proof}\n33|=\n34|\\begin{method}[\u753b\u8def\u6613\u65af\u7ed3\u6784]\\label{met:b1:lewis-resonance-vsepr:lewis}\n35|\u753b\u5206\u5b50\u6216\u79bb\u5b50\u7684\u8def\u6613\u65af\u7ed3\u6784\uff0c\u6b65\u9aa4\u5982\u4e0b\uff1a\n36|\\begin{enumerate}\n37|  \\item \u8ba1\u7b97\u4ef7\u7535\u5b50\u6570 $N = \\sum N_v - z$ \u53ca\u7535\u5b50\u5bf9\u6570 $N/2$\uff1b\n38|  \\item \u753b\u51fa\u9aa8\u67b6\uff1a\u7535\u8d1f\u6027\u6700\u5c0f\u7684\u539f\u5b50\uff08\u6c22\u9664\u5916\uff09\u901a\u5e38\u5c45\u4e2d\uff1b\u6c22\u548c\u6c1f\u603b\u662f\u5904\u4e8e\u7aef\u4f4d\uff1b\n39|        \\item \u7528\u5b64\u7535\u5b50\u5bf9\u8865\u5168\u7aef\u4f4d\u539f\u5b50\u7684\u516b\u9685\u4f53\uff0c\u7136\u540e\u5c06\u5269\u4f59\u7535\u5b50\u5bf9\u653e\u5728\u4e2d\u5fc3\u539f\u5b50\u4e0a\uff1b\n40|  \\item \u82e5\u4e2d\u5fc3\u539f\u5b50\u7f3a\u5c11\u516b\u9685\u4f53\uff0c\u5219\u5c06\u5176\u76f8\u90bb\u539f\u5b50\u7684\u5b64\u7535\u5b50\u5bf9\u8f6c\u5316\u4e3a\u591a\u91cd\u952e\uff1b\n41|  \\item \u8ba1\u7b97\u5f62\u5f0f\u7535\u8377\uff1b\u5728\u53ef\u80fd\u7684\u7ed3\u6784\u4e2d\uff0c\u4f18\u5148\u9009\u62e9\u5f62\u5f0f\u7535\u8377\u6700\u5c11\u7684\uff0c\u4e14\u8d1f\u7535\u8377\u4f4d\u4e8e\u7535\u8d1f\u6027\u6700\u5927\u7684\u539f\u5b50\u4e0a\u3002\n42|\\end{enumerate}\n43|\\end{method}\n44|=\n45|\\begin{example}[\u785d\u9178]\\label{ex:b1:lewis-resonance-vsepr:hno3}\n46|\\ce{HNO3}\uff1a$N = 1 + 5 + 3 \\times 6 = 24$ \u4e2a\u7535\u5b50\uff0c\u5373 12 \u5bf9\u3002\u9aa8\u67b6\uff1a\u6c2e\u5c45\u4e2d\uff0c\u4e0e\u4e09\u4e2a\u6c27\u539f\u5b50\u76f8\u8fde\uff0c\u5176\u4e2d\u4e00\u4e2a\u6c27\u539f\u5b50\u8fde\u6709\u6c22\u3002\u82e5\u4ee5\u5355\u952e\u8865\u5168\u516b\u9685\u4f53\uff0c\u5219\u6c2e\u53ea\u6709\u516d\u4e2a\u7535\u5b50\uff1b\u5c06\u4e00\u4e2a\u6c27\u7684\u5b64\u7535\u5b50\u5bf9\u8f6c\u5316\u4e3a \\ce{N=O} \u952e\u3002\u5f62\u5f0f\u7535\u8377\uff1a\u6c2e\u4e3a $5 - 0 - 4 = +1$\uff1b\u4e0d\u8fde\u6c22\u7684\u5355\u952e\u6c27\u4e3a $6 - 6 - 1 = -1$\uff1b\u5176\u4f59\u4e3a 0\u3002\u603b\u7535\u8377\u4e3a 0\uff0c\u7b26\u5408\\cref{prop:b1:lewis-resonance-vsepr:formal-sum}\u7684\u8981\u6c42\u3002\n47|\\end{example}\n48|=\n49|\\begin{omfigure}\n50|\\setchemfig{atom sep=2.4em}\n51|\\begin{tikzpicture}[font=\\small]\n52|  \\node at (0,0) {\\large\\chemfig{H-\\charge{90=\\|,270=\\|}{O}-\\charge{90:2pt=$\\scriptstyle\\oplus$}{N}(=[:45]\\charge{0=\\|,90=\\|}{O})-[:-45]\\charge{0=\\|,240=\\|,300=\\|,45:3pt=$\\scriptstyle\\ominus$}{O}}};\n53|  \\node[below] at (0,-1.5) {\u785d\u9178\uff0c\\ce{HNO3}};\n54|  \\node at (5.2,0) {\\large\\chemfig{\\charge{180=\\|}{N}~\\charge{0=\\|}{N}}};\n55|  \\node[below] at (5.2,-1.5) {\u6c2e\u6c14\uff0c\\ce{N2}};\n56|  \\node at (9.6,0) {\\large\\chemfig{\\charge{135=\\|,225=\\|,90:2pt=$\\scriptstyle\\ominus$}{N}=\\charge{90:2pt=$\\scriptstyle\\oplus$}{N}=\\charge{45=\\|,315=\\|}{O}}};\n57|  \\node[below] at (9.6,-1.5) {\u4e00\u6c27\u5316\u4e8c\u6c2e\uff0c\\ce{N2O}};\n58|\\end{tikzpicture}\n59|=\n60|{\\small \u5e26\u5b64\u7535\u5b50\u5bf9\u4e0e\u5f62\u5f0f\u7535\u8377\u7684\u8def\u6613\u65af\u7ed3\u6784\u3002}\n61|\\end{omfigure}\n62|=\n63|\\section{\u8d85\u51fa\u516b\u9685\u4f53}\n64|=\n65|\\begin{definition}[\u7f3a\u7535\u5b50\u5206\u5b50\u4e0e\u8d85\u4ef7\u5206\u5b50]\\label{def:b1:lewis-resonance-vsepr:hypervalent}\n66|\u82e5\u5206\u5b50\u4e2d\u67d0\u539f\u5b50\u7684\u4ef7\u7535\u5b50\u5c11\u4e8e\u516b\u4e2a\uff0c\u5219\u79f0\u8be5\u5206\u5b50\u4e3a\\emph{\u7f3a\u7535\u5b50\u7684}\\index{\u7f3a\u7535\u5b50\u7684}\u5206\u5b50\uff1a\u5728 \\ce{BF3} \u4e2d\uff0c\u787c\u6709\u516d\u4e2a\u4ef7\u7535\u5b50\u3002\u82e5\u7b2c\u4e09\u5468\u671f\u53ca\u4ee5\u540e\u7684\u539f\u5b50\u5468\u56f4\u7684\u7535\u5b50\u5bf9\u591a\u4e8e\u56db\u5bf9\uff0c\u5219\u79f0\u8be5\u5206\u5b50\u4e3a\\emph{\u8d85\u4ef7\u7684}\\index{\u8d85\u4ef7\u7684}\u5206\u5b50\uff1a\u5728 \\ce{PCl5} \u4e2d\uff0c\u78f7\u5f62\u6210\u4e94\u6839\u952e\uff0c\u5728 \\ce{SF6} \u4e2d\uff0c\u786b\u5f62\u6210\u516d\u6839\u952e\u3002\u542b\u5947\u6570\u4e2a\u7535\u5b50\u7684\u5206\u5b50\uff0c\u4f8b\u5982 \\ce{NO} \u548c \\ce{NO2}\uff0c\u4e0d\u80fd\u4f7f\u6bcf\u4e2a\u539f\u5b50\u90fd\u6ee1\u8db3\u516b\u9685\u89c4\u5219\uff1a\u5176\u4e2d\u6709\u4e00\u4e2a\u7535\u5b50\u672a\u6210\u5bf9\u3002\n67|\\end{definition}\n68|=",
