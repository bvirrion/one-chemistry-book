\emph{\u5f62\u5f0f\u7535\u8377}\\index{\u5f62\u5f0f\u7535\u8377}\n41| \u4e3a\n42|\\[\n43|  q_F = N_v - N_{\\text{\u5b64\u5bf9}} - \\tfrac12 N_{\\text{\u6210\u952e}},\n44|\\]\n45| \u5176\u4e2d $N_v$ \u4e3a\u6e38\u79bb\u539f\u5b50\u7684\u4ef7\u7535\u5b50\u6570\uff0c\n46| $N_{\\text{\u5b64\u5bf9}}$ \u4e3a\u5176\u5b64\u7535\u5b50\u5bf9\u4e2d\u7684\u7535\u5b50\u6570\uff0c\n47| $N_{\\text{\u6210\u952e}}$ \u4e3a\u5b83\u6240\u5f62\u6210\u7684\u952e\u4e2d\u7684\u7535\u5b50\u6570\u3002\n48| \u5f53\u5176\u4e0d\u4e3a\u96f6\u65f6\uff0c\u4ee5 $\\oplus$ \u6216 $\\ominus$ \u5199\u5728\u8be5\u539f\u5b50\u65c1\u8fb9\u3002\n49|\\end{definition}\n50|=\n51|\\begin{proposition}[\u5f62\u5f0f\u7535\u8377\u4e4b\u548c\u7b49\u4e8e\u603b\u7535\u8377]\\label{prop:b1:lewis-resonance-vsepr:formal-sum}\n52| \u8def\u6613\u65af\u7ed3\u6784\u4e2d\u5404\u539f\u5b50\u7684\u5f62\u5f0f\u7535\u8377\u4e4b\u548c\uff0c\n53| \u7b49\u4e8e\u5206\u5b50\u6216\u79bb\u5b50\u7684\u603b\u7535\u8377\u3002\n54|\\end{proposition}\n55|=\n56|\\begin{proof}\n57| \u5bf9\u5404\u539f\u5b50\u7684 $q_F$ \u6c42\u548c\uff0c\u5f97 $\\sum N_v - (\\text{\u5b64\u7535\u5b50\u5bf9\u4e2d\u7684\n58| \u7535\u5b50\u6570} + \\text{\u952e\u4e2d\u7684\u7535\u5b50\u6570})$\uff0c\u8fd9\u662f\u56e0\u4e3a\u6bcf\u6839\u952e\u7684\u7535\u5b50\n59| \u5728\u5176\u4e24\u4e2a\u539f\u5b50\u4e0a\u5404\u8ba1\u4e00\u534a\u3002\u62ec\u53f7\u4e2d\u7684\u91cf\u662f\u7ed3\u6784\u4e2d\u753b\u51fa\u7684\n60| \u4ef7\u7535\u5b50\u603b\u6570\uff0c\u5b83\u7b49\u4e8e $\\sum N_v$ \u51cf\u53bb\u8be5\u7269\u79cd\u7684\u7535\u8377 $z$\uff0c\n61| \u56e0\u6b64 $\\sum q_F = z$\u3002\n62|\\end{proof}\n63|=\n64|\\begin{method}[\u753b\u8def\u6613\u65af\u7ed3\u6784]\\label{met:b1:lewis-resonance-vsepr:lewis}\n65| \u753b\u51fa\u5206\u5b50\u6216\u79bb\u5b50\u7684\u8def\u6613\u65af\u7ed3\u6784\uff0c\u6b65\u9aa4\u5982\u4e0b\uff1a\n66|\\begin{enumerate}\n67|  \\item \u8ba1\u7b97\u4ef7\u7535\u5b50\u6570 $N = \\sum N_v - z$ \u53ca\u7535\u5b50\u5bf9\u6570 $N/2$\uff1b\n68|  \\item \u753b\u51fa\u9aa8\u67b6\uff1a\u7535\u8d1f\u6027\u6700\u5c0f\u7684\u539f\u5b50\uff08\u6c22\u9664\u5916\uff09\u901a\u5e38\u5c45\u4e2d\uff1b\n69|        \u6c22\u548c\u6c1f\u603b\u662f\u5904\u4e8e\u7aef\u4f4d\uff1b\n70|  \\item \u7528\u5b64\u7535\u5b50\u5bf9\u8865\u5168\u7aef\u4f4d\u539f\u5b50\u7684\u516b\u9685\u4f53\uff0c\u7136\u540e\n71|        \u5c06\u5269\u4f59\u7535\u5b50\u5bf9\u653e\u5728\u4e2d\u5fc3\u539f\u5b50\u4e0a\uff1b\n72|  \\item \u82e5\u4e2d\u5fc3\u539f\u5b50\u7f3a\u5c11\u516b\u9685\u4f53\uff0c\u5219\u5c06\u5176\u76f8\u90bb\u539f\u5b50\u7684\u5b64\u7535\u5b50\u5bf9\n73|        \u8f6c\u5316\u4e3a\u591a\u91cd\u952e\uff1b\n74|  \\item \u8ba1\u7b97\u5f62\u5f0f\u7535\u8377\uff1b\u5728\u53ef\u80fd\u7684\u7ed3\u6784\u4e2d\uff0c\u4f18\u5148\u9009\u62e9\n75|        \u5f62\u5f0f\u7535\u8377\u6700\u5c11\u3001\u4e14\u8d1f\u7535\u8377\u4f4d\u4e8e\n76|        \u7535\u8d1f\u6027\u6700\u5927\u7684\u539f\u5b50\u4e0a\u7684\u7ed3\u6784\u3002\n77|\\end{enumerate}\n78|\\end{method}\n79|=\n80|\\begin{example}[\u785d\u9178]\\label{ex:b1:lewis-resonance-vsepr:hno3}\n81| \\ce{HNO3}\uff1a$N = 1 + 5 + 3 \\times 6 = 24$ \u4e2a\u7535\u5b50\uff0c\u5373 12 \u5bf9\u3002\u9aa8\u67b6\uff1a\n82| \u6c2e\u5c45\u4e2d\uff0c\u4e0e\u4e09\u4e2a\u6c27\u539f\u5b50\u76f8\u8fde\uff0c\u5176\u4e2d\u4e00\u4e2a\u6c27\u539f\u5b50\u8fde\u6709\u6c22\u3002\n83| \u82e5\u4ee5\u5355\u952e\u8865\u5168\u516b\u9685\u4f53\uff0c\u5219\u6c2e\u53ea\u6709\u516d\u4e2a\u7535\u5b50\uff1b\n84| \u5c06\u4e00\u4e2a\u6c27\u7684\u5b64\u7535\u5b50\u5bf9\u8f6c\u5316\u4e3a \\ce{N=O} \u952e\u3002\u5f62\u5f0f\u7535\u8377\uff1a\u6c2e\u4e3a\n85| $5 - 0 - 4 = +1$\uff1b\u4e0d\u8fde\u6c22\u7684\u5355\u952e\u6c27\u4e3a\n86| $6 - 6 - 1 = -1$\uff1b\u5176\u4f59\u4e3a 0\u3002\u603b\u7535\u8377\u4e3a 0\uff0c\u7b26\u5408\n87| \\cref{prop:b1:lewis-resonance-vsepr:formal-sum}\u7684\u8981\u6c42\u3002\n88|=\n89|=\n90|=\n91|=\n92|=\n93|=\n94|  \\node[below] at (0,-1.5) {\u785d\u9178\uff0c\\ce{HNO3}};\n95|=\n96|  \\node[below] at (5.2,-1.5) {\u6c2e\u6c14\