 "result": "1| \\chapter{\u5149\u8c31\u4e0e\u7ed3\u6784}\\label{ch:b1:structure-spectroscopy}\n2|=\n3| \u4e00\u4f4d\u8c03\u9999\u5e08\u4ea4\u7ed9\u5b9e\u9a8c\u5ba4\u4e00\u74f6\u65e0\u8272\u6db2\u4f53\uff0c\u95fb\u8d77\u6765\u6709\u83e0\u841d\u9999\u5473\uff0c\u5e76\u95ee\u8fd9\u662f\u4ec0\u4e48\u3002\u4e94\u5341\u5e74\u524d\uff0c\u8981\u56de\u7b54\u8fd9\u4e2a\u95ee\u9898\u9700\u8981\u6570\u5468\u7684\u964d\u89e3\u53cd\u5e94\u3002\u5982\u4eca\u53ea\u9700\u5341\u5206\u949f\uff1a\u5143\u7d20\u5206\u6790\u7ed9\u51fa\u5316\u5b66\u5f0f\uff0c\u7ea2\u5916\u5149\u8c31\u786e\u5b9a\u5b98\u80fd\u56e2\uff0c\u8d28\u5b50\u6838\u78c1\u5171\u632f\u8c31\u663e\u793a\u539f\u5b50\u4e4b\u95f4\u7684\u8fde\u63a5\u65b9\u5f0f\u3002\u672c\u7ae0\u8bb2\u89e3\u5982\u4f55\u8bfb\u53d6\u6bcf\u4e00\u79cd\u5149\u8c31\u2014\u2014\u4e0d\u540c\u6ce2\u6bb5\u7684\u5149\u5bf9\u5206\u5b50\u6709\u4f55\u4f5c\u7528\uff0c\u5149\u8c31\u4e2d\u7684\u54ea\u4e9b\u7279\u5f81\u5bf9\u5e94\u54ea\u4e00\u90e8\u5206\u7ed3\u6784\u2014\u2014\u6700\u540e\u4ee5\u8fd9\u4e2a\u83e0\u841d\u5206\u5b50\u4f5c\u7ed3\u3002\n4|=\n5| \\begin{recall}\n6| \u5b66\u6821\u5206\u518c\uff08\u5341\u4e00\u3001\u5341\u4e8c\u5e74\u7ea7\uff09\u7528\u5206\u5149\u5149\u5ea6\u8ba1\u6d4b\u91cf\u5438\u5149\u5ea6\uff0c\u5229\u7528\u6bd4\u5c14\u2013\u6717\u4f2f\u5b9a\u5f8b\u6c42\u6d53\u5ea6\uff0c\u4f9d\u636e\u7ea2\u5916\u5438\u6536\u8c31\u5e26\u8868\u8bc6\u522b\u5b98\u80fd\u56e2\uff0c\u5e76\u8bfb\u53d6\u7b80\u5355\u7684\u8d28\u5b50\u6838\u78c1\u5171\u632f\u8c31\uff08\u5cf0\u7684\u6570\u76ee\u3001\u79ef\u5206\u9762\u79ef\u3001$n + 1$ \u89c4\u5219\uff09\u3002\u5355\u952e\u3001\u53cc\u952e\u3001\u4e09\u952e\u4ee5\u53ca $\\pi$ \u952e\uff0c\u89c1\\cref{ch:b1:lewis-resonance-vsepr}\u3002\n7| \\end{recall}\n8|=\n9| \\section{\u7d2b\u5916\u2013\u53ef\u89c1\u5149\u8c31\uff1a\u5171\u8f6d\u4e0e\u989c\u8272}\n10|=\n11| \\begin{definition}[\u5438\u5149\u5ea6\u4e0e\u6bd4\u5c14\u2013\u6717\u4f2f\u5b9a\u5f8b]\\label{def:b1:structure-spectroscopy:absorbance}\n12| \u8bbe\u5f3a\u5ea6\u4e3a $I_0$ \u7684\u5149\u5c04\u5165\u6eb6\u6db2\uff0c\u5c04\u51fa\u65f6\u5f3a\u5ea6\u4e3a $I$\uff0c\u79f0 $A = \\log(I_0/I)$ \u4e3a\\emph{\u5438\u5149\u5ea6}\\index{\u5438\u5149\u5ea6}\u3002\u5bf9\u4e8e\u53ea\u542b\u4e00\u79cd\u5438\u5149\u7269\u8d28\u7684\u7a00\u6eb6\u6db2\uff0c\u6709 $A = \\varepsilon\\,\\ell\\,c$\uff08\u6bd4\u5c14\u2013\u6717\u4f2f\u5b9a\u5f8b\uff09\uff0c\u5176\u4e2d $\\ell$ \u4e3a\u5149\u7a0b\uff0c$c$ \u4e3a\u6d53\u5ea6\uff0c$\\varepsilon$ \u4e3a\\emph{\u6469\u5c14\u5438\u5149\u7cfb\u6570}\\index{\u6469\u5c14\u5438\u5149\u7cfb\u6570}\uff0c\u662f\u8be5\u7269\u8d28\u5728\u8be5\u6ce2\u957f\u4e0b\u7684\u6027\u8d28\u3002\n13| \\end{definition}\n14|=\n15| \u5206\u5b50\u5438\u6536\u7d2b\u5916\u5149\u6216\u53ef\u89c1\u5149\uff0c\u5f53\u5149\u5b50\u80fd\u91cf\u4e0e\u5176\u5316\u5b66\u952e\u4e2d\u88ab\u5360\u636e\u7684\u6700\u9ad8\u80fd\u7ea7\u548c\u6700\u4f4e\u7a7a\u80fd\u7ea7\u4e4b\u95f4\u7684\u80fd\u9699\u76f8\u7b49\u65f6\u53d1\u751f\u3002$\\sigma$ \u952e\u7684\u80fd\u9699\u5f88\u5927\uff0c\u5438\u6536\u4f4d\u4e8e\u8fdc\u7d2b\u5916\u533a\uff1b$\\pi$ \u952e\u7684\u5438\u6536\u66f4\u63a5\u8fd1\u53ef\u89c1\u5149\u533a\uff1b\u7531\u53cc\u952e\u548c\u5355\u952e\u4ea4\u66ff\u6784\u6210\u7684\u94fe\uff0c\u94fe\u8d8a\u957f\uff0c\u5438\u6536\u6ce2\u957f\u8d8a\u957f\u3002\n16|=\n17| \\begin{definition}[\u5171\u8f6d\u4f53\u7cfb\u3001\u53d1\u8272\u56e2\u3001\u6700\u5927\u5438\u6536\u6ce2\u957f]\\label{def:b1:structure-spectroscopy:conjugation}\n18| \\emph{\u5171\u8f6d\u4f53\u7cfb}\\index{\u5171\u8f6d\u4f53\u7cfb}\u662f\u7531\u539f\u5b50\u7ec4\u6210\u7684\u94fe\uff0c\u5176\u4e2d\u6bcf\u4e2a\u539f\u5b50\u90fd\u5728 $\\pi$ \u4f53\u7cfb\u4e2d\u5e26\u6709\u4e00\u4e2a $p$ \u8f68\u9053\uff0c\u5982\u53cc\u952e\u4e0e\u5355\u952e\u4ea4\u66ff\u6392\u5217\uff08\u5982 1,3-\u4e01\u4e8c\u70ef\u3001\u82ef\uff09\u3002\u5f15\u8d77\u67d0\u4e00\u5438\u6536\u7684\u539f\u5b50\u56e2\u79f0\u4e3a\u5176\\emph{\u53d1\u8272\u56e2}\\index{\u53d1\u8272\u56e2}\uff1b\u5438\u5149\u5ea6