 "result": "120| \\begin{method}[\u6307\u5b9a \\texorpdfstring{\\cip{R}}{(R)} \u6216 \\texorpdfstring{\\cip{S}}{(S)}]\\label{met:b1:stereochemistry-in-depth:cip}\n121|=\n122|   \\item \u6309 CIP \u89c4\u5219\u5bf9\u56db\u4e2a\u53d6\u4ee3\u57fa\u6392\u5e8f\u3002\n123|   \\item \u82e5\u4f18\u5148\u7ea7\u6700\u4f4e\u7684\u53d6\u4ee3\u57fa\u80cc\u79bb\u89c2\u5bdf\u8005\uff08\u865a\u6954\u5f62\u952e\uff0c\u6216\u8d39\u6b47\u5c14\u6295\u5f71\u5f0f\u4e2d\u7684\u7ad6\u76f4\u952e\uff09\uff0c\n124|         \u5219\u76f4\u63a5\u8bfb\u53d6\n125|         $1 \\to 2 \\to 3$ \u7684\u8f6c\u5411\u3002\n126|   \\item \u82e5\u5176\u6307\u5411\u89c2\u5bdf\u8005\uff08\u5b9e\u6954\u5f62\u952e\uff0c\u6216\u8d39\u6b47\u5c14\u6295\u5f71\u5f0f\u4e2d\u7684\u6c34\u5e73\u952e\uff09\uff0c\n127|         \u5219\u8bfb\u53d6\u8f6c\u5411\uff0c\u5e76\u5c06\u63cf\u8ff0\u7b26\u5bf9\u8c03\u3002\n128|   \\item \u4ea4\u6362\u4efb\u610f\u4e24\u4e2a\u53d6\u4ee3\u57fa\u4f1a\u4f7f\u63cf\u8ff0\u7b26\u53cd\u8f6c\uff1a\n129|         \u8fd9\u662f\u4e00\u79cd\u5feb\u901f\u68c0\u9a8c\u7684\u529e\u6cd5\u3002\n130|=\n131| \u5bf9\u4e8e\u4e73\u9178\uff0c$\\ce{OH} > \\ce{COOH} > \\ce{CH3} > \\ce{H}$\uff08\u5148\u6bd4\u8f83 O\uff1b\n132| C(O,O,O) \u80dc\u8fc7 C(H,H,H)\uff09\u3002\u4e0a\u56fe\u7684\u8d39\u6b47\u5c14\u6295\u5f71\u5f0f\u4e2d\uff0cH \u4e3a\u6c34\u5e73\u952e\n133| \uff08\u6307\u5411\u89c2\u5bdf\u8005\uff09\uff0c$\\ce{OH} \\to \\ce{COOH} \\to \\ce{CH3}$ \u9006\u65f6\u9488\u8f6c\u52a8\uff0c\n134| \u53d6\u53cd\u540e\uff0c\u8be5\u4e2d\u5fc3\u4e3a \\cip{R}\u3002\n135| \\end{method}\n136|=\n137| \\section{\u624b\u6027\u53ca\u5176\u5f71\u54cd}\n138|=\n139| \\begin{definition}[\u7acb\u4f53\u4e2d\u5fc3\uff0c\u624b\u6027]\\label{def:b1:stereochemistry-in-depth:stereocentre}\n140| \u82e5\u4e00\u4e2a\u7269\u4f53\u4e0d\u80fd\u4e0e\u5176\u955c\u50cf\u53e0\u5408\uff0c\u5219\u79f0\u5b83\u662f\\emph{\u624b\u6027}\\index{\u624b\u6027}\u7684\uff0c\n141| \u5426\u5219\u79f0\u4e3a\\emph{\u975e\u624b\u6027\u7684}\\index{\u975e\u624b\u6027\u7684}\uff1b\u8fd9\u4e00\u6027\u8d28\u79f0\u4e3a\n142| \\emph{\u624b\u6027}\\index{\u624b\u6027}\u3002\\emph{\u7acb\u4f53\u4e2d\u5fc3}\\index{\u7acb\u4f53\u4e2d\u5fc3}\u662f\u8fd9\u6837\u4e00\u79cd\u539f\u5b50\uff1a\n143| \u4ea4\u6362\u5176\u4e0a\u4e24\u4e2a\u53d6\u4ee3\u57fa\u53ef\u5f97\u7acb\u4f53\u5f02\u6784\u4f53\uff1b\n144| \u4f8b\u5982\uff0c\u56db\u4e2a\u53d6\u4ee3\u57fa\u4e92\u4e0d\u76f8\u540c\u7684\u56db\u9762\u4f53\u5f62\u78b3\u539f\u5b50\uff0c\n145| \u5373\u4e3a\u4e00\u4e2a\u7acb\u4f53\u4e2d\u5fc3\u3002\n146| \\end{definition}\n147|=\n148| \u5177\u6709\u5bf9\u79f0\u9762\u6216\u5bf9\u79f0\u4e2d\u5fc3\u7684\u5206\u5b50\u662f\u975e\u624b\u6027\u7684\uff1b\n149| \u4e24\u8005\u7686\u65e0\u7684\u5206\u5b50\uff0c\u5728\u5b9e\u9645\u4e2d\u901a\u5e38\u662f\u624b\u6027\u7684\u3002\u4e25\u683c\u5224\u636e\u4ee5\u5bf9\u79f0\u64cd\u4f5c\u8868\u8ff0\uff0c\n150| \u89c1\u672c\u79d1\u4e09\u5e74\u7ea7\u5206\u518c\u3002\n151|=\n152| \\begin{definition}[\u5bf9\u6620\u5f02\u6784\u4f53\uff0c\u975e\u5bf9\u6620\u5f02\u6784\u4f53\uff0c\u5185\u6d88\u65cb\u5316\u5408\u7269\uff0c\u5916\u6d88\u65cb\u6df7\u5408\u7269]\\label{def:b1:stereochemistry-in-depth:enantiomers}\n153| \u4e92\u4e3a\u955c\u50cf\u7684\u4e24\u79cd\u7acb\u4f53\u5f02\u6784\u4f53\u79f0\u4e3a\n154| \\emph{\u5bf9\u6620\u5f02\u6784\u4f53}\\index{\u5bf9\u6620\u5f02\u6784\u4f53}\uff1b\u5f7c\u6b64\u4e0d\u4e3a\u955c\u50cf\u7684\u7acb\u4f53\u5f02\u6784\u4f53\u79f0\u4e3a\n155| \\emph{\u975e\u5bf9\u6620\u5f02\u6784\u4f53}\\index{\u975e\u5bf9\u6620\u5f02\u6784\u4f53}\u3002\u4e00\u79cd\u5177\u6709\u7acb\u4f53\u4e2d\u5fc3\u800c\u975e\u624b\u6027\u7684\n156| \u5316\u5408\u7269\u79f0\u4e3a\\emph{\u5185\u6d88\u65cb\u5316\u5408\u7269}\\index{\u5185\u6d88\u65cb\u5316\u5408\u7269}\u3002\n157| \u7b49\u7269\u8d28\u7684\u91cf\u7684\u4e24\u79cd\u5bf9\u6620\u5f02\u6784\u4f53\u7684\u6df7\u5408\u7269\u79f0\u4e3a\n158| \\emph{\u5916\u6d88\u65cb\u6df7\u5408\u7269}\\index{\u5916\u6d88\u65cb\u6df7\u5408\u7269}\u3002\n159| \\end{definition}\n160|=\n161| \\begin{proposition}[\u7acb\u4f53\u5f02\u6784\u4f53\u7684\u6570\u76ee]\\label{prop:b1:stereochemistry-in-depth:max-stereoisomers}\n162| \u542b $n$ \u4e2a\u7acb\u4f53\u4e2d\u5fc3\uff08\u4e14\u65e0\u5176\u4ed6\u7acb\u4f53\u5355\u5143\uff09\u7684\u5206\u5b50\uff0c\n163| \u81f3\u591a\u6709 $2^n$ \u79cd\u7acb\u4f53\u5f02\u6784\u4f53\uff0c\u81f3\u591a\u7ec4\u6210 $2^{n-1}$ \u5bf9\n164| \u5bf9\u6620\u5f02\u6784\u4f53\uff1b\u5b58\u5728\u5185\u6d88\u65cb\u5316\u5408\u7269\u65f6\uff0c\u6570\u76ee\u66f4\u5c11\u3002\n165| \\end{proposition}\n166|=\n167| \\begin{proof}\n168| \u6bcf\u4e2a\u4e2d\u5fc3\u72ec\u7acb\u5730\u53d6 \\cip{R} \u6216 \\cip{S}\uff0c\u5171\u6709 $2^n$ \u79cd\u7ec4\u5408\u3002\n169| \u955c\u50cf\u4f1a\u6539\u53d8\u6bcf\u4e2a\u63cf\u8ff0\u7b26\uff0c\u56e0\u6b64\u8fd9\u4e9b\u7ec4\u5408\u4e24\u4e24\u914d\u5bf9\uff0c\n170| \u5f62\u6210 $2^{n-1}$ \u5bf9\u5bf9\u6620\u5f02\u6784\u4f53\u3002\u82e5\u67d0\u4e00\u7ec4\u5408\u7ecf\u5206\u5b50\u8f6c\u52a8\u540e\u4e0e\u81ea\u8eab\u7684\u955c\u50cf\u91cd\u5408\uff08\u5373\u5185\u6d88\u65cb\u4f53\uff09\uff0c\n171| \u5219\u5176\u6240\u5728\u7684\u4e00\u5bf9\n172| \u7f29\u5e76\u4e3a\u4e00\u79cd\u5316\u5408\u7269\u3002\n173| \\end{proof}\n174|=\n175| \u9152\u77f3\u9178 \\ce{HOOC-CH(OH)-CH(OH)-COOH} \u5177\u6709\u4e24\u4e2a\u7b49\u4ef7\u7684\u4e2d\u5fc3\uff1a\n176| \\cip{R,R} \u4e0e \\cip{S,S} \u4e92\u4e3a\u5bf9\u6620\u5f02\u6784\u4f53\uff0c\u800c \\cip{R,S} \u5728\u4e24\u4e2a\u78b3\u539f\u5b50\u4e4b\u95f4\n177| \u6709\u4e00\u4e2a\u5bf9\u79f0\u9762\uff0c\u4e3a\u5185\u6d88\u65cb\u5316\u5408\u7269\uff0c\u5171\u4e09\u79cd\u7acb\u4f53\u5f02\u6784\u4f53\uff0c\u800c\u975e\u56db\u79cd\u3002\n178|=\n179| \\begin{proposition}[\u5bf9\u6620\u5f02\u6784\u4f53\u7684\u6027\u8d28]\\label{prop:b1:stereochemistry-in-depth:enantiomer-properties}\n180| \u4e00\u5bf9\u5bf9\u6620\u5f02\u6784\u4f53\u7684\u7194\u70b9\u548c\u6cb8\u70b9\u76f8\u540c\uff0c\u5728\u975e\u624b\u6027\u6eb6\u5242\u4e2d\u7684\u6eb6\u89e3\u5ea6\uff0c\n181| \u5149\u8c31\u4ee5\u53ca\u4e0e\u975e\u624b\u6027\u8bd5\u5242\u7684\u53cd\u5e94\u6d3b\u6027\u4e5f\u76f8\u540c\uff1b\n182| \u4e8c\u8005\u5bf9\u504f\u632f\u5149\u7684\u4f5c\u7528\u4e0d\u540c\uff0c\u4e0e\u5176\u4ed6\u624b\u6027\u5206\u5b50\u7684\u76f8\u4e92\u4f5c\u7528\n183| \u4e5f\u4e0d\u540c\u3002\u975e\u5bf9\u6620\u5f02\u6784\u4f53\u7684\n184| \u5404\u9879\u6027\u8d28\u5747\u4e0d\u76f8\u540c\u3002\n185| \\end{proposition}\n186|=\n187| \\begin{proof}\n188| \u51e1\u53ea\u4f9d\u8d56\u4e8e\u5206\u5b50\u5185\u90e8\uff0c\u6216\u5206\u5b50\u4e0e\u975e\u624b\u6027\u4f19\u4f34\u4e4b\u95f4\u7684\u8ddd\u79bb\u4e0e\u89d2\u5ea6\u7684\u6027\u8d28\uff0c\n189| \u5bf9\u7269\u4f53\u53ca\u5176\u955c\u50cf\u90fd\u76f8\u540c\uff0c\n190| \u56e0\u4e3a\u53cd\u5c04\u4fdd\u6301\u8ddd\u79bb\u4e0e\u89d2\u5ea6\u4e0d\u53d8\u3002\n191| \u624b\u6027\u4f19\u4f34\uff08\u5982\u53d7\u4f53\u3001\u624b\u6027\u8bd5\u5242\uff0c\u6216\u4e0b\u6587\u6240\u8ff0\u504f\u632f\u5149\u7684\u87ba\u65cb\u8def\u5f84\uff09\n192| \u6240\u5f62\u6210\u7684\u914d\u5bf9\u662f\u975e\u5bf9\u6620\u7684\uff0c\u4e0d\u518d\u4e92\u4e3a\u955c\u50cf\uff0c\u56e0\u800c\u6027\u8d28\u6709\u6240\u4e0d\u540c\u3002\n193| \u975e\u5bf9\u6620\u5f02\u6784\u4f53\u4e0d\u80fd\u7531\u4efb\u4f55\u53cd\u5c04\u76f8\u4e92\u5f97\u5230\uff1a\n194| \u5b83\u4eec\u7684\u5185\u90e8\u8ddd\u79bb\u5e76\u4e0d\u76f8\u540c\u3002\n195| \\end{proof}\n196|=\n197| \\begin{omfigure}\n198| \\begin{tikzpicture}[font=\\small, line join=round]\n199|=\n200|=\n201|=\n202|=\n203|=\n204|=\n205|=\n206|=\n207|=\n208|=\n209|=\n210|=\n211|=\n212|=\n213|=\n214|=\n215|=\n216|=\n217|=\n218|=\n219|=\n220|=\n221|=\n222| \\end{tikzpicture}\n223|=\n224| {\\small \u4e24\u79cd\u9999\u82b9\u916e\u6309\u540c\u4e00\u9aa8\u67b6\u7ed8\u51fa\uff1aC5 \u4e0a\u7684\u5f02\u4e19\u70ef\u57fa\n225| \u5728\u5176\u4e2d\u4e00\u79cd\u4e2d\u6307\u5411\u8bfb\u8005\uff08\u5b9e\u6954\u5f62\u952e\uff09\uff0c\u5728\u53e6\u4e00\u79cd\u4e2d\u80cc\u79bb\u8bfb\u8005\uff08\u865a\u6954\u5f62\u952e\uff09\uff0c\n226| C5 \u4e0a\u7684