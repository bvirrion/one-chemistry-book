{"sha": "9a4d953d8ec401ac9d5d2d3c7ac6f17af2835e213474507dba490b59d6a751dd", "body": [" \\section*{第 \\ref{ch:g9:periodic-table-first-look} 章 --- 元素周期表初探}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:1}", "按原子序数 $Z$ 从小到大排列。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:2}", "碳：第 2 周期，第 14 族。镁：第 3 周期，第 2 族。氩：", "第 3 周期，第 18 族。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:3}", "金属：铁、铜、铝。非金属：硫、氧、氯。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:4}", "钾（\\ce{K}）位于钠的下方；溴（\\ce{Br}）位于氯的下方。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:5}", "钙（\\ce{Ca}，$Z = 20$）和氮（\\ce{N}，$Z = 7$）。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:6}", "它与钠同族，即第 1 族，同族元素", "性质相似。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:7}", "金属：有光泽，能导电，并形成带正电荷的离子。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:8}", "为使性质相似的元素位于同一列，", "即使这意味着要留出空格。空格是预测：", "缺失的元素后来被找到，其性质与他所描述的一致。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:9}", "碳：$\\ce{C} = 12$；氧：$\\ce{O} = 16$。空位“? $= 68$”（旁边是", "Al $= 27.4$）和“? $= 70$”（旁边是 Si $= 28$）。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:10}", "第 2 周期：8 种元素（锂到氖）。第 4 周期：18 种元素（钾", "到氪）。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:11}", "第 18 族。需要不发生反应的场合：灯泡中的氩气和", "焊接用的保护气，气球中的氦气（它不燃烧）。", "\\end{solution}", "", "\\begin{solution}{exo:g9:periodic-table-first-look:12}", "$(27.0 + 114.8)/2 = 70.9$，接近 69.7。", "\\end{solution}", "", "\\begin{solution}{pb:g9:periodic-table-first-look:1}", "\\textbf{1.} $Z = 32$；第 4 周期，第 14 族。", "", "\\textbf{2.} 上方：硅。下方：锡。左侧：镓。右侧：砷。", "", "\\textbf{3.} 类金属。", "", "\\textbf{4.} 它与硅同族，同族元素", "性质相似。", "", "\\textbf{5.} $(28.1 + 118.7)/2 = 73.4$。", "", "\\textbf{6.} $(69.7 + 74.9)/2 = 72.3$。", "", "\\textbf{7.} 左--右的平均值（72.3）：沿周期方向，原子量", "随元素序号逐个稳定增加；而沿族向下，原子量", "则以较大的跳跃增加。", "", "\\textbf{8.} $72.6 - 70 = 2.6$。", "", "\\textbf{9.} $(28.1 + 118.7 + 69.7 + 74.9)/4 = 291.4/4 = 72.85$，即", "72.9。", "", "\\textbf{10.} 平均值 72.9 与门捷列夫的 72 及", "温克勒的 72.3 都很接近（也接近今天的 72.6）。", "", "\\textbf{11.} 一种元素在人们见到它之前已被预言，后来被发现时，", "其性质与预言相符。元素周期表不仅是一张清单，", "它还能做出预测。", "", "\\textbf{12.} 约 72.9。", "\\end{solution}", ""]}