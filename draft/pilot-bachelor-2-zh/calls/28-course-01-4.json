 "result": "\\chapter{\u9006\u5408\u6210\u5206\u6790\u4e0e\u591a\u6b65\u7b56\u7565}\\label{ch:b2:retrosynthesis}\n=\n\u9ed1\u677f\u4e0a\u753b\u7740\u4e00\u4e2a\u5206\u5b50\uff0c\u5374\u6ca1\u6709\u4eba\u77e5\u9053\u5982\u4f55\u5236\u5907\u5b83\u3002\u82e5\u4ece\u67b6\u4e0a\u73b0\u6709\u7684\n\u7269\u8d28\u51fa\u53d1\u6b63\u5411\u5c1d\u8bd5\u5404\u79cd\u53cd\u5e94\uff0c\u6beb\u65e0\u5934\u7eea\uff0c\u56e0\u4e3a\u53ef\u80fd\u6027\u592a\u591a\u3002\u5316\u5b66\u5bb6\u5219\n\u53cd\u5176\u9053\u800c\u884c\u4e4b\uff0c\u4ece\u76ee\u6807\u5206\u5b50\u51fa\u53d1\uff0c\u5728\u7eb8\u4e0a\u9010\u6b21\u5207\u65ad\u4e00\u6839\u952e\uff0c\u56de\u6eaf\u81f3\u67b6\u4e0a\u7684\u7269\u8d28\uff0c\n\u6bcf\u4e00\u6b21\u5207\u65ad\u90fd\u76f8\u5f53\u4e8e\u64a4\u9500\u4e00\u4e2a\u5df2\u77e5\u53ef\u884c\u7684\u53cd\u5e94\uff0c\u76f4\u5230\u6240\u5f97\u7247\u6bb5\u90fd\u662f\u53ef\u4ee5\u8d2d\u4e70\u7684\u5316\u5408\u7269\u3002\u672c\u7ae0\n\u5c06\u524d\u51e0\u7ae0\u7684\u53cd\u5e94\u8f6c\u5316\u4e3a\u8fd9\u79cd\u9006\u5411\u63a8\u7406\uff0c\u5e76\u8fdb\u4e00\u6b65\u8ba8\u8bba\u5982\u4f55\u8bc4\u5224\u7531\u6b64\u5f97\u5230\u7684\u5408\u6210\u8def\u7ebf\u3002\n=\n=\n\\Cref{ch:b2:alkene-redox}\u81f3\\cref{ch:b2:wittig}\uff1a\u9700\u8981\u9006\u5411\u64a4\u9500\u7684\u53cd\u5e94\u3002\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\uff1a\n\u4fdd\u62a4\u57fa\u4e0e\u7f29\u919b\u3001\u683c\u6c0f\u8bd5\u5242\u4e0e\u6781\u6027\u53cd\u8f6c\u3001\u5a01\u5ec9\u68ee\u5408\u6210\u3001\n\u5316\u5b66\u9009\u62e9\u6027\u3001\u9187\u7684\u6c27\u5316\u3002\u7b2c 1 \u518c\uff1a\u539f\u5b50\u7ecf\u6d4e\u6027\u3002\n=\n=\n\\section{\u9006\u5411\u601d\u8003}\n=\n\\begin{definition}[\u9006\u5408\u6210\u5206\u6790]\\label{def:b2:retrosynthesis:analysis}\n\u5f85\u5236\u5907\u7684\u5206\u5b50\u79f0\u4e3a\\emph{\u76ee\u6807\u5206\u5b50}\\index{\u76ee\u6807\u5206\u5b50}\u3002\\emph{\u9006\u5408\u6210\u5206\u6790}\n\\index{\u9006\u5408\u6210\u5206\u6790}\u4ece\u76ee\u6807\u5206\u5b50\u51fa\u53d1\uff0c\u5012\u63a8\u81f3\u53ef\u7528\u7684\u8d77\u59cb\u539f\u6599\uff0c\n\u6bcf\u4e00\u6b65\u90fd\u662f\u67d0\u4e2a\u5df2\u77e5\u53cd\u5e94\u7684\u9006\u8fc7\u7a0b\uff1b\u4e00\u6b65\u9006\u5408\u6210\u6b65\u9aa4\u7528\u53cc\u7bad\u5934\n$\\Rightarrow$ \u8868\u793a\uff0c\u8bfb\u4f5c\u201c\u7531\u2026\u2026\u5236\u5f97\u201d\u3002\n=\n=\n\\begin{definition}[\u5207\u65ad\u4e0e\u5408\u6210\u5b50]\\label{def:b2:retrosynthesis:disconnection}\n\\emph{\u5207\u65ad}\\index{\u5207\u65ad}\u662f\u5bf9\u76ee\u6807\u5206\u5b50\u4e2d\u67d0\u4e00\u5316\u5b66\u952e\u7684\u5047\u60f3\u5207\u5272\uff0c\u5b83\u662f\n\u6210\u952e\u53cd\u5e94\u7684\u9006\u8fc7\u7a0b\u3002\u5f02\u88c2\u5207\u65ad\u4e00\u6839\u952e\u5f97\u5230\u4e24\u4e2a\\emph{\u5408\u6210\u5b50}\\index{\u5408\u6210\u5b50}\uff0c\n\u5373\u7406\u60f3\u5316\u7684\u5e26\u7535\u7247\u6bb5\uff1a\u4e00\u4e2a\u4e3a\u7ed9\u4f53\uff08\u4eb2\u6838\u6027\uff0c\u901a\u5e38\u5e26\u8d1f\u7535\uff09\uff0c\u53e6\u4e00\u4e2a\u4e3a\u53d7\u4f53\n\uff08\u4eb2\u7535\u6027\uff0c\u901a\u5e38\u5e26\u6b63\u7535\uff09\u3002\\emph{\u5408\u6210\u7b49\u4ef7\u7269}\\index{\u5408\u6210\u7b49\u4ef7\u7269}\u662f\u4e00\u79cd\u5b9e\u9645\u8bd5\u5242\uff0c\n\u5176\u4f5c\u7528\u4e0e\u5408\u6210\u5b50\u76f8\u5f53\uff1a\u78b3\u8d1f\u79bb\u5b50 \\ce{R-} \u7684\u5408\u6210\u7b49\u4ef7\u7269\u4e3a\u683c\u6c0f\u8bd5\u5242\uff0c\n\u78b3\u6b63\u79bb\u5b50 $\\mathrm{R\\overset{+}{C}H{-}OH}$ \u7684\u5408\u6210\u7b49\u4ef7\u7269\u4e3a\u919b\u3002\n=\n=\n\\begin{definition}[\u5b98\u80fd\u56e2\u8f6c\u6362]\\label{def:b2:retrosynthesis:fgi}\n\\emph{\u5b98\u80fd\u56e2\u8f6c\u6362}\\index{\u5b98\u80fd\u56e2\u8f6c\u6362}\uff08FGI\uff09\u662f\u4e00\u7c7b\u9006\u5408\u6210\u6b65\u9aa4\uff0c\n\u5b83\u6539\u53d8\u5b98\u80fd\u56e2\u800c\u4e0d\u6539\u53d8\u78b3\u9aa8\u67b6\uff0c\u4f8b\u5982\n\u7531\u916e\u8fd8\u539f\u5f97\u5230\u9187\uff0c\u7531\u70ef\u70c3\u6c22\u5316\u5f97\u5230\u70f7\u70c3\u94fe\uff0c\u7531\u9170\u80fa\u5f97\u5230\u80fa\u3002\n=\n=\n=\n=\n\\begin{tikzpicture}[every node/.style={align=center}]\n\\node (T) at (0,0) {\\setchemfig{atom sep=1.7em}\\chemfig{Ph-CH(-[2]OH)-CH(-[6]CH_3)-CH_3}};\n\\node (A) at (-4.6,-2.6) {\\ce{PhCHO}\\\\[1pt] + \\ce{(CH3)2CHMgBr}};\n\\node (B) at (0,-2.6) {\\ce{PhMgBr}\\\\[1pt] + \\ce{(CH3)2CHCHO}};\n\\node (C) at (4.6,-2.6) {\\setchemfig{atom sep=1.7em}\\chemfig{Ph-C(=[2]O)-CH(-[6]CH_3)-CH_3}};\n\\node (D) at (4.6,-5.0) {\\ce{C6H6}\\\\[1pt] + \\ce{(CH3)2CHCOCl}};\n\\draw[omretro] (T.south west) -- node[above left, font=\\small] {a} (A.north);\n\\draw[omretro] (T.south) -- node[right, font=\\small] {b} (B.north);\n\\draw[omretro] (T.south east) -- node[above right, font=\\small] {FGI} (C.north);\n\\draw[omretro] (C.south) -- node[right, font=\\small] {c} (D.north);\n\\end{tikzpicture}\n=\n=\n=\n{\\small 2-\u7532\u57fa-1-\u82ef\u57fa\u4e19-1-\u9187\u7684\u9006\u5408\u6210\u6811\u3002(a) \u4e0e (b)\uff1a\n\u9187\u78b3\u65c1 \\ce{C-C} \u952e\u7684\u4e24\u79cd\u5207\u65ad\uff0c\u5404\u5f97\u4e00\u4e2a\u919b\u548c\u4e00\u4e2a\u683c\u6c0f\u8bd5\u5242\u3002\u5b98\u80fd\u56e2\u8f6c\u6362\uff1a\n\u7531\u916e\u8fd8\u539f\u5f97\u5230\u9187\uff1b(c) \u7531\u82ef\u7ecf\u5085\u2013\u514b\u9170\u57fa\u5316\u5f97\u5230\u916e\u3002\u6bcf\u4e2a\u7bad\u5934\n\u5747\u8bfb\u4f5c\u201c\u7531\u2026\u2026\u5236\u5f97\u201d\u3002}\n=\n=\n\u6b64\u6811\u56fe\u4f53\u73b0\u4e86\u672c\u65b9\u6cd5\u7684\u51e0\u70b9\u89c4\u5f8b\u3002\u5207\u65ad\u5e94\u9009\u5728\u5b98\u80fd\u56e2\u65c1\u7684\u952e\u4e0a\uff0c\n\u56e0\u4e3a\u53cd\u5e94\u6b63\u662f\u5728\u8fd9\u4e9b\u4f4d\u7f6e\u6210\u952e\u7684\u3002\u6bcf\u6b21\u5207\u65ad\u90fd\u5e94\u5199\u51fa\u76f8\u5e94\u7684\u5408\u6210\u5b50\uff0c\n\u5e76\u4e3a\u5176\u627e\u5230\u5b9e\u9645\u7684\u8bd5\u5242\u3002\u6b64\u5916\uff0c\u7b54\u6848\u901a\u5e38\u4e0d\u6b62\u4e00\u4e2a\uff1a\u6811\u56fe\u4f1a\u5206\u652f\uff0c\u5404\u5206\u652f\n\u6700\u540e\u9700\u52a0\u4ee5\u8bc4\u5224\uff08\u89c1\\cref{sec:b2:retrosynthesis:judging}\uff09\u3002\n=\n=\n=\n=\n=\n=\n\u5408\u6210\u5b50 & \u7c7b\u578b & \u5408\u6210\u7b49\u4ef7\u7269 \\\\\n=\n\\ce{R-}\uff08\u70f7\u57fa\u3001\u82b3\u57fa\uff09 & \u7ed9\u4f53 & \\ce{RMgBr}\u3001\\ce{RLi}\u3001\\ce{R2CuLi}\uff08\u5171\u8f6d\u52a0\u6210\uff09 \\\\\n$\\mathrm{^-CH_2COR}$ & \u7ed9\u4f53 & \\ce{CH3COR} \u7684\u70ef\u9187\u8d1f\u79bb\u5b50\uff0c\u6216 3-\u6c27\u4ee3\u4e01\u9178\u4e59\u916f \\\\\n$\\mathrm{^-C{\\equiv}N}$ & \u7ed9\u4f53 & \\ce{NaCN} \\\\\n$\\mathrm{R\\overset{+}{C}H{-}OH}$ & \u53d7\u4f53 & \u919b \\ce{RCHO} \\\\\n$\\mathrm{R\\overset{+}{C}{=}O}$ & \u53d7\u4f53 & \u9170\u6c2f \\ce{RCOCl}\u3001\u916f \\\\\n\\ce{R+}\uff08\u4f2f\uff09 & \u53d7\u4f53 & \u5364\u4ee3\u70c3 \\ce{RBr}\uff08\u53cc\u5206\u5b50\u53d6\u4ee3\uff09 \\\\\n$\\mathrm{^+CH_2CH_2COR}$ & \u53d7\u4f53 & \u03b1,\u03b2-\u4e0d\u9971\u548c\u916e \\ce{CH2=CHCOR}\uff08\u5171\u8f6d\u52a0\u6210\uff09 \\\\\n=\n=\n=\n=\n{\\small \u5e38\u89c1\u7684\u5408\u6210\u5b50\u53ca\u5176\u5408\u6210\u7b49\u4ef7\u7269\u3002\u7ed9\u4f53\u5408\u6210\u5b50\u4e3a\u78b3\u8d1f\u79bb\u5b50\uff0c\n\u53d7\u4f53\u5408\u6210\u5b50\u4e3a\u78b3\u6b63\u79bb\u5b50\uff1b\u5b9e\u9645\u8bd5\u5242\u5177\u6709\u76f8\u540c\u7684\u6781\u6027\uff0c\u4f46\u4e0d\u5e26\u5b8c\u6574\u7535\u8377\u3002}\n=\n=\n\\section{\u5355\u5b98\u80fd\u56e2\u5207\u65ad}\n=\n\u5355\u5b98\u80fd\u56e2\u5207\u65ad\u9488\u5bf9\u4e0e\u5355\u4e2a\u5b98\u80fd\u56e2\u76f8\u90bb\u7684\u952e\u3002\u919a\u3001\u916f\u6216\u80fa\u4e2d\u7684 \\ce{C-O} \u952e\u6216 \\ce{C-N} \u952e\uff0c\n\u5207\u65ad\u5e94\u4f4d\u4e8e\u78b3\u4e0e\u6742\u539f\u5b50\u4e4b\u95f4\uff1a\u6742\u539f\u5b50\u4e3a\n\u7ed9\u4f53\uff0c\u78b3\u4e3a\u53d7\u4f53\uff08\u5206\u522b\u5bf9\u5e94\u5a01\u5ec9\u68ee\u5408\u6210\u3001\u916f\u5316\u4e0e\u9170\u80fa\u751f\u6210\uff09\u3002\n\u5bf9\u4e8e \\ce{C-C} \u952e\uff0c\u5b98\u80fd\u56e2\u51b3\u5b9a\u4e86\u5408\u6210\u5b50\u7684\u6781\u6027\uff1a\u4e0e\u9187\u78b3\u76f8\u90bb\u65f6\uff0c\n\u9187\u78b3\u4e3a\u53d7\u4f53\uff08\u5bf9\u5e94\u919b\u6216\u916e\uff09\uff0c\u53e6\u4e00\u7aef\u78b3\u4e3a\u7ed9\u4f53\uff08\u5bf9\u5e94\n\u6709\u673a\u91d1\u5c5e\u8bd5\u5242\uff09\uff1b\u4e0e\u7fb0\u57fa\u76f8\u90bb\u65f6\uff0c$\\alpha$ \u78b3\u4e3a\u7ed9\u4f53\uff08\u5bf9\u5e94\u70ef\u9187\u8d1f\u79bb\u5b50\uff09\u3002\n=\n\u8fd9\u4e9b\u53cd\u5e94\u5927\u591a\u9700\u8981\u5728\u6b63\u786e\u7684\u4f4d\u7f6e\u5177\u6709\u6b63\u786e\u7684\u6c27\u5316\u7ea7\u522b\uff0c\u56e0\u6b64\u4e24\u79cd\u6c27\u5316\u7ea7\u522b\u4e4b\u95f4\u7684\u5b98\u80fd\u56e2\u8f6c\u6362\n\u662f\u8def\u7ebf\u4e2d\u6700\u5e38\u89c1\u7684\u6b65\u9aa4\uff1a\u70ef\u70c3\u3001\u9187\u3001\u919b\u6216\u916e\u3001\u9178\u3002\u5176\u4e2d\u4e00\u79cd\n\u5728\u672c\u79d1\u4e00\u5e74\u7ea7\u5206\u518c\u4e2d\u672a\u89e3\u51b3\uff1a\u5982\u4f55\u4f7f\u4f2f\u9187\u7684\u6c27\u5316\u505c\u7559\u5728\u919b\u7684\u9636\u6bb5\u3002\n=\n\\begin{proposition}[\u6e29\u548c\u6c27\u5316]\\label{prop:b2:retrosynthesis:mild-oxidation}\n\u4f2f\u9187\u5728\u65e0\u6c34\u6709\u673a\u6eb6\u5242\u4e2d\u88ab\u6c27\u5316\u4e3a\u919b\uff0c\u800c\u4e0d\u7ee7\u7eed\u6c27\u5316\u4e3a\u9178\uff0c\u6240\u7528\u6c27\u5316\u5242\u4e3a\uff1a\n\u4e8c\u6c2f\u7532\u70f7\u4e2d\u7684\u6c2f\u94ec\u9178\u5421\u5576\u9393\uff1b\u65af\u6e29\uff08Swern\uff09\u6c27\u5316\uff08\u4ee5\u8349\u9170\u6c2f\u6d3b\u5316\u4e8c\u7532\u57fa\u4e9a\u781c\uff0c\n\u518d\u52a0\u4e09\u4e59\u80fa\uff0c\u4f4e\u6e29\u4e0b\u8fdb\u884c\uff09\uff1b\u6216\u6234\u65af\u2013\u9a6c\u4e01\u8fc7\u7898\u70f7\u3002\u5728\u6c34\u4e2d\uff0c\n\u94ec\uff08VI\uff09\u6216\u9ad8\u9530\u9178\u76d0\u53ef\u5c06\u5176\u6c27\u5316\u4e3a\u7fa7\u9178\u3002\n=\n=\n\\begin{proof}[\u8bba\u8bc1]\n\u8fd9\u4e9b\u6c27\u5316\u5242\u593a\u53bb\u4e0e \\ce{OH} \u76f8\u8fde\u7684\u78b3\u4e0a\u7684 \\ce{C-H} \u952e\u4e2d\u7684\u6c22\u3002\u751f\u6210\u7684\u919b\n\u4e0d\u518d\u542b\u6709\u6b64\u7c7b\u57fa\u56e2\u3002\u7136\u800c\u5728\u6c34\u4e2d\uff0c\u919b\u4e0e\u5176\u6c34\u5408\u7269\n\\ce{RCH(OH)2} \u5904\u4e8e\u5e73\u8861\uff0c\u540e\u8005\u53c8\u5728\u5e26\u6709\u6c22\u7684\u78b3\u4e0a\u542b\u6709 \\ce{OH}\uff1a\u6c34\u5408\u7269\u53ef\u50cf\u9187\u4e00\u6837\u88ab\u6c27\u5316\uff0c\n\u751f\u6210\u9178\u3002\u65e0\u6c34\u65f6\u4e0d\u751f\u6210\u6c34\u5408\u7269\uff0c\u6c27\u5316\u4fbf\u505c\u7559\u5728\n\u919b\u7684\u9636\u6bb5\u3002\n\\end{proof}\n=",
