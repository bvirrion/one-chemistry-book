{"sha": "77029e3eccea02f446afa57206ebc9dcf722a77dede8a1a68aa78bf01ae40ed1", "body": ["\\begin{omfigure}", "\\begin{tikzpicture}[font=\\small, scale=1.05]", "  \\pic[transform shape] at (0,0) {heatingmantle};", "  \\pic[transform shape] at (0,0) {rbflask={0.42}{orange!25}};", "  \\foreach \\p in {(-0.3,0.25), (0.2,0.18), (0.45,0.4), (-0.5,0.5)}", "    \\fill[black!45] \\p circle (0.05);", "  \\pic[transform shape] at (0,3.0) {condenser};", "  \\draw[omDef, thick, <-] (0.8,3.825) -- (1.9,3.825) node[right] {进水};", "  \\draw[omDef, thick, ->] (0.8,5.375) -- (1.9,5.375) node[right] {出水};", "  \\draw[omProp, thick, <-] (-0.18,5.8) -- (-1.4,6.1) node[left] {顶部开口};", "  \\draw[omProp, thick, <-] (-0.45,1.2) -- (-2.0,1.6)", "    node[left, align=right] {反应混合物\\\\ 和沸石};", "  \\draw[omProp, thick, <-] (-1.35,-0.2) -- (-2.0,-0.6)", "    node[left] {加热套};", "  \\draw[omThm, ->, thick] (-0.05,3.4) -- (-0.05,4.3);", "  \\draw[omDef, ->, thick] (0.05,4.3) -- (0.05,3.4);", "  \\node[omThm, anchor=east, font=\\footnotesize] at (-0.45,4.6) {蒸气上升};", "  \\node[omDef, anchor=west, font=\\footnotesize] at (0.85,4.6) {液体回落};", "\\end{tikzpicture}", "", "{\\small 加热回流。冷水由冷凝器底部进入夹套，", "从顶部流出，使夹套", "始终充满。}", "\\end{omfigure}", "", "\\begin{remark}[底部进水]\\label{rem:g10:synthesis-yield:water}", "若从顶部进水，水将直接向下流走，使", "夹套上部充满空气；若从底部进水，水必须", "充满整个夹套后才能流出。", "\\end{remark}", "", "\\section{分离与提纯}", "", "\\begin{definition}[减压过滤]\\label{def:g10:synthesis-yield:vacuum-filtration}", "称\\emph{减压过滤}\\index{减压过滤}为一种过滤方式，", "其中液体借助抽吸穿过滤纸：", "将带孔板的平底漏斗（布氏漏斗）置于", "与真空泵相连的侧管抽滤瓶上。", "\\end{definition}", "", "\\begin{omfigure}", "\\begin{tikzpicture}[font=\\small, scale=1.05]", "  \\pic[transform shape] (ff) at (0,0) {filterflask={0.12}{orange!20}};", "  \\fill[black!50] (-0.3,2.45) rectangle (0.3,2.8);", "  \\pic[transform shape] at (0,2.45) {buchner={black!8}};", "  \\draw[black!60, line width=2pt] (ff-arm) -- (2.6,2.2);", "  \\draw[omProp, thick, ->] (2.7,2.2) -- (3.4,2.2) node[right,", "    align=left, text=black] {通向\\\\ 真空泵};", "  \\draw[omProp, thick, <-] (0.7,3.8) -- (1.9,4.3) node[right, text=black]", "    {滤纸上的晶体};", "  \\draw[omProp, thick, <-] (-0.4,0.15) -- (-1.8,0.6) node[left, text=black]", "    {滤液};", "  \\draw[omProp, thick, <-] (-0.3,2.6) -- (-1.8,2.9) node[left, text=black]", "    {橡胶密封圈};", "\\end{tikzpicture}", "", "{\\small 布氏漏斗减压过滤：真空泵将", "液体迅速抽过，并使固体几乎干燥。}", "\\end{omfigure}", "", "\\begin{definition}[重结晶]\\label{def:g10:synthesis-yield:recrystallisation}", "\\emph{重结晶}\\index{重结晶}是一种提纯固体的方法：", "先将其溶于尽可能少的热溶剂中，", "再使溶液冷却：产物在冷时溶解度小得多，", "结晶，而含量较少的杂质", "仍留在溶液中。", "\\end{definition}", "", "\\begin{method}[重结晶提纯固体]\\label{met:g10:synthesis-yield:recrystallise}", "\\begin{enumerate}", "  \\item 选择溶剂，使产物在热时", "        极易溶解、冷时几乎不溶。", "  \\item 向粗固体中逐份加入热溶剂，", "        恰好全部溶解为止。", "  \\item 让溶液缓慢冷却，再放入冰浴中，", "        析出晶体。", "  \\item 用减压过滤收集晶体，并用少量", "        冰冷溶剂洗涤，然后干燥。", "\\end{enumerate}", "\\end{method}", "", "", "\\begin{omfigure}", "\\begin{tikzpicture}[font=\\small]", "  % 1. crude solid + a little hot solvent, on a hot plate", "  \\pic at (0,0.3) {hotplate};", "  \\pic at (0,0.3) {erlenmeyer={0.18}{orange!12}};", "  \\foreach \\p in {(-0.4,0.42),(-0.15,0.38),(0.1,0.45),(0.35,0.4),(-0.3,0.55),(0.2,0.6)}", "    \\fill[brown!60] \\p circle (0.06);", "  \\node[align=center, anchor=north] at (0,-0.15) {1. 粗固体，\\\\ 热溶剂};", "  % 2. clear hot solution", "  \\pic at (3,0.3) {hotplate};", "  \\pic at (3,0.3) {erlenmeyer={0.22}{orange!12}};", "  \\node[align=center, anchor=north] at (3,-0.15) {2. 全部溶解，\\\\ 澄清且热};", "  % 3. ice bath: crystals", "  \\fill[cyan!12, draw=black!40] (5.0,0) rectangle (7.0,1.2);", "  \\foreach \\p in {(5.2,0.9),(6.75,1.0),(5.3,0.3),(6.8,0.25)}", "    \\draw[black!35, fill=white] \\p ++(-0.12,-0.1) rectangle ++(0.24,0.2);", "  \\pic at (6,0.1) {erlenmeyer={0.2}{orange!8}};", "  \\foreach \\x/\\y in {-0.45/0.18,-0.25/0.15,0/0.2,0.25/0.15,0.45/0.2,-0.1/0.3,0.15/0.32,", "                     -0.35/0.32,0.35/0.33}", "    \\fill[white, draw=black!55] (6+\\x,0.1+\\y) -- ++(0.07,0.06) -- ++(0.07,-0.06)", "      -- ++(-0.07,-0.06) -- cycle;", "  \\node[align=center, anchor=north] at (6,-0.15) {3. 冰浴冷却，\\\\ 析出晶体};", "  % 4. filter", "  \\pic at (9,0) {filterflask={0.12}{orange!12}};", "  \\pic at (9,2.45) {buchner={black!12}};", "  \\fill[black!50] (8.7,2.45) rectangle (9.3,2.8);", "  \\node[align=center, anchor=north] at (9,-0.15) {4. 减压过滤，\\\\ 冷洗、干燥};", "\\end{tikzpicture}", ""]}