{"sha": "1e5785b23f452c0b967428db4f96a22c463d2e5af7616146b88f2956ccfac2b0", "body": ["\\begin{omfigure}", "\\begin{tikzpicture}[font=\\small, >=Stealth,", "    ion/.style={circle, draw=black!70, minimum size=10mm, inner sep=0pt}]", "  % the zinc strip and the solution", "  \\fill[black!18] (0,0) rectangle (1.6,4);", "  \\draw[black!60] (1.6,0) -- (1.6,4);", "  \\node[anchor=south] at (0.8,0.08) {锌};", "  \\fill[omWater!60] (1.6,0) rectangle (9.0,4);", "  \\node[anchor=north east] at (8.95,3.95) {溶液};", "  % a zinc atom leaves as an ion", "  \\node[ion, fill=black!30] (zn) at (1.15,3.0) {\\ce{Zn}};", "  \\node[ion, fill=white] (znion) at (5.0,3.0) {\\ce{Zn^{2+}}};", "  \\draw[->, thick, omProp] (zn.east) -- (znion.west)", "    node[midway, above] {氧化};", "  % the electrons travel through the metal", "  \\draw[->, thick, omDef, dashed] (0.75,2.45) -- (0.75,1.55)", "    node[midway, right] {2\\,\\ce{e-}};", "  % a copper ion is reduced on the surface", "  \\node[ion, fill=omDef!35] (cuion) at (5.0,1.0) {\\ce{Cu^{2+}}};", "  \\node[ion, fill=orange!55!brown] (cu) at (2.12,1.0) {\\ce{Cu}};", "  \\draw[->, thick, omProp] (cuion.west) -- (cu.east)", "    node[midway, above] {还原};", "  \\node[anchor=west, align=left] at (6.1,2.0) {每个锌原子给出\\\\ 两个电子给一个\\\\ 铜离子};", "\\end{tikzpicture}", "", "{\\small 在锌的表面。一个锌原子失去两个电子，", "以 \\ce{Zn^{2+}} 离子的形式离开，两个电子", "经金属流向与表面接触的 \\ce{Cu^{2+}} 离子，", "该离子变成铜原子，留在金属片上。}", "\\end{omfigure}", "", "\\begin{omfigure}", "\\begin{tikzpicture}[font=\\small]", "  \\pic at (0,0) {beaker={0.75}{omDef!45}};", "  \\fill[black!35] (-0.15,0.25) rectangle (0.15,2.5);", "  \\draw[black!65] (-0.15,0.25) rectangle (0.15,2.5);", "  \\node[anchor=north, align=center] at (0,-0.15) {开始时：\\\\ 蓝色的 \\ce{Cu^{2+}} 溶液};", "  \\draw[->, thick, omProp] (1.3,1) -- (3.2,1) node[midway, above] {一小时};", "  \\pic at (4.5,0) {beaker={0.75}{omDef!12}};", "  \\fill[black!35] (4.35,0.25) rectangle (4.65,2.5);", "  \\fill[orange!55!brown] (4.3,0.25) rectangle (4.7,1.5);", "  \\draw[black!65] (4.35,0.25) rectangle (4.65,2.5);", "  \\node[anchor=north, align=center] at (4.5,-0.15) {之后：溶液颜色变浅，\\\\ 锌片上有铜};", "\\end{tikzpicture}", "", "{\\small 可以观察到：浸入溶液中的锌片部分上有铜沉积，", "以及 \\ce{Cu^{2+}} 离子蓝色的褪去。}", "\\end{omfigure}", "", "\\begin{example}[酸中的金属再探]\\label{ex:g11:redox:acid}", "铁溶解于盐酸中时，铁被氧化，", "而 \\ce{H+} 离子被还原为氢气：", "\\[", "  \\ce{Fe(s) + 2H+(aq) -> Fe^{2+}(aq) + H2(g)}.", "\\]", "电对为 \\ce{Fe^{2+}}/\\ce{Fe} 和 \\ce{H+}/\\ce{H2}；氯", "离子不参与反应。", "\\end{example}", "", "\\begin{inthelab}[银树]", "将一圈洁净的铜丝悬挂于盛有稀硝酸银溶液的烧杯中，", "即 \\ce{Ag+(aq) + NO3^-(aq)}。一小时内，树枝状的", "光亮的银沿铜丝生长，无色溶液变为", "淡蓝色：\\ce{Cu(s) + 2Ag+(aq) -> Cu^{2+}(aq) + 2Ag(s)}。", "实验由教师操作，需戴手套和护目镜，而", "溶液事后作为危险废物收集。", "\\end{inthelab}", "", "\\begin{safety}{\\ghs[0.82cm]{GHS03}\\ghs[0.82cm]{GHS05}\\ghs[0.82cm]{GHS08}\\ghs[0.82cm]{GHS09}}", "% ledger: ghs:AgNO3", "硝酸银：能助燃的氧化剂（GHS03）；对皮肤和", "眼睛有腐蚀性，会使皮肤染黑（GHS05）；对健康有害", "（GHS08）；对水生生物剧毒，因此决不可倒入", "水槽（GHS09）。", "\\end{safety}", "", "\\begin{omfigure}", "\\includegraphics[width=0.5\\linewidth]{images/book1/ai/g11-silver-tree.jpg}", "", "{\\small 银晶体在铜丝上生长，", "位于硝酸银溶液中。}", "\\end{omfigure}", "", "\\section{配平半反应式}", "", "许多重要的电对含有氧，且是针对酸性", "溶液书写的，其中存在 \\ce{H+} 离子。其半反应式", "需用水分子和 \\ce{H+} 离子来配平。", "", "\\begin{method}[酸性溶液中配平半反应式]\\label{met:g11:redox:balance}", "在酸性溶液中写出电对 Ox/Red 的半反应式：", "\\begin{enumerate}", "  \\item 将 Ox 写在左侧、Red 写在右侧，配平", "        既非 O 也非 H 的原子；", "  \\item 用水分子 \\ce{H2O} 配平氧原子；", "  \\item 用 \\ce{H+} 离子配平氢原子；", "  \\item 在左侧用电子 \\ce{e-} 配平电荷；", "  \\item 检查：两边各原子数目相同，两侧", "        总电荷相同。", "\\end{enumerate}", "\\end{method}", "", "\\begin{example}[高锰酸根离子]\\label{ex:g11:redox:permanganate}", "对于电对 \\ce{MnO4^-}/\\ce{Mn^{2+}}（深紫色变为几乎", "无色）：锰已配平；左侧 4 个氧原子给出右侧", "的 $\\ce{4H2O}$；8 个氢原子给出左侧的 $\\ce{8H+}$；", "左侧电荷为 $-1 + 8 = +7$，右侧为 $+2$，故", "左侧需加入 5 个电子：", "\\[", "  \\ce{MnO4^-(aq) + 8H+(aq) + 5e- <=> Mn^{2+}(aq) + 4H2O(l)}.", "\\]", "\\end{example}", ""]}